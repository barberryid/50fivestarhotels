---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Badge from '../components/Badge.astro';
import ValueScore from '../components/ValueScore.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import SeasonalityCards from '../components/SeasonalityCards.astro';
import LocationSnapshotCard from '../components/LocationSnapshotCard.astro';
import PhotoCarousel from '../components/PhotoCarousel.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import LastUpdated from '../components/LastUpdated.astro';
import PriceAccuracyNote from '../components/PriceAccuracyNote.astro';
import NumberedEditorialSections from '../components/NumberedEditorialSections.astro';
import FiveStarReality from '../components/trust/FiveStarReality.astro';
import WatchOutFor from '../components/trust/WatchOutFor.astro';
import WhyItsCheap from '../components/trust/WhyItsCheap.astro';
import BestMonths from '../components/trust/BestMonths.astro';
import { hotelAirQuality } from '../data/hotelAirQuality';
import { hotelSeasonality } from '../data/hotelSeasonality';
import { locationSnapshots } from '../data/locationSnapshots';
import { absoluteUrl, breadcrumbJsonLd, canonicalUrl, imageUrl, publisherJsonLd } from '../lib/seo';
import { countryRegion, regionSlug } from '../lib/regions';
import { getBookingAffiliateUrl } from '../utils/affiliateLinks';

interface Props {
  hotel: {
    title: string;
    slug: string;
    city: string;
    country: string;
    region: string;
    budgetTier: string;
    typicalPriceRange: string;
    hotelType: string;
    fiveStarStatus: string;
    bestFor: string[];
    notIdealFor?: string[];
    valueScore: number;
    verdict: string;
    bookingUrl?: string;
    highlights: string[];
    cautions: string[];
    whyCheap?: string[];
    bestNearbyAttraction: string;
    foodAngle: string;
    seoTitle: string;
    seoDescription: string;
    focusKeyword?: string;
    secondaryKeywords?: string[];
    lastUpdated?: string;
    image?: {
      src: string;
      alt: string;
      srcSet?: {
        large: string;
        small: string;
      };
      attribution?: string;
      sourcePageUrl?: string;
    };
    generatedGallery?: Array<{
      src: string;
      srcSet?: {
        large: string;
        small: string;
      };
      type?: string;
      alt: string;
      caption?: string;
    }>;
    gallery?: Array<{
      src: string;
      alt: string;
      type?: string;
      subject?: string;
      attribution?: string;
      sourcePageUrl?: string;
      sourceSite?: string;
    }>;
  };
  allHotels?: any[];
}

const { hotel, allHotels = [] } = Astro.props;
const notIdealFor = hotel.notIdealFor?.length
  ? hotel.notIdealFor
  : hotel.cautions?.slice(0, 3) ?? [];
const gallery = hotel.gallery?.filter(image => image.src) ?? [];
const generatedGallery = hotel.generatedGallery?.filter(image => image.src) ?? [];
const seasonality = hotelSeasonality[hotel.slug];
const airQuality = hotelAirQuality[hotel.slug];
const locationSnapshot = locationSnapshots[hotel.slug];
const bookingAffiliateUrl = getBookingAffiliateUrl(hotel.bookingUrl);
const creditLabel = (sourceSite?: string) => sourceSite ? `Image credit: ${sourceSite}` : 'Image credit';

// Derive best-month signals from seasonality data for the trust panel
const bestWeatherMonths = seasonality?.weather.months.filter(m => m.label === 'Best').map(m => m.month) ?? [];
const cheapestMonths = seasonality?.price.months.filter(m => m.label === 'Cheapest').map(m => m.month) ?? [];
const pageUrl = canonicalUrl(`/hotels/${hotel.slug}/`);
const hotelDescription = hotel.seoDescription;
const breadcrumbLd = breadcrumbJsonLd([
  { name: 'Home', url: absoluteUrl('/') },
  { name: 'Hotels', url: absoluteUrl('/destinations/') },
  { name: hotel.title, url: pageUrl },
]);
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${hotel.title}: affordable five-star hotel in ${hotel.city}`,
  description: hotelDescription,
  image: imageUrl(hotel.image?.src),
  author: {
    '@type': 'Organization',
    name: '50 Five-Star Hotels',
  },
  publisher: publisherJsonLd(),
  mainEntityOfPage: pageUrl,
  dateModified: hotel.lastUpdated,
};
const hotelKeywords = [
  hotel.focusKeyword,
  ...(hotel.secondaryKeywords ?? []),
].filter((keyword): keyword is string => Boolean(keyword));
const hotelJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Hotel',
  name: hotel.title,
  url: pageUrl,
  image: imageUrl(hotel.image?.src),
  address: {
    '@type': 'PostalAddress',
    addressLocality: hotel.city,
    addressCountry: hotel.country,
  },
  starRating: hotel.fiveStarStatus?.toLowerCase().includes('five-star')
    ? {
        '@type': 'Rating',
        ratingValue: '5',
        bestRating: '5',
      }
    : undefined,
  description: hotelDescription,
};
const citySlug = hotel.city.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const tierPath = hotel.budgetTier.includes('€50') ? '/under-50/' : hotel.budgetTier.includes('100') ? '/under-100/' : hotel.budgetTier.includes('200') ? '/under-200/' : '/under-250/';
const region = countryRegion(hotel.country);
const relatedHotels = allHotels
  .map((entry) => entry.data ?? entry)
  .filter((entry) => entry.slug !== hotel.slug && (entry.city === hotel.city || entry.country === hotel.country || entry.budgetTier === hotel.budgetTier))
  .slice(0, 3);
const relatedGuides = [
  { title: `${hotel.budgetTier} hotels`, description: 'Compare hotels in the same price tier.', href: tierPath },
  { title: `Affordable luxury in ${hotel.city}`, description: `Read the destination guide for ${hotel.city}.`, href: `/destinations/${citySlug}/` },
  { title: 'Compare hotels for this trip', description: `Use the Hotel Finder to compare ${hotel.title} with other options in ${hotel.city}, ${hotel.country}, by budget, travel style and likely compromises.`, href: `/research-hotels/?country=${encodeURIComponent(hotel.country)}&city=${encodeURIComponent(hotel.city)}` },
  { title: 'How we choose hotels', description: 'The scoring method, five-star reality checks, and booking cautions.', href: '/research-hotels/#methodology' },
  { title: `Affordable five-star hotels in ${region}`, description: 'Browse hotels in the same broad region.', href: regionSlug(region) },
  ...relatedHotels.map((entry) => ({
    title: entry.title,
    description: `${entry.city}, ${entry.country} - ${entry.budgetTier}`,
    href: `/hotels/${entry.slug}/`,
  })),
];
---

<BaseLayout title={`${hotel.seoTitle} | 50fivestarhotels.com`} description={hotel.seoDescription} canonical={`/hotels/${hotel.slug}/`} image={hotel.image?.src} keywords={hotelKeywords} type="article" jsonLd={[breadcrumbLd, articleJsonLd, hotelJsonLd]}>
  <main class="max-w-6xl mx-auto px-5 py-10">
    <!-- Breadcrumbs -->
    <div class="mb-8">
      <Breadcrumbs crumbs={[
        { label: 'Home', href: '/' },
        { label: 'Hotels', href: '/destinations' },
        { label: hotel.city, href: `/destinations/${citySlug}/` },
        { label: hotel.title }
      ]} />
    </div>

    <div class="grid lg:grid-cols-[minmax(0,1fr)_320px] gap-12">
      <!-- Main content -->
      <article class="min-w-0">
        <!-- Hero image -->
        {generatedGallery.length > 1 ? (
          <PhotoCarousel images={generatedGallery} label={`${hotel.title} generated photos`} />
        ) : hotel.image?.src && (
          <figure class="m-0">
            <div class="aspect-[16/8] overflow-hidden rounded-2xl bg-[#F8F2E8]">
              <picture>
                {hotel.image.srcSet?.large && <source media="(min-width: 900px)" srcset={hotel.image.srcSet.large} type="image/webp" />}
                {hotel.image.srcSet?.small && <source media="(max-width: 899px)" srcset={hotel.image.srcSet.small} type="image/webp" />}
                <img
                  src={hotel.image.src}
                  alt={hotel.image.alt}
                  class="h-full w-full object-cover"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  width="1200"
                  height="600"
                />
              </picture>
            </div>
            {hotel.image.attribution && (
              <figcaption class="mt-2 text-xs text-[#6F685F]">
                {hotel.image.sourcePageUrl ? (
                  <a href={hotel.image.sourcePageUrl} target="_blank" rel="noopener noreferrer" class="text-[#6F685F] hover:text-[#B88A44] no-underline">
                    {hotel.image.attribution}
                  </a>
                ) : hotel.image.attribution}
              </figcaption>
            )}
          </figure>
        )}

        <!-- Hotel header -->
        <header class="mt-8 mb-8">
          <div class="flex flex-wrap gap-2 mb-4">
            <Badge label={hotel.budgetTier} variant="tier" />
            <Badge label={hotel.fiveStarStatus} variant="type" />
          </div>
          <h1 class="font-serif text-3xl md:text-4xl font-bold text-[#1F2428] leading-tight">{hotel.title}</h1>
          <p class="text-[#B88A44] font-semibold mt-2">{hotel.city}, {hotel.country}</p>
          <p class="text-[#6F685F] text-sm mt-1">{hotel.typicalPriceRange}</p>
          <p class="text-[#1F2428]/75 text-base leading-relaxed mt-4 max-w-3xl">
            A practical guide to this affordable five-star hotel in {hotel.city}, {hotel.country} - a five-star hotel without five-star prices in the {hotel.budgetTier.toLowerCase()} tier when the dates line up.
          </p>
          <div class="mt-4">
            <LastUpdated date={hotel.lastUpdated ?? '2026-05-31'} />
          </div>

          <div class="mt-6 flex flex-wrap items-center gap-6">
            <ValueScore score={hotel.valueScore} verdict={hotel.verdict} size="lg" />
            {bookingAffiliateUrl && (
              <div class="flex flex-col gap-3 max-w-sm">
                <AffiliateDisclosure compact={true} />
                <a
                  href={bookingAffiliateUrl}
                  target="_blank"
                  rel="sponsored nofollow noopener"
                  class="inline-flex items-center justify-center bg-[#1F2428] text-white font-semibold py-3 px-6 rounded-xl hover:bg-[#B88A44] transition-colors no-underline text-sm"
                >
                  Check current prices on Booking.com
                </a>
                <PriceAccuracyNote />
              </div>
            )}
          </div>
        </header>

        <!-- Highlights -->
        <div class="bg-[#4F6547]/6 rounded-2xl p-6 mb-8">
          <h2 class="font-serif text-lg font-bold text-[#1F2428] mb-3">Why consider this hotel</h2>
          <ul class="space-y-2">
            {hotel.highlights.map(h => (
              <li class="flex items-start gap-3 text-sm text-[#1F2428]/80">
                <svg class="w-5 h-5 text-[#4F6547] shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16zm3.707-9.293a1 1 0 0 0-1.414-1.414L9 10.586 7.707 9.293a1 1 0 0 0-1.414 1.414l2 2a1 1 0 0 0 1.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                {h}
              </li>
            ))}
          </ul>
        </div>

        <!-- Trust panel: before you book -->
        <section class="mb-8" aria-label="Honest guidance before booking">
          <div class="grid sm:grid-cols-2 gap-4">
            <WhyItsCheap reasons={hotel.whyCheap ?? []} priceRange={hotel.typicalPriceRange} />
            <FiveStarReality status={hotel.fiveStarStatus} />
            <BestMonths
              bestWeather={bestWeatherMonths}
              cheapest={cheapestMonths}
              weatherSummary={seasonality?.weather.summary}
              priceSummary={seasonality?.price.summary}
            />
            <WatchOutFor cautions={hotel.cautions} />
          </div>
        </section>

        <LocationSnapshotCard snapshot={locationSnapshot} hotel={hotel} />

        {seasonality && <SeasonalityCards seasonality={seasonality} airQuality={airQuality} />}

        {gallery.length > 0 && (
          <section class="mt-8 mb-10" aria-labelledby="image-gallery-heading">
            <h2 id="image-gallery-heading" class="font-serif text-2xl md:text-3xl font-bold text-[#1F2428] mb-6">
              Images from the stay and destination
            </h2>
            <div class="grid sm:grid-cols-2 gap-4">
              {gallery.map((image, index) => (
                <figure class="m-0 min-w-0">
                  <div class={`${index === 0 ? 'aspect-[16/10]' : 'aspect-[4/3]'} overflow-hidden rounded-xl bg-[#F8F2E8]`}>
                    <img
                      src={image.src}
                      alt={image.alt}
                      class="h-full w-full object-cover"
                      loading={index === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      width="800"
                      height="600"
                    />
                  </div>
                  <figcaption class="mt-2 text-xs leading-relaxed text-[#6F685F]">
                    <span class="font-medium text-[#1F2428]">{image.subject ?? image.type}</span>
                    {image.attribution && (
                      <>
                        {' - '}
                        {image.sourcePageUrl ? (
                          <a href={image.sourcePageUrl} target="_blank" rel="noopener noreferrer" title={image.attribution} class="text-[#6F685F] hover:text-[#B88A44] no-underline">
                            {creditLabel(image.sourceSite)}
                          </a>
                        ) : (
                          <span title={image.attribution}>Image credit</span>
                        )}
                      </>
                    )}
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}

        <!-- Editorial content -->
        <NumberedEditorialSections class="prose prose-lg max-w-none
          prose-headings:font-serif prose-headings:text-[#1F2428]
          prose-h2:text-2xl md:prose-h2:text-3xl prose-h2:leading-tight
          prose-p:text-[#1F2428]/80 prose-p:leading-relaxed
          prose-strong:text-[#1F2428]
          prose-a:text-[#B88A44] prose-a:no-underline hover:prose-a:underline">
          <slot />
        </NumberedEditorialSections>
        {bookingAffiliateUrl && (
          <div class="mt-12 bg-[#1F2428] rounded-2xl p-8 text-white">
            <h2 class="font-serif text-2xl font-bold mb-2">Ready to check prices?</h2>
            <p class="text-white/60 text-sm mb-6">Prices vary significantly by date, room type and season. Check current availability before making any plans.</p>
            <a
              href={bookingAffiliateUrl}
              target="_blank"
              rel="sponsored nofollow noopener"
              class="inline-flex items-center bg-[#B88A44] text-white font-semibold py-3 px-6 rounded-xl hover:bg-[#A8763A] transition-colors no-underline text-sm"
            >
              Check current prices on Booking.com
            </a>
            <p class="text-white/60 text-[11px] mt-3">Prices vary by date, taxes, room type, and cancellation policy. Always check the final rate before booking.</p>
          </div>
        )}
        <RelatedGuides items={relatedGuides} />
      </article>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <!-- Quick facts -->
        <div class="bg-[#FFFDF8] rounded-2xl p-6 shadow-sm border border-[#1F2428]/5">
          <h2 class="font-serif text-lg font-bold text-[#1F2428] mb-4">Quick facts</h2>
          <dl class="space-y-4 text-sm">
            <div>
              <dt class="text-[#6F685F] text-xs uppercase tracking-wider font-semibold mb-1">Hotel type</dt>
              <dd class="text-[#1F2428]">{hotel.hotelType}</dd>
            </div>
            <div>
              <dt class="text-[#6F685F] text-xs uppercase tracking-wider font-semibold mb-1">Five-star status</dt>
              <dd class="text-[#1F2428]">{hotel.fiveStarStatus}</dd>
            </div>
            <div>
              <dt class="text-[#6F685F] text-xs uppercase tracking-wider font-semibold mb-1">Typical price range</dt>
              <dd class="text-[#1F2428]">{hotel.typicalPriceRange}</dd>
            </div>
            <div>
              <dt class="text-[#6F685F] text-xs uppercase tracking-wider font-semibold mb-1">Best for</dt>
              <dd class="flex flex-wrap gap-1.5">
                {hotel.bestFor.map(tag => (
                  <span class="bg-[#F8F2E8] text-[#6F685F] px-2 py-0.5 rounded-full text-xs">{tag}</span>
                ))}
              </dd>
            </div>
            {notIdealFor.length > 0 && (
              <div>
                <dt class="text-[#6F685F] text-xs uppercase tracking-wider font-semibold mb-1">Not ideal for</dt>
                <dd class="flex flex-wrap gap-1.5">
                  {notIdealFor.map(tag => (
                    <span class="bg-white border border-[#E2D4BF] text-[#6F685F] px-2 py-0.5 rounded-full text-xs">{tag}</span>
                  ))}
                </dd>
              </div>
            )}
            <div>
              <dt class="text-[#6F685F] text-xs uppercase tracking-wider font-semibold mb-1">Best nearby</dt>
              <dd class="text-[#1F2428]">{hotel.bestNearbyAttraction}</dd>
            </div>
            <div>
              <dt class="text-[#6F685F] text-xs uppercase tracking-wider font-semibold mb-1">Food angle</dt>
              <dd class="text-[#1F2428]">{hotel.foodAngle}</dd>
            </div>
          </dl>
        </div>

      </aside>
    </div>
  </main>
</BaseLayout>
