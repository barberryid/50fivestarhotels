---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  image?: string;
  keywords?: string[] | string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const { title, description, canonical, ogImage, image, keywords, type, noindex, jsonLd } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} canonical={canonical} ogImage={ogImage} image={image} keywords={keywords} type={type} noindex={noindex} jsonLd={jsonLd} />
    <script is:inline>
      // Provider-agnostic analytics helper. Safe no-op if no provider is loaded.
      window.ffshTrack = function (eventName, props) {
        props = props || {};
        try {
          if (typeof window.plausible === 'function') {
            window.plausible(eventName, { props: props });
          }
          if (typeof window.gtag === 'function') {
            window.gtag('event', eventName, props);
          }
          window.dispatchEvent(new CustomEvent('ffsh:track', { detail: { eventName: eventName, props: props } }));
        } catch (error) {
          // Do not break the site if analytics is unavailable.
        }
      };
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
