---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  image?: string;
  keywords?: string[] | string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const { title, description, canonical, ogImage, image, keywords, type, noindex, jsonLd } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} canonical={canonical} ogImage={ogImage} image={image} keywords={keywords} type={type} noindex={noindex} jsonLd={jsonLd} />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
