---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  image?: string;
  keywords?: string[] | string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
  imageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const { title, description, canonical, ogImage, image, keywords, type, noindex, jsonLd, imageAlt, publishedTime, modifiedTime } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) - production hostnames only -->
    <script is:inline>
      if (
        window.location.hostname === '50fivestarhotels.com' ||
        window.location.hostname === 'www.50fivestarhotels.com'
      ) {
        var gaScript = document.createElement('script');
        gaScript.async = true;
        gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-PB1W0C70F7';
        document.head.appendChild(gaScript);

        window.dataLayer = window.dataLayer || [];
        function gtag(){ window.dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', 'G-PB1W0C70F7');
      }
    </script>
    <SeoHead title={title} description={description} canonical={canonical} ogImage={ogImage} image={image} keywords={keywords} type={type} noindex={noindex} jsonLd={jsonLd} imageAlt={imageAlt} publishedTime={publishedTime} modifiedTime={modifiedTime} />
    <script is:inline>
      // Provider-agnostic analytics helper. Safe no-op if no provider is loaded.
      window.ffshTrack = function (eventName, props) {
        props = props || {};
        try {
          if (typeof window.plausible === 'function') {
            window.plausible(eventName, { props: props });
          }
          if (typeof window.gtag === 'function') {
            window.gtag('event', eventName, props);
          }
          window.dispatchEvent(new CustomEvent('ffsh:track', { detail: { eventName: eventName, props: props } }));
        } catch (error) {
          // Do not break the site if analytics is unavailable.
        }
      };
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
