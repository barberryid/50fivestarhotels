---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
  maxWidth?: string;
}

const { title, description, canonical, ogImage, image, type, noindex, jsonLd, maxWidth = 'max-w-4xl' } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={ogImage} image={image} type={type} noindex={noindex} jsonLd={jsonLd}>
  <main class={`${maxWidth} mx-auto px-5 py-16`}>
    <slot />
  </main>
</BaseLayout>
