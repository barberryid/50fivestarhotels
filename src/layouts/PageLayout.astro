---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  maxWidth?: string;
}

const { title, description, canonical, ogImage, maxWidth = 'max-w-4xl' } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={ogImage}>
  <main class={`${maxWidth} mx-auto px-5 py-16`}>
    <slot />
  </main>
</BaseLayout>
