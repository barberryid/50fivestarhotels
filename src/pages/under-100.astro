---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HotelCard from '../components/HotelCard.astro';
import HotelComparisonTable from '../components/HotelComparisonTable.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';

const all = await getCollection('hotels', ({ data }) => !data.draft);
const hotels = all.filter(h => h.data.budgetTier === 'Under €100').sort((a, b) => a.data.rank - b.data.rank);

const tableHotels = hotels.map(h => ({
  slug: h.data.slug,
  rank: h.data.rank,
  title: h.data.title,
  city: h.data.city,
  budgetTier: h.data.budgetTier,
  valueScore: h.data.valueScore,
  verdict: h.data.verdict,
}));
---

<BaseLayout
  title="Best Five-Star Hotels Under €100 | 50 Five-Star Hotels"
  description="Discover affordable five-star and near-five-star hotels often available under €100 outside peak dates, with honest cautions and destination ideas."
>
  <main>
    <!-- Hero -->
    <section class="bg-[#F8F2E8] border-b border-[#1F2428]/6">
      <div class="max-w-4xl mx-auto px-5 py-16">
        <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">Budget tier</p>
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-[#1F2428] leading-tight mb-6">
          Best five-star hotels under €100
        </h1>
        <p class="text-[#6F685F] text-lg leading-relaxed max-w-2xl">
          These are the most surprising hotels in the project: five-star or near-five-star stays that can often appear below €100 outside peak dates. They are not always flawless, but when the rate is right, they can make ordinary travel feel unusually indulgent.
        </p>
        <p class="text-[#6F685F] text-xs mt-5">
          {hotels.length} hotels in this tier. Prices vary by date, room type, taxes and cancellation policy.
        </p>
      </div>
    </section>

    <!-- Caution block -->
    <section class="bg-[#1F2428]/4 border-b border-[#1F2428]/6">
      <div class="max-w-4xl mx-auto px-5 py-6">
        <p class="text-[#1F2428]/70 text-sm leading-relaxed">
          <strong class="text-[#1F2428]">Price note:</strong> The under-€100 tier reflects rates that can appear outside peak periods. Not every hotel here will always be available below €100 — check carefully by specific date, room type and season. See our <a href="/research-hotels/#methodology" class="text-[#B88A44] hover:underline">methodology</a> for how we assess value.
        </p>
      </div>
    </section>

    <!-- Hotel grid -->
    <section class="max-w-6xl mx-auto px-5 py-16">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {hotels.map(h => <HotelCard hotel={h.data} />)}
      </div>
    </section>

    <!-- Comparison table -->
    <section class="max-w-6xl mx-auto px-5 pb-16">
      <HotelComparisonTable hotels={tableHotels} title="Under €100 hotels at a glance" />
    </section>

    <!-- Disclosure -->
    <section class="max-w-4xl mx-auto px-5 pb-16">
      <AffiliateDisclosure />
    </section>

    <!-- Link to methodology -->
    <section class="bg-[#FFFDF8] border-t border-[#1F2428]/6 py-12">
      <div class="max-w-4xl mx-auto px-5 flex flex-wrap gap-6 items-center justify-between">
        <p class="text-[#6F685F] text-sm">How are these hotels evaluated?</p>
        <a href="/research-hotels/#methodology" class="text-[#B88A44] font-semibold text-sm hover:underline no-underline">
          Read the full methodology →
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
