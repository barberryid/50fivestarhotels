      font-weight: 700;
      color: var(--color-muted);
      cursor: default;
      font-family: inherit;
      transition: color 150ms ease, border-color 150ms ease, background-color 150ms ease;
    }

    .ical-btn:not(:disabled) {
      color: var(--color-forest);
      border-color: var(--color-clay);
