    /* ── Critical list in sidebar ────────────────────────────────────── */
    /* #critical-list is static HTML (gets scoping attr) but its children  */
    /* are injected via innerHTML at runtime, so they need :global().       */
    #critical-list {
      margin: 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 0;
    }

    :global(.critical-item) {
      border-bottom: 1px solid var(--color-line);
    }

    :global(.critical-item:last-child) {
      border-bottom: none;
    }

    :global(.critical-item-row) {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      padding: 0.4rem 0.25rem;
    }

    :global(.critical-sidebar-cb) {
      flex-shrink: 0;
      margin-top: 0.2rem;
      width: 0.9rem;
      height: 0.9rem;
      accent-color: var(--color-clay);
      cursor: pointer;
    }

    :global(.critical-link) {
      flex: 1;
      min-width: 0;
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--color-ink);
      text-decoration: none;
      border-radius: 0.25rem;
      transition: color 150ms ease;
      line-height: 1.35;
    }

    :global(.critical-link:hover) {
      color: var(--color-clay-text);
      text-decoration: underline;
    }

    :global(.critical-link:focus-visible) {
      outline: 2px solid var(--color-clay);
      outline-offset: 2px;
    }

    :global(.critical-item--done .critical-link) {
      color: var(--color-muted);
      text-decoration: line-through;
      text-decoration-thickness: 1px;
      opacity: 0.65;
    }

    /* ── Jump-to-next button ──────────────────────────────────────────── */
    .jump-btn {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 30;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: var(--color-clay);
      color: #fff;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
      transition: opacity 150ms ease, transform 150ms ease;
    }

    .jump-btn:hover {
      opacity: 0.9;
      transform: translateY(-2px);
    }

    .jump-btn:focus-visible {
      outline: 3px solid var(--color-clay);
      outline-offset: 3px;
    }

    /* Hide jump button on desktop */
    @media (min-width: 1024px) {
      .jump-btn {
        display: none !important;
      }
    }

    /* ── Reduced motion ───────────────────────────────────────────────── */
    @media (prefers-reduced-motion: reduce) {
      .progress-bar-fill,
      .accordion-chevron,
      .sidebar-details-chevron,
      .progress-btn,
      .critical-link,
      .jump-btn,
      .trip-date-input,
      .ical-btn,
      .filter-chip,
      .why-toggle,
      .source-link,
      .recheck-link {
        transition: none;
      }

      .progress-flash {
        animation: none;
      }
    }

    /* ── Why row ─────────────────────────────────────────────────────── */
    .why-row {
      display: flex;
      align-items: flex-start;
      gap: 0.375rem;
    }

    .why-row .checklist-row {
      flex: 1;
      min-width: 0;
    }

    /* ── Why toggle button ────────────────────────────────────────────── */
    .why-toggle {
      flex-shrink: 0;
      align-self: center;
      background: none;
      border: none;
      padding: 0.2rem 0.4rem;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--color-muted);
      cursor: pointer;
      font-family: inherit;
      border-radius: 0.25rem;
      white-space: nowrap;
      transition: color 150ms ease;
    }

    .why-toggle:hover {
      color: var(--color-ink);
      text-decoration: underline;
    }

    .why-toggle:focus-visible {
      outline: 2px solid var(--color-clay);
      outline-offset: 2px;
    }

    .why-toggle[aria-expanded="true"] {
      color: var(--color-clay-text);
    }

    /* ── Why content ──────────────────────────────────────────────────── */
    .why-content {
      margin-top: 0.375rem;
      padding: 0.625rem 0.75rem;
      background: var(--color-tag-bg);
      border-radius: 0.5rem;
      font-size: 0.8125rem;
      font-weight: 500;
      line-height: 1.5;
      color: var(--color-ink);
    }

    /* ── Source links ─────────────────────────────────────────────────── */
    .source-link {
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--color-clay-text);
      text-decoration: none;
      margin-left: 0.15rem;
    }

    .source-link:hover {
      text-decoration: underline;
    }

    .source-link:focus-visible {
      outline: 2px solid var(--color-clay);
      outline-offset: 1px;
      border-radius: 2px;
    }

    /* ── Recheck meta ─────────────────────────────────────────────────── */
    .recheck-meta {
      display: block;
      margin-top: 0.2rem;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--color-muted);
    }

    .recheck-link {
      color: var(--color-clay-text);
      text-decoration: none;
      font-weight: 600;
    }

    .recheck-link:hover {
      text-decoration: underline;
    }

    .recheck-link:focus-visible {
      outline: 2px solid var(--color-clay);
      outline-offset: 1px;
      border-radius: 2px;
    }

    .originally-checked-note {
      color: var(--color-forest);
      margin-left: 0.5rem;
      font-weight: 600;
    }

    /* ── Optional section badge ───────────────────────────────────────── */
    .section-badge--optional {
      background: linear-gradient(135deg, #fef3c7 0%, #fde68a 50%, #f59e0b 100%);
      color: #7c2d12;
      box-shadow:
        inset 0 1px 1px rgba(255, 255, 255, 0.7),
        0 2px 8px rgba(245, 158, 11, 0.22);
    }

    /* ── Optional divider ─────────────────────────────────────────────── */
    .optional-divider {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin: 0.25rem 0;
      color: var(--color-muted);
      font-size: 0.8125rem;
      font-weight: 600;
    }

    .optional-divider::before,
    .optional-divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: var(--color-line);
    }

    /* ── Optional item rows ───────────────────────────────────────────── */
    li[data-optional="true"] .checklist-row {
      opacity: 0.88;
    }

    li[data-optional="true"] .checklist-row .min-w-0 > span:first-child {
      font-style: italic;
      font-weight: 600;
    }

    /* ── Secondary optional progress count ───────────────────────────── */
    .progress-counts {
      flex: 1;
      min-width: 0;
    }

    .progress-optional-text {
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--color-muted);
      margin-top: 0.05rem;
    }

    /* ── Print ────────────────────────────────────────────────────────── */
    @media print {
      header,
      footer,
      .skip-link {
        display: none !important;
      }

      .filter-strip,
      .progress-strip,
      .jump-btn,
      .why-toggle,
      .why-content {
        display: none;
      }

      body {
        background: #fff;
      }

      section,
      article,
      aside {
        box-shadow: none !important;
      }

      input[type="checkbox"] {
        print-color-adjust: exact;
      }

      details {
        break-inside: avoid;
      }

      details > summary {
        list-style: none;
      }

      details > *:not(summary) {
        display: block !important;
      }

      .accordion-chevron {
        display: none !important;
      }

      .section-badge {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
    }
  </style>
</BaseLayout>
