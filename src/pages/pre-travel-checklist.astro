      border-color: var(--color-clay);
      color: var(--color-cream);
    }

    .filter-chip:focus-visible {
      outline: 2px solid var(--color-clay);
      outline-offset: 2px;
    }

    /* ── Item tag chips ───────────────────────────────────────────────── */
    .item-tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
      margin-top: 0.2rem;
    }

    .item-tag-chip {
      display: inline-flex;
