  "",
  ...sections.flatMap((section) => [
    section.num != null ? `${section.num}. ${section.title}` : section.title,
    ...section.items.map((item) => `[ ] ${item.text}`),
    ""
  ]),
  "Do not forget",
  ...criticalItems.map((item) => `[ ] ${item.text}`)
].join("\n");

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${checklistUrl}#article`,
    headline: pageTitle,
    description: pageDescription,
    url: checklistUrl,
    image: `${siteUrl}/images/social/default-og.webp`,
    inLanguage: "en",
    isPartOf: { "@type": "WebSite", "@id": `${siteUrl}/#website` },
    author: { "@type": "Organization", "@id": `${siteUrl}/#organization`, name: "50 Five-Star Hotels" },
    publisher: { "@type": "Organization", "@id": `${siteUrl}/#organization`, name: "50 Five-Star Hotels" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
      { "@type": "ListItem", position: 2, name: "Pre-Travel Checklist", item: checklistUrl }
    ]
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  type="article"
  canonical="/pre-travel-checklist/"
  jsonLd={jsonLd}
>
  <section class="mx-auto w-full max-w-[1180px] px-4 pb-8 pt-[clamp(3rem,8vw,7rem)]">
    <div class="max-w-[820px]">
      <p class="mb-3 text-[0.76rem] font-black uppercase tracking-[0.1em] text-clay-text">Travel planning</p>
      <h1 class="max-w-[14ch] font-serif text-[clamp(2.2rem,5vw,3.6rem)] font-semibold leading-[1.03] text-ink">Pre-Travel Checklist</h1>
      <div class="mt-5 max-w-[52rem]">
        <p class="rounded-xl border border-line bg-cream p-4 text-[1.05rem] font-bold leading-relaxed text-forest">This checklist is designed for international trips, multi-country itineraries, and destinations where transport, entry rules, internet access, or local logistics may need extra planning.</p>
      </div>
      <!-- Trip date awareness -->
      <div class="mt-6 print:hidden">
        <label for="trip-date" class="mb-1.5 block text-sm font-bold text-ink">When do you leave?</label>
        <input
          id="trip-date"
          type="date"
          class="trip-date-input"
          aria-describedby="trip-date-helper"
        />
        <p id="trip-date-helper" class="mt-1 text-xs leading-relaxed text-muted">Optional. Used only in your browser to label time-sensitive items.</p>
        <button id="ical-btn" type="button" disabled class="ical-btn mt-3">Add reminders to calendar</button>
        <div id="days-to-go-banner" hidden class="days-to-go-banner mt-3" role="status" aria-live="polite">
          <span id="days-to-go-text"></span>
        </div>
      </div>
      <div class="mt-6 flex flex-wrap gap-3 print:hidden">
        <button id="print-checklist" class="inline-flex min-h-[2.7rem] items-center rounded-full bg-clay px-5 text-sm font-extrabold text-cream transition-opacity hover:opacity-90" type="button">
          Print this checklist
        </button>
        <button id="copy-checklist" class="inline-flex min-h-[2.7rem] items-center rounded-full border border-line bg-surface px-5 text-sm font-extrabold text-forest transition-colors hover:bg-tag-bg" type="button">
          Copy checklist
        </button>
        <span id="copy-status" class="self-center text-sm font-bold text-clay-text" role="status" aria-live="polite"></span>
      </div>
    </div>
  </section>

  <!-- Filter chips -->
  <div class="filter-strip print:hidden" role="group" aria-label="Trip type filters">
    <div class="filter-inner mx-auto w-full max-w-[1180px] px-4">
      <span class="filter-label">Trip type:</span>
      <button class="filter-chip" type="button" aria-pressed="false" data-filter="remote">Remote / wilderness</button>
      <button class="filter-chip" type="button" aria-pressed="false" data-filter="driving">Driving abroad</button>
      <button class="filter-chip" type="button" aria-pressed="false" data-filter="kids">With kids</button>
      <button class="filter-chip" type="button" aria-pressed="false" data-filter="altitude">High altitude</button>
    </div>
  </div>

  <!-- Progress strip -->
  <div class="progress-strip print:hidden" role="region" aria-label="Checklist progress">
    <div class="progress-bar-track">
      <div id="progress-bar" class="progress-bar-fill"></div>
    </div>
    <div class="progress-inner mx-auto w-full max-w-[1180px] px-4">
      <div class="progress-counts">
        <div id="progress-live" class="progress-text" aria-live="polite">
          <strong>0</strong>&thinsp;<span class="progress-of">of</span>&thinsp;<strong>0</strong>&thinsp;complete
        </div>
        <div id="progress-optional" class="progress-optional-text" aria-live="polite"></div>
      </div>
      <div class="progress-controls">
        <button id="reset-btn" class="progress-btn" type="button" aria-describedby="reset-msg">Reset</button>
        <span id="reset-msg" class="sr-only" aria-live="polite"></span>
        <button id="expand-all-btn" class="progress-btn" type="button">Expand all</button>
      </div>
    </div>
  </div>

  <section class="checklist-grid mx-auto grid w-full max-w-[1180px] gap-6 px-4 pb-[clamp(3rem,7vw,6rem)] lg:grid-cols-[minmax(0,1fr)_minmax(17rem,22rem)] lg:items-start">
    <article id="checklist-article" class="grid gap-3">
      {sections.map((section, sectionIndex) => (
        <Fragment>
          {section.num == null && (
            <div class="optional-divider" role="separator" aria-label="Optional items begin">
              <span>— Optional from here —</span>
            </div>
          )}
          <details
            id={section.num != null ? `section-${section.num}` : "section-extras"}
            open={sectionIndex === 0}
            class="checklist-accordion rounded-xl border border-line bg-surface shadow-card"
          >
            <summary class="accordion-summary">
              <span
                class={`section-badge${section.num != null && section.num >= 10 ? " section-badge--double" : ""}${section.num == null ? " section-badge--optional" : ""}`}
                aria-hidden="true"
              >
                {section.num != null ? section.num : (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6L12 2z"/>
                  </svg>
                )}
              </span>
            <div class="min-w-0 flex-1">
              <h2 class="accordion-title">{section.title}</h2>
              <p class="accordion-helper">{section.helper}</p>
              {(section.num === 10 || section.num === 11 || section.num === 12) && (
                <span class="section-date-chip" id={`section-${section.num}-chip`} hidden></span>
              )}
            </div>
            <span class="accordion-chevron" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </summary>
          <div class="accordion-content">
            {sectionIndex === 0 && (
              <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 p-4">
                <p class="mb-1 text-[0.7rem] font-black uppercase tracking-[0.1em] text-clay-text">Before booking</p>
                <p class="text-sm font-bold leading-relaxed text-ink">{beforePayingText}</p>
              </div>
            )}
            <ul class="grid list-none gap-2 p-0">
              {section.items.map((item) => (
                <li
                  data-tags={item.tags ? item.tags.join(",") : ""}
                  data-optional={section.num == null ? "true" : "false"}
                >
                  <div class="why-row">
                    <label class={"checklist-row flex min-h-[3rem] gap-3 rounded-lg border border-line bg-cream px-3 py-3 text-sm font-bold leading-relaxed text-ink sm:text-[0.96rem]" + (section.num == null ? " checklist-row--optional" : "") + (item.critical ? " checklist-row--critical" : "")} data-checked="false">
                      <input class="mt-1 h-4 w-4 shrink-0 accent-clay" type="checkbox" data-item-id={item.id} aria-label={`Mark complete: ${item.text}`} />
                      <span class="min-w-0 flex-1">
                        <span class="block">
                          {item.text}
                          {item.sources && item.sources.map((src) => (
                            <sup><a class="source-link" href={src.url} target="_blank" rel="noopener">{src.label}&nbsp;↗</a></sup>
                          ))}
                        </span>
                        {item.tags && item.tags.length > 0 && (
                          <span class="item-tag-row" aria-hidden="true">
                            {item.tags.map((tag) => (
                              <span class="item-tag-chip">{tagLabels[tag]}</span>
                            ))}
                          </span>
                        )}
                        {item.recheckOf && item.recheckOf.length > 0 && (
                          <span class="recheck-meta" data-recheck-ids={item.recheckOf.join(",")}>
                            {getRecheckSections(item.recheckOf).map((sec, i) => (
                              <Fragment>{i > 0 && <span aria-hidden="true">, </span>}<a class="recheck-link" href={`#${sec.anchor}`}>{sec.label}</a></Fragment>
                            ))}
                            <span class="originally-checked-note" hidden>✓ originally checked</span>
                          </span>
                        )}
                      </span>
                    </label>
                    {item.why && (
                      <button
                        class="why-toggle"
                        type="button"
                        aria-expanded="false"
                        aria-controls={`why-${item.id}`}
                      >why?</button>
                    )}
                  </div>
                  {item.why && (
                    <div class="why-content" id={`why-${item.id}`} hidden>
                      {item.why}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
          </details>
        </Fragment>
      ))}
    </article>

    <aside class="checklist-aside sticky top-24 grid gap-5 print:static">
      <details id="sidebar-details">
        <summary class="sidebar-details-summary">
          <span>Final sweep — tap to open.</span>
          <svg class="sidebar-details-chevron" width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <section class="rounded-xl border border-clay/30 bg-cream p-5 shadow-card" aria-labelledby="do-not-forget-heading">
          <p class="mb-2 text-[0.72rem] font-black uppercase tracking-[0.1em] text-clay-text">Final sweep</p>
          <h2 id="do-not-forget-heading" class="max-w-none text-[clamp(1.45rem,3vw,2rem)]">Do not forget</h2>
          <p id="critical-count" class="mt-3 text-sm font-semibold text-ink"></p>
          <ul id="critical-list" class="mt-2 list-none p-0" aria-label="Unchecked critical items"></ul>
          <p id="critical-complete" hidden class="mt-3 text-sm font-bold text-forest">All critical items complete ✓</p>
        </section>
      </details>
      <section class="rounded-xl border border-line bg-surface p-5" aria-label="Official source reminder">
        <p class="text-sm font-bold leading-relaxed text-muted">
          Rules can change. Use official government, airline, embassy, consulate, insurer, and health sources before booking or departing. Ask a travel clinic or doctor where relevant.
        </p>
      </section>
    </aside>
  </section>

  <!-- Jump to next unchecked (mobile-only floating button) -->
  <button
    id="jump-to-next"
    class="jump-btn print:hidden"
    type="button"
    aria-label="Jump to next unchecked item"
  >
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M5 7.5L10 12.5L15 7.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <script is:inline define:vars={{ copyText, criticalItems }}>
    (function () {
      var STORAGE_KEY = "50fsh.checklist.v1";
      var state;
      var writeTimer = null;
      var progressTimer = null;
      var resetPending = false;
      var resetTimer = null;

      function freshState() {
        return {
          version: 1,
          checked: [],
          tripDate: null,
          filters: { remote: false, driving: false, kids: false, altitude: false },
          updatedAt: new Date().toISOString()
        };
      }

      function loadState() {
        try {
          var raw = localStorage.getItem(STORAGE_KEY);
          if (raw) {
            var parsed = JSON.parse(raw);
            if (parsed && parsed.version === 1) {
              state = parsed;
              if (!state.filters) state.filters = { remote: false, driving: false, kids: false, altitude: false };
              return;
            }
          }
        } catch (_) {}
        state = freshState();
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (_) {}
      }

      function saveState() {
        try {
          state.updatedAt = new Date().toISOString();
          localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        } catch (_) {}
      }

      function debouncedSave() {
        clearTimeout(writeTimer);
        writeTimer = setTimeout(saveState, 150);
      }

      function getProgressCounts() {
        var all = Array.from(document.querySelectorAll("#checklist-article [data-item-id]"));
        var visible = all.filter(function (cb) {
          var li = cb.closest("li");
          return !li || li.style.display !== "none";
        });
        var required = visible.filter(function (cb) {
          var li = cb.closest("li");
          return !li || li.getAttribute("data-optional") !== "true";
        });
        var optional = visible.filter(function (cb) {
          var li = cb.closest("li");
          return li && li.getAttribute("data-optional") === "true";
        });
        return {
          checked: required.filter(function (cb) { return cb.checked; }).length,
          total: required.length,
          optChecked: optional.filter(function (cb) { return cb.checked; }).length,
          optTotal: optional.length
        };
      }

      function updateProgressBar() {
        var counts = getProgressCounts();
        var bar = document.getElementById("progress-bar");
        if (bar) bar.style.width = counts.total > 0 ? (counts.checked / counts.total * 100) + "%" : "0%";
      }

      function updateProgressText() {
        var counts = getProgressCounts();
        var liveEl = document.getElementById("progress-live");
        if (liveEl) {
          liveEl.innerHTML =
            "<strong>" + counts.checked + "</strong> <span class=\"progress-of\">of</span> <strong>" + counts.total + "</strong> complete";
        }
        var optEl = document.getElementById("progress-optional");
        if (optEl) {
          optEl.textContent = counts.optTotal > 0
            ? "+ " + counts.optChecked + " of " + counts.optTotal + " optional"
            : "";
        }
      }

      function updateProgress() {
        updateProgressBar();
        clearTimeout(progressTimer);
        progressTimer = setTimeout(updateProgressText, 500);
      }

      function updateProgressImmediate() {
        updateProgressBar();
        updateProgressText();
      }

      function restoreState() {
        var checkedSet = new Set(state.checked);
        document.querySelectorAll("#checklist-article [data-item-id]").forEach(function (cb) {
          var id = cb.dataset.itemId;
          var isChecked = checkedSet.has(id);
          cb.checked = isChecked;
          var label = cb.closest(".checklist-row");
          if (label) label.dataset.checked = isChecked ? "true" : "false";
        });
        updateProgressImmediate();
        buildSidebar();
        updateJumpBtn();
        updateTripDateUI();
        applyFilters();
        updateFilterChips();
        updateRecheckAnnotations();
      }

      function updateRecheckAnnotations() {
        var checkedSet = new Set(state.checked);
        document.querySelectorAll(".recheck-meta[data-recheck-ids]").forEach(function (meta) {
          var ids = meta.getAttribute("data-recheck-ids").split(",").filter(Boolean);
          var allChecked = ids.length > 0 && ids.every(function (id) { return checkedSet.has(id); });
          var note = meta.querySelector(".originally-checked-note");
          if (note) {
            if (allChecked) note.removeAttribute("hidden");
            else note.setAttribute("hidden", "");
          }
        });
      }

      function applyFilters() {
        var active = Object.keys(state.filters).filter(function (k) { return state.filters[k]; });
        document.querySelectorAll("#checklist-article li[data-tags]").forEach(function (li) {
          var tagsAttr = li.getAttribute("data-tags");
          var itemTags = tagsAttr ? tagsAttr.split(",").filter(Boolean) : [];
          if (itemTags.length === 0) {
            li.style.display = "";
          } else {
            var show = active.length > 0 && active.some(function (f) { return itemTags.indexOf(f) !== -1; });
            li.style.display = show ? "" : "none";
          }
        });
      }

      function updateFilterChips() {
        document.querySelectorAll(".filter-chip").forEach(function (btn) {
          var f = btn.dataset.filter;
          var on = state.filters[f] === true;
          btn.setAttribute("aria-pressed", on ? "true" : "false");
          if (on) btn.classList.add("filter-chip--active");
          else    btn.classList.remove("filter-chip--active");
        });
      }

      function highlightProgressCounter() {
        var el = document.getElementById("progress-live");
        if (!el) return;
        el.classList.remove("progress-flash");
        void el.offsetWidth; // reflow to restart animation
        el.classList.add("progress-flash");
      }

      function readUrlFilters() {
        var params = new URLSearchParams(window.location.search);
        var keys = ["remote", "driving", "kids", "altitude"];
        var hadAny = keys.some(function (k) { return params.has(k); });
        if (!hadAny) return false;
        keys.forEach(function (k) { state.filters[k] = params.get(k) === "1"; });
        return true;
      }

      function updateUrl() {
        var params = new URLSearchParams();
        ["remote", "driving", "kids", "altitude"].forEach(function (k) {
          if (state.filters[k]) params.set(k, "1");
        });
        var qs = params.toString();
        history.replaceState(null, "", window.location.pathname + (qs ? "?" + qs : "") + window.location.hash);
      }

      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      function buildSidebar() {
        var checkedSet = new Set(state.checked);
        var uncheckedCount = criticalItems.filter(function (item) {
          return !checkedSet.has(item.id);
        }).length;
        var countEl = document.getElementById("critical-count");
        var listEl = document.getElementById("critical-list");
        var completeEl = document.getElementById("critical-complete");
        if (!countEl || !listEl || !completeEl) return;
        if (uncheckedCount === 0) {
          countEl.textContent = "";
          completeEl.removeAttribute("hidden");
        } else {
          completeEl.setAttribute("hidden", "");
          countEl.textContent = uncheckedCount + " critical item" + (uncheckedCount === 1 ? "" : "s") + " still to do";
        }
        // Always render all critical items with checkboxes
        listEl.innerHTML = criticalItems.map(function (item) {
          var isChecked = checkedSet.has(item.id);
          return '<li class="critical-item' + (isChecked ? " critical-item--done" : "") + '">' +
            '<div class="critical-item-row">' +
            '<input type="checkbox" class="critical-sidebar-cb" data-item-id="' + escapeHtml(item.id) + '"' +
            (isChecked ? " checked" : "") +
            ' aria-label="' + escapeHtml("Mark complete: " + item.text) + '" />' +
            '<a href="#" class="critical-link" data-target-id="' + escapeHtml(item.id) + '">' +
            escapeHtml(item.text) + '</a>' +
            '</div></li>';
        }).join("");
      }

      function updateJumpBtn() {
        var btn = document.getElementById("jump-to-next");
        if (!btn) return;
        var hasUnchecked = Array.from(document.querySelectorAll("#checklist-article [data-item-id]:not(:checked)")).some(function (cb) {
          var li = cb.closest("li");
          return !li || li.style.display !== "none";
        });
        btn.hidden = !hasUnchecked;
      }

      function jumpToNext() {
        var all = Array.from(document.querySelectorAll("#checklist-article [data-item-id]:not(:checked)")).filter(function (cb) {
          var li = cb.closest("li");
          return !li || li.style.display !== "none";
        });
        if (all.length === 0) {
          updateJumpBtn();
          return;
        }
        // Find first unchecked item below the current viewport top (with buffer for sticky strip)
        var next = null;
        for (var i = 0; i < all.length; i++) {
          if (all[i].getBoundingClientRect().top > 80) {
            next = all[i];
            break;
          }
        }
        // Fallback: if none found below, wrap to first overall
        if (!next) next = all[0];
        var details = next.closest("details.checklist-accordion");
        if (details && !details.open) {
          details.open = true;
          requestAnimationFrame(function () {
            next.scrollIntoView({ behavior: "smooth", block: "center" });
            next.focus();
          });
        } else {
          next.scrollIntoView({ behavior: "smooth", block: "center" });
          next.focus();
        }
      }

      function updateTripDateUI() {
        var dateInput = document.getElementById("trip-date");
        var icalBtnEl = document.getElementById("ical-btn");
        var banner = document.getElementById("days-to-go-banner");
        var bannerText = document.getElementById("days-to-go-text");

        if (dateInput) dateInput.value = state.tripDate || "";
        if (icalBtnEl) icalBtnEl.disabled = !state.tripDate;

        if (!state.tripDate) {
          if (banner) banner.setAttribute("hidden", "");
          [10, 11, 12].forEach(function (n) {
            var chip = document.getElementById("section-" + n + "-chip");
            if (chip) chip.setAttribute("hidden", "");
          });
          return;
        }

        // Parse as local midnight to avoid timezone shifts
        var dp = state.tripDate.split("-");
        var tripDate = new Date(+dp[0], +dp[1] - 1, +dp[2]);
        var today = new Date(); today.setHours(0, 0, 0, 0);
        var diffDays = Math.round((tripDate - today) / 86400000);

        if (banner && bannerText) {
          var msg;
          if (diffDays > 0)      msg = diffDays + (diffDays === 1 ? " day to go" : " days to go");
          else if (diffDays === 0) msg = "Today’s the day!";
          else                     msg = "Have a good trip ✈";
          bannerText.textContent = msg;
          banner.removeAttribute("hidden");
        }

        var sectionCfg = [
          { num: 10, offset: 7, prefix: "by " },
          { num: 11, offset: 1, prefix: "" },
          { num: 12, offset: 0, prefix: "" }
        ];
        sectionCfg.forEach(function (cfg) {
          var chip = document.getElementById("section-" + cfg.num + "-chip");
          if (!chip) return;
          var d = new Date(tripDate.getFullYear(), tripDate.getMonth(), tripDate.getDate() - cfg.offset);
          var label = d.toLocaleDateString(undefined, { weekday: "short", month: "short", day: "numeric" });
          chip.textContent = cfg.prefix + label;
          chip.removeAttribute("hidden");
        });
      }

      function generateIcs(tripDateStr) {
        var dp = tripDateStr.split("-");
        var trip = new Date(+dp[0], +dp[1] - 1, +dp[2]);
        var pad = function (n) { return String(n).padStart(2, "0"); };
        function toD(d) { return d.getFullYear() + "" + pad(d.getMonth() + 1) + "" + pad(d.getDate()); }
        function icsEsc(s) {
          return s.replace(/\\/g, "\\\\").replace(/;/g, "\\;").replace(/,/g, "\\,").replace(/\n/g, "\\n");
        }
        var now = new Date();
        var dtstamp = now.getUTCFullYear() + "" + pad(now.getUTCMonth() + 1) + "" + pad(now.getUTCDate()) +
          "T" + pad(now.getUTCHours()) + "" + pad(now.getUTCMinutes()) + "" + pad(now.getUTCSeconds()) + "Z";
        var base = "https://50fivestarhotels.com/pre-travel-checklist/";
        var evts = [
          { off: 56, sum: "Book major reservations (flights, key hotels)",        sec: "1" },
          { off: 28, sum: "Travel clinic appointment if vaccinations needed",      sec: "6" },
          { off: 14, sum: "Re-check entry rules, weather, and insurance",          sec: "1" },
          { off:  7, sum: "Final week: re-check bookings, prepare documents",      sec: "10" },
          { off:  1, sum: "Day-before final sweep",                                sec: "11" },
          { off:  0, sum: "Departure day",                                         sec: "12" }
        ];
        var lines = [
          "BEGIN:VCALENDAR", "VERSION:2.0",
          "PRODID:-//50 Five-Star Hotels//Pre-Travel Checklist//EN",
          "CALSCALE:GREGORIAN", "METHOD:PUBLISH",
          "X-WR-CALNAME:50 Five-Star Hotels - Trip Reminders"
        ];
        evts.forEach(function (ev) {
          var start = new Date(trip.getFullYear(), trip.getMonth(), trip.getDate() - ev.off);
          var end   = new Date(start.getFullYear(), start.getMonth(), start.getDate() + 1);
          lines.push("BEGIN:VEVENT");
          lines.push("UID:" + tripDateStr + "-d" + ev.off + "@50fivestarhotels.com");
          lines.push("DTSTAMP:" + dtstamp);
          lines.push("DTSTART;VALUE=DATE:" + toD(start));
          lines.push("DTEND;VALUE=DATE:" + toD(end));
          lines.push("SUMMARY:" + icsEsc(ev.sum));
          lines.push("DESCRIPTION:" + icsEsc(base + "#section-" + ev.sec));
          lines.push("END:VEVENT");
        });
        lines.push("END:VCALENDAR");
        return lines.join("\r\n");
      }

      // Delegated change listener on the article
      var article = document.getElementById("checklist-article");
      if (article) {
        article.addEventListener("change", function (e) {
          if (e.target.matches("[data-item-id]")) {
            var id = e.target.dataset.itemId;
            var isChecked = e.target.checked;
            var label = e.target.closest(".checklist-row");
            if (label) label.dataset.checked = isChecked ? "true" : "false";
            if (isChecked) {
              if (state.checked.indexOf(id) === -1) state.checked.push(id);
            } else {
              state.checked = state.checked.filter(function (i) { return i !== id; });
            }
            debouncedSave();
            updateProgress();
            updateJumpBtn();
            buildSidebar();
            updateRecheckAnnotations();
          }
        });

        // Why-toggle click delegation
        article.addEventListener("click", function (e) {
          var btn = e.target.closest(".why-toggle");
          if (btn) {
            var controlsId = btn.getAttribute("aria-controls");
            var content = controlsId ? document.getElementById(controlsId) : null;
            if (!content) return;
            var expanded = btn.getAttribute("aria-expanded") === "true";
            btn.setAttribute("aria-expanded", expanded ? "false" : "true");
            if (expanded) content.setAttribute("hidden", "");
            else content.removeAttribute("hidden");
            return;
          }
          // Recheck link click delegation
          var recheckLink = e.target.closest(".recheck-link");
          if (recheckLink) {
            e.preventDefault();
            var href = recheckLink.getAttribute("href");
            var targetSection = href ? document.querySelector(href) : null;
            if (targetSection) {
              if (targetSection.tagName === "DETAILS" && !targetSection.open) {
                targetSection.open = true;
                requestAnimationFrame(function () {
                  targetSection.scrollIntoView({ behavior: "smooth", block: "start" });
                });
              } else {
                targetSection.scrollIntoView({ behavior: "smooth", block: "start" });
              }
            }
          }
        });
      }

      // Reset button
      var resetBtn = document.getElementById("reset-btn");
      var resetMsg = document.getElementById("reset-msg");
      if (resetBtn) {
        resetBtn.addEventListener("click", function () {
          if (!resetPending) {
            resetPending = true;
            resetBtn.textContent = "Click again to confirm.";
            if (resetMsg) resetMsg.textContent = "Click reset again to confirm clearing all checked items.";
            resetTimer = setTimeout(function () {
              resetPending = false;
              resetBtn.textContent = "Reset";
              if (resetMsg) resetMsg.textContent = "";
            }, 5000);
          } else {
            clearTimeout(resetTimer);
            resetPending = false;
            resetBtn.textContent = "Reset";
            if (resetMsg) resetMsg.textContent = "";
            state.checked = [];
            saveState();
            document.querySelectorAll("#checklist-article [data-item-id]").forEach(function (cb) {
              cb.checked = false;
              var label = cb.closest(".checklist-row");
              if (label) label.dataset.checked = "false";
            });
            updateProgressImmediate();
            buildSidebar();
            updateJumpBtn();
          }
        });
      }

      // Expand / Collapse all
      var allExpanded = false;
      var expandAllBtn = document.getElementById("expand-all-btn");
      if (expandAllBtn) {
        expandAllBtn.addEventListener("click", function () {
          allExpanded = !allExpanded;
          document.querySelectorAll(".checklist-accordion").forEach(function (d) {
            d.open = allExpanded;
          });
          expandAllBtn.textContent = allExpanded ? "Collapse all" : "Expand all";
        });
      }

      // Sidebar details: force-open at lg breakpoint
      function syncSidebarDetails() {
        var details = document.getElementById("sidebar-details");
        if (!details) return;
        if (window.matchMedia("(min-width: 1024px)").matches) {
          details.open = true;
        }
      }
      syncSidebarDetails();
      try {
        window.matchMedia("(min-width: 1024px)").addEventListener("change", function (e) {
          if (e.matches) {
            var details = document.getElementById("sidebar-details");
            if (details) details.open = true;
          }
        });
      } catch (_) {}

      // Sidebar event delegation — checkbox sync + critical link scroll
      var sidebarAside = document.querySelector(".checklist-aside");
      if (sidebarAside) {
        // Sidebar checkbox → sync main checklist
        sidebarAside.addEventListener("change", function (e) {
          if (!e.target.matches(".critical-sidebar-cb")) return;
          var id = e.target.dataset.itemId;
          var isChecked = e.target.checked;
          if (isChecked) {
            if (state.checked.indexOf(id) === -1) state.checked.push(id);
          } else {
            state.checked = state.checked.filter(function (i) { return i !== id; });
          }
          debouncedSave();
          // Sync the corresponding checkbox in the main checklist
          var mainCb = document.querySelector('#checklist-article [data-item-id="' + id + '"]');
          if (mainCb) {
            mainCb.checked = isChecked;
            var mainLabel = mainCb.closest(".checklist-row");
            if (mainLabel) mainLabel.dataset.checked = isChecked ? "true" : "false";
          }
          updateProgressImmediate();
          updateJumpBtn();
          buildSidebar();
          updateRecheckAnnotations();
        });

        // Critical link → scroll to and focus main checkbox
        sidebarAside.addEventListener("click", function (e) {
          var link = e.target.closest(".critical-link");
          if (!link) return;
          e.preventDefault();
          var targetId = link.dataset.targetId;
          var cb = document.querySelector('#checklist-article [data-item-id="' + targetId + '"]');
          if (!cb) return;
          var details = cb.closest("details.checklist-accordion");
          if (details && !details.open) {
            details.open = true;
            requestAnimationFrame(function () {
              cb.scrollIntoView({ behavior: "smooth", block: "center" });
              cb.focus();
            });
          } else {
            cb.scrollIntoView({ behavior: "smooth", block: "center" });
            cb.focus();
          }
        });
      }

      // Jump-to-next button
      var jumpBtn = document.getElementById("jump-to-next");
      if (jumpBtn) {
        jumpBtn.addEventListener("click", jumpToNext);
      }

      // Hide jump button when virtual keyboard is likely open
      if (window.visualViewport) {
        window.visualViewport.addEventListener("resize", function () {
          var btn = document.getElementById("jump-to-next");
          if (!btn) return;
          var vvHeight = window.visualViewport.height;
          var winHeight = window.innerHeight;
          if (vvHeight < winHeight * 0.7) {
            btn.hidden = true;
          } else {
            updateJumpBtn();
          }
        });
      }

      // Filter chips
      document.querySelectorAll(".filter-chip").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var f = btn.dataset.filter;
          state.filters[f] = !state.filters[f];
          saveState();
          updateUrl();
          applyFilters();
          updateFilterChips();
          updateProgressImmediate();
          highlightProgressCounter();
          updateJumpBtn();
          buildSidebar();
        });
      });

      // Trip date input
      var tripDateInput = document.getElementById("trip-date");
      if (tripDateInput) {
        tripDateInput.addEventListener("change", function () {
          var val = tripDateInput.value;
          if (!val) {
            state.tripDate = null;
            saveState();
            updateTripDateUI();
            return;
          }
          // Reject past dates silently
          var dp = val.split("-");
          var selected = new Date(+dp[0], +dp[1] - 1, +dp[2]);
          var today = new Date(); today.setHours(0, 0, 0, 0);
          if (selected < today) {
            tripDateInput.value = state.tripDate || "";
            return;
          }
          state.tripDate = val;
          saveState();
          updateTripDateUI();
        });
      }

      // iCal download
      var icalBtnEl = document.getElementById("ical-btn");
      if (icalBtnEl) {
        icalBtnEl.addEventListener("click", function () {
          if (!state.tripDate) return;
          var icsContent = generateIcs(state.tripDate);
          var blob = new Blob([icsContent], { type: "text/calendar;charset=utf-8" });
          var url = URL.createObjectURL(blob);
          var a = document.createElement("a");
          a.href = url;
          a.download = "50fsh-trip-reminders-" + state.tripDate + ".ics";
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
        });
      }

      // Print handlers
      var printButton = document.getElementById("print-checklist");
      var copyButton = document.getElementById("copy-checklist");
      var copyStatus = document.getElementById("copy-status");

      if (printButton) {
        printButton.addEventListener("click", function () { window.print(); });
      }

      window.addEventListener("beforeprint", function () {
        document.querySelectorAll("details.checklist-accordion").forEach(function (d) {
          d._wasOpen = d.open;
          d.open = true;
        });
      });

      window.addEventListener("afterprint", function () {
        document.querySelectorAll("details.checklist-accordion").forEach(function (d) {
          d.open = d._wasOpen !== undefined ? d._wasOpen : false;
        });
      });

      if (copyButton) {
        copyButton.addEventListener("click", function () {
          navigator.clipboard.writeText(copyText).then(function () {
            if (copyStatus) copyStatus.textContent = "Copied.";
          }).catch(function () {
            if (copyStatus) copyStatus.textContent = "Copy failed. Select and copy the page text instead.";
          });
        });
      }

      // Init
      loadState();
      if (readUrlFilters()) { saveState(); }
      restoreState();
    })();
  </script>

  <style>
    /* ── Number badge ─────────────────────────────────────────────────── */
    .section-badge {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 52px;
      height: 52px;
      border-radius: 18px;
      background: linear-gradient(135deg, #F6ECD9 0%, #E0D3B0 50%, #A0682E 100%);
      font-size: 1.4rem;
      font-weight: 900;
      color: #5A3D1C;
      line-height: 1;
      letter-spacing: -0.03em;
      box-shadow:
        inset 0 1px 1px rgba(255, 255, 255, 0.7),
        0 2px 8px rgba(160, 104, 46, 0.25);
    }

    .section-badge--double {
      font-size: 1.1rem;
      letter-spacing: -0.02em;
    }

    /* ── Accordion card ───────────────────────────────────────────────── */
    .accordion-summary {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1rem 1.25rem;
      cursor: pointer;
      list-style: none;
      user-select: none;
    }

    .accordion-summary::-webkit-details-marker {
      display: none;
    }

    .accordion-summary:focus-visible {
      outline: 3px solid var(--color-clay);
      outline-offset: -3px;
      border-radius: 0.75rem;
    }

    .checklist-accordion > .accordion-summary:hover {
      background-color: var(--color-tag-bg);
      border-radius: 0.75rem;
    }

    details[open] > .accordion-summary {
      border-bottom: 1px solid var(--color-line);
      border-radius: 0.75rem 0.75rem 0 0;
    }

    .accordion-title {
      font-family: var(--font-sans);
      font-size: 1.05rem;
      font-weight: 800;
      line-height: 1.25;
      max-width: none;
      color: var(--color-ink);
      letter-spacing: -0.01em;
    }

    .accordion-helper {
      margin-top: 0.25rem;
      font-size: 0.875rem;
      font-weight: 500;
      line-height: 1.45;
