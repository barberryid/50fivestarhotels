      padding: 0.25rem 0;
      transition: color 150ms ease;
      white-space: nowrap;
    }

    .progress-btn:hover {
      color: var(--color-ink);
    }

    .progress-btn:focus-visible {
      outline: 2px solid var(--color-clay);
      outline-offset: 2px;
      border-radius: 4px;
    }

    /* ── Mobile sidebar reorder ───────────────────────────────────────── */
    @media (max-width: 1023px) {
      .checklist-aside {
        order: -1;
      }
    }

    /* ── Sidebar details wrapper ──────────────────────────────────────── */
    #sidebar-details {
      /* No extra chrome — inner section provides its own card style */
    }

    .sidebar-details-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      list-style: none;
      cursor: pointer;
      padding: 0.75rem 1rem;
      font-size: 0.875rem;
      font-weight: 700;
      color: var(--color-clay-text);
      background: var(--color-cream);
      border: 1px solid var(--color-clay);
      border-radius: 0.75rem;
