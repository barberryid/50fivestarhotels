    }

    #sidebar-details[open] > section {
      margin-top: 0.5rem;
    }

    /* On desktop, hide the summary toggle — details is kept open by JS */
    @media (min-width: 1024px) {
      .sidebar-details-summary {
        display: none;
      }
    }

    /* ── Mobile ───────────────────────────────────────────────────────── */
    @media (max-width: 480px) {
      .section-badge {
        width: 44px;
