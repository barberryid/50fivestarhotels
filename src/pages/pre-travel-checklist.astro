    }

    /* ── Progress strip ───────────────────────────────────────────────── */
    .progress-strip {
      position: sticky;
      top: 0;
      z-index: 20;
      background: var(--color-cream);
      border-bottom: 1px solid var(--color-line);
    }

    .progress-bar-track {
      height: 4px;
      background: var(--color-line);
      position: relative;
      overflow: hidden;
    }

    .progress-bar-fill {
      position: absolute;
      inset-block: 0;
      left: 0;
      background: var(--color-clay);
      width: 0%;
      transition: width 200ms ease;
    }

    .progress-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.5rem 1rem;
    }

    .progress-text {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--color-ink);
    }

    .progress-of {
      color: var(--color-muted);
      font-weight: 500;
    }

    .progress-controls {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-shrink: 0;
    }

    .progress-btn {
      font-size: 0.875rem;
      font-weight: 700;
