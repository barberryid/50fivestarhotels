---
import BaseLayout from "../layouts/BaseLayout.astro";

type ChecklistItem = {
  id: string;
  text: string;
  critical?: boolean;
  why?: string;
  sources?: Array<{ label: string; url: string }>;
  tags?: string[];
  recheckOf?: string[];
};

type ChecklistSection = {
  num?: number;
  title: string;
  helper: string;
  items: ChecklistItem[];
};

