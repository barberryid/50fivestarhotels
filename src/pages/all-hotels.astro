---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import HotelComparisonTable from '../components/HotelComparisonTable.astro';
import FinderCta from '../components/FinderCta.astro';
import { breadcrumbJsonLd, canonicalUrl, itemListJsonLd } from '../lib/seo';

const allHotels = await getCollection('hotels', ({ data }) => !data.draft);
allHotels.sort((a, b) => a.data.rank - b.data.rank);

const tableHotels = allHotels.map(h => ({
  slug: h.data.slug,
  rank: h.data.rank,
  title: h.data.title,
  city: h.data.city,
  country: h.data.country,
  budgetTier: h.data.budgetTier,
  valueScore: h.data.valueScore,
  verdict: h.data.verdict,
  fiveStarStatus: h.data.fiveStarStatus,
  bestFor: h.data.bestFor,
  cautions: h.data.cautions,
}));

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: canonicalUrl('/') },
    { name: 'Examples', url: canonicalUrl('/all-hotels/') },
  ]),
  itemListJsonLd('Hotel-value examples from 50 Five-Star Hotels', allHotels),
];
---

<PageLayout
  title="Example Hotel Library | 50 Five-Star Hotels"
  description="50+ hand-scored hotel-value examples, ranked by editorial value score. Use them as benchmarks when researching your own trip with the Hotel Finder."
  canonical="/all-hotels/"
  jsonLd={jsonLd}
  maxWidth="max-w-6xl"
>
  <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">Example library</p>
  <h1 class="font-serif text-4xl md:text-5xl font-bold text-[#1F2428] leading-tight mb-10">50+ hotel-value examples at a glance</h1>

  <HotelComparisonTable hotels={tableHotels} title="" />

  <div class="mt-10">
    <FinderCta
      title="Research your own destination"
      text="These examples show the method. Use the Hotel Finder to apply the same value logic to wherever you are going next."
    />
  </div>

</PageLayout>
