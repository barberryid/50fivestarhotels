---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import HotelComparisonTable from '../components/HotelComparisonTable.astro';
import { breadcrumbJsonLd, canonicalUrl, itemListJsonLd, webPageJsonLd } from '../lib/seo';

// The full published collection — every non-draft hotel — ranked by value.
const collection = await getCollection('hotels', ({ data }) => !data.draft);
const tableHotels = collection
  .map(({ data }) => ({
    slug: data.slug,
    rank: data.rank,
    title: data.title,
    city: data.city,
    country: data.country,
    budgetTier: data.budgetTier,
    valueScore: data.valueScore,
    verdict: data.verdict,
    fiveStarStatus: data.fiveStarStatus,
    bestFor: data.bestFor,
    cautions: data.cautions,
  }))
  .sort((a, b) => a.rank - b.rank);

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: canonicalUrl('/') },
    { name: 'The Collection', url: canonicalUrl('/all-hotels/') },
  ]),
  webPageJsonLd({
    title: 'The Collection | 50 Five-Star Hotels',
    description: "Every five-star (and near-five-star) stay we've published - ranked by value and grouped by what you'll spend a night, all under EUR250 in shoulder season.",
    path: '/all-hotels/',
    type: 'CollectionPage',
  }),
  itemListJsonLd('Five-star value stays from 50 Five-Star Hotels', tableHotels),
];
---

<BaseLayout
  title="The Collection | 50 Five-Star Hotels"
  description="Every five-star (and near-five-star) stay we've published — ranked by value and grouped by what you'll spend a night, all under €250 in shoulder season."
  canonical="/all-hotels/"
  jsonLd={jsonLd}
>
  <div class="fs" style="--accent:#B0492B;font-family:'Source Serif 4',Georgia,serif;color:#2A2622;background:#F7EFD7;">
    <main>
      <section style="padding:clamp(34px,5vw,60px) clamp(18px,4vw,40px) 18px;border-bottom:1px solid #ECE0C2;">
        <div style="max-width:1180px;margin:0 auto;">
          <p style="font-family:'Archivo',sans-serif;font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#A0682E;margin:0 0 14px;">The collection</p>
          <h1 style="font-family:'Bodoni Moda',serif;font-weight:600;font-size:clamp(36px,6vw,70px);line-height:1;letter-spacing:-0.015em;margin:0;">Every <span style="font-family:'Dancing Script',cursive;color:var(--accent);font-size:1.1em;">five-star</span> stay</h1>
          <p style="font-family:'Source Serif 4',serif;font-size:17px;line-height:1.6;color:#5C544A;max-width:62ch;margin:18px 0 0;">Every five-star (and near-five-star) stay we've published — <strong style="color:#2A2622;">{tableHotels.length}</strong> in all, ranked by value and grouped by what you'll spend a night, all under €250 in shoulder season. Tap any hotel for the full profile.</p>
        </div>
      </section>

      <section style="padding:clamp(28px,4vw,44px) clamp(18px,4vw,40px) clamp(48px,6vw,80px);">
        <div style="max-width:1180px;margin:0 auto;">
          <HotelComparisonTable hotels={tableHotels} title={`All ${tableHotels.length} stays at a glance`} />
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
