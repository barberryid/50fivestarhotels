---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HotelCard from '../components/HotelCard.astro';
import PriceTierCard from '../components/PriceTierCard.astro';
import HotelComparisonTable from '../components/HotelComparisonTable.astro';

const allHotels = await getCollection('hotels', ({ data }) => !data.draft);
allHotels.sort((a, b) => a.data.rank - b.data.rank);

const featuredSlugs = ['hotel-majapahit-surabaya','phoenix-hotel-yogyakarta','majestic-hotel-kuala-lumpur','stamba-hotel-tbilisi','raweekanlaya-bangkok'];
const featured = allHotels.filter(h => featuredSlugs.includes(h.data.slug));

const under100Count = allHotels.filter(h => h.data.budgetTier === 'Under €100').length;
const under200Count = allHotels.filter(h => h.data.budgetTier === 'Under €200').length;
const under250Count = allHotels.filter(h => h.data.budgetTier === 'Under €250').length;

const tableHotels = allHotels.map(h => ({
  slug: h.data.slug,
  rank: h.data.rank,
  title: h.data.title,
  city: h.data.city,
  budgetTier: h.data.budgetTier,
  valueScore: h.data.valueScore,
  verdict: h.data.verdict,
}));
---

<BaseLayout
  title="50 Five-Star Hotels | Five-Star Hotels Without Five-Star Prices"
  description="A luxury editorial guide to affordable five-star and near-five-star hotels around the world, from heritage hotels in Java to spa stays, city hotels and smart splurges."
>
  <main>
    <!-- Hero -->
    <section class="bg-[#F8F5EF]">
      <div class="max-w-6xl mx-auto px-5 py-20 md:py-28">
        <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-5">Affordable luxury travel</p>
        <h1 class="font-serif text-5xl md:text-7xl font-bold text-[#1D2433] leading-[0.95] tracking-tight max-w-3xl">
          Five-star hotels without five-star prices.
        </h1>
        <p class="text-[#6B7280] text-xl mt-8 leading-relaxed max-w-2xl">
          A luxury editorial guide to hotels where the price feels surprisingly modest for the setting, service, history or sense of occasion.
        </p>
        <div class="flex flex-wrap gap-3 mt-10">
          <a href="#featured" class="inline-flex items-center bg-[#1D2433] text-white font-semibold py-3.5 px-7 rounded-full hover:bg-[#B88A44] transition-colors no-underline text-sm">
            Explore the best-value hotels
          </a>
          <a href="/under-100" class="inline-flex items-center bg-transparent text-[#1D2433] font-semibold py-3.5 px-7 rounded-full border border-[#1D2433]/20 hover:border-[#B88A44] hover:text-[#B88A44] transition-colors no-underline text-sm">
            See hotels under €100
          </a>
        </div>
        <p class="text-[#6B7280] text-xs mt-5 leading-relaxed">
          Prices change constantly. Every hotel here should be checked by date, room type, taxes and cancellation policy before booking.
        </p>
      </div>
    </section>

    <!-- Editorial intro -->
    <section class="bg-white border-y border-[#1D2433]/6">
      <div class="max-w-4xl mx-auto px-5 py-16">
        <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-5">The idea</p>
        <p class="text-[#1D2433]/75 text-lg leading-relaxed mb-5">
          Luxury is not priced evenly around the world. In some cities, a five-star or near-five-star hotel can cost less than a mid-range room elsewhere. The trick is knowing which hotels are genuinely worth considering — and which are simply cheap because the standard, location or maintenance is weaker than the star rating suggests.
        </p>
        <p class="text-[#1D2433]/75 text-lg leading-relaxed">
          50 Five-Star Hotels focuses on the places where price, setting and experience come together: heritage hotels in Java, spa hotels in underrated European cities, Nile-side resorts in Luxor, design hotels in the Caucasus and city hotels that make an affordable trip feel far more special.
        </p>
      </div>
    </section>

    <!-- Editorial caution -->
    <section class="bg-[#1D2433]/4 border-b border-[#1D2433]/6">
      <div class="max-w-4xl mx-auto px-5 py-8">
        <p class="text-[#1D2433]/70 text-sm leading-relaxed">
          <strong class="text-[#1D2433]">A note on five-star labels:</strong> A five-star designation does not always mean international luxury. Some hotels here are true five-star properties; others are local or booking-site five-star hotels that are still interesting because the value is unusually strong. Each profile explains the difference clearly.
        </p>
      </div>
    </section>

    <!-- Price tier cards -->
    <section class="max-w-6xl mx-auto px-5 py-20">
      <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">Browse by price</p>
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-[#1D2433] mb-10">Find hotels by budget</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <PriceTierCard
          tier="Under €100"
          href="/under-100"
          tagline="Exceptional budget luxury"
          description="The hotels that make travellers look twice. Five-star or near-five-star stays that can often appear below €100 outside peak dates."
          count={under100Count}
        />
        <PriceTierCard
          tier="Under €200"
          href="/under-200"
          tagline="Affordable indulgence"
          description="Better locations, stronger brands and more reliable comfort. The largest and most diverse tier in the collection."
          count={under200Count}
        />
        <PriceTierCard
          tier="Under €250"
          href="/under-250"
          tagline="Smart splurge"
          description="Special hotels that still feel restrained compared with normal luxury prices. The best for design and setting."
          count={under250Count}
        />
      </div>
    </section>

    <!-- Featured hotels -->
    <section id="featured" class="bg-[#F8F5EF] py-20">
      <div class="max-w-6xl mx-auto px-5">
        <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">Start here</p>
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-[#1D2433] mb-4">Hotels that prove the idea.</h2>
        <p class="text-[#6B7280] text-lg mb-10 max-w-2xl">Five hotels from the launch collection — chosen because each one makes the case for affordable luxury in a different way.</p>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {featured.map(h => (
            <HotelCard hotel={h.data} featured={true} />
          ))}
        </div>
      </div>
    </section>

    <!-- Comparison table -->
    <section class="max-w-6xl mx-auto px-5 py-20">
      <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">The full list</p>
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-[#1D2433] mb-4">All 20 launch hotels at a glance</h2>
      <p class="text-[#6B7280] text-lg mb-10 max-w-2xl">Ranked by value score. Click any hotel for the full editorial profile.</p>
      <HotelComparisonTable hotels={tableHotels} title="" />
      <div class="mt-8 text-center">
        <a href="/destinations" class="inline-flex items-center text-[#B88A44] font-semibold hover:underline no-underline">
          Browse all hotels by destination →
        </a>
      </div>
    </section>

    <!-- How we choose -->
    <section class="bg-white border-y border-[#1D2433]/6 py-20">
      <div class="max-w-4xl mx-auto px-5">
        <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">Our method</p>
        <h2 class="font-serif text-3xl font-bold text-[#1D2433] mb-8">How we choose hotels</h2>
        <div class="grid md:grid-cols-3 gap-8">
          {[
            { factor: 'Price and value', desc: 'How does the rate compare to the local five-star market? What does the money actually buy?' },
            { factor: 'Hotel character', desc: 'Is this a hotel with a genuine sense of place, or a generic box with a star rating?' },
            { factor: 'Location and destination', desc: 'Is the city or destination interesting enough to justify the trip? What is there to do nearby?' },
          ].map(item => (
            <div>
              <h3 class="font-serif text-lg font-bold text-[#1D2433] mb-2">{item.factor}</h3>
              <p class="text-[#6B7280] text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
        <div class="mt-8">
          <a href="/methodology" class="text-[#B88A44] font-semibold hover:underline no-underline text-sm">
            Read the full methodology →
          </a>
        </div>
      </div>
    </section>

    <!-- Footer CTA -->
    <section class="max-w-6xl mx-auto px-5 py-20 text-center">
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-[#1D2433] mb-4">
        Find the hotel where the price feels mispriced.
      </h2>
      <p class="text-[#6B7280] text-lg mb-8 max-w-xl mx-auto">
        Twenty hotels across Southeast Asia, Europe, the Middle East and the Caucasus — each one chosen because the value case is genuinely interesting.
      </p>
      <a href="/destinations" class="inline-flex items-center bg-[#1D2433] text-white font-semibold py-4 px-8 rounded-full hover:bg-[#B88A44] transition-colors no-underline">
        Browse all 20 launch hotels
      </a>
    </section>
  </main>
</BaseLayout>
