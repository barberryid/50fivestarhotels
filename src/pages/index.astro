---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DreamRouteRibbon from '../components/DreamRouteRibbon.astro';
import ToolCard from '../components/ToolCard.astro';
import { publisherJsonLd, webApplicationJsonLd, websiteJsonLd } from '../lib/seo';

const allHotels = await getCollection('hotels', ({ data }) => !data.draft);
allHotels.sort((a, b) => a.data.rank - b.data.rank);

const inspirationTierAmounts = [50, 100, 250];
const matchesBudgetTier = (budgetTier: string, amount: number) =>
  new RegExp(`(^|[^0-9])${amount}$`).test(budgetTier);

const inspirationEntries = inspirationTierAmounts.flatMap((amount) => {
  const entry = allHotels.find(({ data }) => matchesBudgetTier(data.budgetTier, amount));
  return entry ? [entry] : [];
});

const inspirationHotels = inspirationEntries.map((entry) => {
  const cardImage = entry.data.generatedGallery?.find((image) => image.type === 'realistic-daylight') ?? entry.data.image;
  return {
    ...entry.data,
    image: cardImage,
  };
});

const jsonLd = [websiteJsonLd(), publisherJsonLd(), webApplicationJsonLd()];
---

<BaseLayout
  title="50 Five-Star Hotels - AI Hotel Finder and Best Time to Go Prompts"
  description="Build simple AI travel prompts for affordable luxury hotels, five-star hotels without five-star prices, and month-by-month hotel value research."
  canonical="/"
  image="/images/social/default-og.webp"
  jsonLd={jsonLd}
>
  <main class="toolkit-shell">
    <section class="dream-postcard-hero">
      <div class="dream-postcard-hero-inner">
        <h1 class="dream-postcard-title">Find your dream hotel</h1>
        <DreamRouteRibbon />

        <div class="dream-tool-grid">
          <ToolCard
            title="Build your hotel search"
            description="Choose a destination, budget and travel style. Get a prompt designed to uncover good-value luxury hotels, not just cheap rooms."
            href="/hotel-finder/"
            cta="Start hotel hunt"
            variant="gold"
            stamp="TOOL 1"
          />
          <ToolCard
            title="Find your best month"
            description="Compare weather, hotel value, crowds and practical risks before you decide when to travel."
            href="/best-time-to-go/"
            variant="green"
            stamp="TOOL 2"
            fullCardLink
            ariaLabel="Find your best month using the Best Time to Go tool"
          />
        </div>

        <p class="dream-hero-trust">
          No account needed. No booking pressure. Just better prompts for smarter travel research.
        </p>
      </div>
    </section>

    <section class="px-5 pb-16 md:pb-24">
      <div class="mx-auto max-w-6xl">
        <div class="mb-8 max-w-3xl">
          <span class="toolkit-badge">Example hotel ideas</span>
          <h2 class="mt-4 text-3xl font-semibold leading-tight text-[#1D2433] md:text-4xl">
            Need inspiration? Browse example five-star bargains
          </h2>
          <p class="mt-4 text-base leading-7 text-[#324052]">
            These hotels show the kind of value the prompts are designed to help you find: atmospheric, comfortable or five-star-adjacent stays where the price can be surprisingly modest for the experience.
          </p>
        </div>

        <div class="grid gap-5 md:grid-cols-3">
          {inspirationHotels.map((hotel) => (
            <article class="toolkit-card overflow-hidden shadow-[4px_4px_0_rgba(29,36,51,0.08)]">
              <a href={`/hotels/${hotel.slug}`} class="block no-underline">
                <div class="aspect-[16/10] overflow-hidden bg-[#EFE3D2]">
                  <picture>
                    {hotel.image?.srcSet?.large && <source media="(min-width: 900px)" srcset={hotel.image.srcSet.large} type="image/webp" />}
                    {hotel.image?.srcSet?.small && <source media="(max-width: 899px)" srcset={hotel.image.srcSet.small} type="image/webp" />}
                    <img
                      src={hotel.image?.srcSet?.small ?? hotel.image?.src ?? '/images/placeholders/luxury-hotel-placeholder.svg'}
                      alt={hotel.image?.alt ?? `${hotel.title} in ${hotel.city}, ${hotel.country}`}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover"
                    />
                  </picture>
                </div>
                <div class="p-4">
                  <p class="text-xs font-bold uppercase tracking-[0.08em] text-[#B88A44]">{hotel.budgetTier}</p>
                  <h3 class="mt-2 text-xl font-semibold leading-snug text-[#1D2433]">{hotel.title}</h3>
                  <p class="mt-2 text-sm font-semibold text-[#58745A]">{hotel.city}, {hotel.country}</p>
                  <p class="mt-3 text-sm leading-6 text-[#6B7280]">{hotel.typicalPriceRange}</p>
                </div>
              </a>
            </article>
          ))}
        </div>

        <div class="mt-8">
          <a href="/all-hotels/" class="toolkit-button toolkit-button-secondary">
            Browse example hotels
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
