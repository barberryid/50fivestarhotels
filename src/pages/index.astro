---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HotelFinder from '../components/HotelFinder.astro';
import ThreeStepStrip from '../components/ThreeStepStrip.astro';
import ExampleChips from '../components/ExampleChips.astro';
import { publisherJsonLd, webApplicationJsonLd, websiteJsonLd } from '../lib/seo';

const allHotels = await getCollection('hotels', ({ data }) => !data.draft);
const bySlug = Object.fromEntries(allHotels.map(h => [h.data.slug, h.data]));

// Full-bleed hero — an illustrated Tuscan villa with an infinity pool and
// flowering terrace overlooking the vineyards and hills at golden hour,
// evoking the affordable-luxury idea at the heart of the site rather than
// any single hotel listing.
const heroImage = {
  large: '/images/hotels/responsive/tuscan-villa-pool-hero-1200.webp',
  small: '/images/hotels/responsive/tuscan-villa-pool-hero-800.webp',
  src: '/images/hotels/tuscan-villa-pool-hero.webp',
  alt: 'Illustrated Tuscan villa with an infinity pool and flowering terrace overlooking vineyards and rolling hills at golden hour',
};

const jsonLd = [websiteJsonLd(), publisherJsonLd(), webApplicationJsonLd()];
---

<BaseLayout
  title="50 Five-Star Hotels — Free Affordable-Luxury Hotel Finder"
  description="Use the Hotel Finder to build a research brief for ChatGPT or Claude and find affordable five-star, near-luxury and unusually good-value hotels for your own trip."
  canonical="/"
  image={heroImage.src}
  jsonLd={jsonLd}
>
  <main>
    <!-- Hero -->
    <section class="relative isolate flex items-center justify-center min-h-[70svh] sm:min-h-[76vh] md:min-h-[82vh] overflow-hidden">
      <!-- Full-bleed background image -->
      <picture class="absolute inset-0 -z-10">
        <source media="(min-width: 768px)" srcset={heroImage.large} type="image/webp" />
        <source media="(max-width: 767px)" srcset={heroImage.small} type="image/webp" />
        <img
          src={heroImage.large}
          alt={heroImage.alt}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="h-full w-full object-cover brightness-[1.02] saturate-[1.04] contrast-[1.02]"
        />
      </picture>
      <!-- Soft light overlay to lift the glass panel off the illustration -->
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-white/30 via-transparent to-transparent"></div>

      <!-- Frosted hero copy panel -->
      <div class="w-full max-w-[1180px] mx-auto px-[clamp(1rem,5vw,4rem)] py-10 sm:py-10 md:py-8">
        <div class="hero-glass max-w-[600px] mr-auto rounded-[1.75rem] px-6 py-8 sm:px-9 sm:py-10 md:px-10 md:py-11 text-center sm:text-left text-[#22281C] shadow-[0_24px_70px_rgba(40,30,12,0.18)] ring-1 ring-white/60">
          <p class="text-[#9A6B2F] text-[0.68rem] sm:text-xs font-bold uppercase tracking-[0.22em] mb-5 flex items-center justify-center sm:justify-start gap-3">
            <span class="inline-block w-7 sm:w-9 h-px bg-[#9A6B2F]/60"></span>
            Dream hotel finder
          </p>
          <h1 class="font-serif text-[2.5rem] sm:text-[3.4rem] md:text-[4rem] font-semibold leading-[0.98] text-[#22281C]">
            Find your dream five-star stay without five-star <span class="text-[#9A6B2F] italic">prices</span>.
          </h1>
          <p class="text-[#22281C]/82 text-base sm:text-lg mt-5 leading-relaxed max-w-[42rem] mx-auto sm:mx-0">
            Use the Hotel Finder to build a practical research prompt for your AI Agent.
          </p>
          <div class="mt-7 flex flex-wrap gap-3 justify-center sm:justify-start">
            <a
              href="/hotel-finder/"
              class="inline-flex items-center justify-center rounded-full bg-[#4F6547] px-6 py-3 text-sm font-semibold text-white shadow-[0_10px_24px_rgba(40,60,40,0.22)] transition-colors hover:bg-[#344532] no-underline"
            >
              Build my hotel shortlist →
            </a>
            <a
              href="/all-hotels/"
              class="inline-flex items-center justify-center rounded-full border border-[#22281C]/20 bg-white/50 px-6 py-3 text-sm font-semibold text-[#22281C] transition-colors hover:bg-white/70 no-underline"
            >
              See example hotels
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <ThreeStepStrip id="how-it-works" />

    <!-- Proof band -->
    <section class="bg-[#FFFDF8] border-b border-[#E2D4BF]">
      <div class="max-w-4xl mx-auto px-5 py-12 md:py-14 text-center sm:text-left">
        <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-3">Built on 50+ hand-scored hotel examples</p>
        <p class="text-[#1F2428]/80 text-lg leading-relaxed max-w-2xl mx-auto sm:mx-0 mb-5">
          The finder is based on the same value logic used across the hotel profiles: price, character, reviews, location, nearby experiences and hidden drawbacks.
        </p>
        <a href="/all-hotels/" class="inline-flex items-center text-[#B88A44] font-semibold hover:underline no-underline">
          Browse example hotels →
        </a>
      </div>
    </section>

    <!-- Hotel finder intro -->
    <section class="bg-[#FFFDF8] border-b border-[#E2D4BF]">
      <div class="max-w-4xl mx-auto px-5 py-14 md:py-16">
        <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">Hotel finder</p>
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-[#1F2428] leading-tight mb-6">
          Find the Right Hotel for Your Trip
        </h2>
        <p class="text-[#6F685F] text-sm leading-relaxed mb-6">
          Follow steps 1–5 below, then copy and paste your results into ChatGPT, Claude or another research-capable AI. Start a fresh session rather than continuing an old one.
        </p>
        <p class="text-[#1F2428] text-base md:text-lg leading-relaxed font-serif italic mb-8">
          The goal is not to find the cheapest hotel. It is to find hotels where the comfort, character, location and experience feel unusually strong for the price.
        </p>
        <ExampleChips />
      </div>
    </section>

    <!-- The finder -->
    <HotelFinder />
  </main>
</BaseLayout>

<style>
  .hero-glass {
    background: rgba(255, 255, 255, 0.78);
    box-shadow:
      0 24px 70px rgba(40, 30, 12, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.72);
  }

  @supports ((backdrop-filter: blur(18px)) or (-webkit-backdrop-filter: blur(18px))) {
    .hero-glass {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0.34));
      -webkit-backdrop-filter: blur(22px) saturate(1.4);
      backdrop-filter: blur(22px) saturate(1.4);
    }
  }

  .hero-glass h1 {
    letter-spacing: 0;
  }

  @media (max-width: 767px) {
    @supports ((backdrop-filter: blur(12px)) or (-webkit-backdrop-filter: blur(12px))) {
      .hero-glass {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.74), rgba(255, 255, 255, 0.5));
        -webkit-backdrop-filter: blur(16px) saturate(1.2);
        backdrop-filter: blur(16px) saturate(1.2);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glass a {
      transition-duration: 0.01ms;
    }
  }
</style>
