---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HotelCard from '../components/HotelCard.astro';
import PriceTierCard from '../components/PriceTierCard.astro';
import HotelComparisonTable from '../components/HotelComparisonTable.astro';
import { itemListJsonLd, publisherJsonLd, websiteJsonLd } from '../lib/seo';

const allHotels = await getCollection('hotels', ({ data }) => !data.draft);
allHotels.sort((a, b) => a.data.rank - b.data.rank);

const bySlug = Object.fromEntries(allHotels.map(h => [h.data.slug, h.data]));

const featuredSlugs = [
  'hotel-suitess-dresden',
  'steigenberger-handelshof-leipzig',
  'hotel-elephant-weimar',
  'mansion-merida-boutique-hotel',
  'cartesiano-puebla',
  'hodelpa-nicolas-de-ovando',
];
const featured = allHotels.filter(h => featuredSlugs.includes(h.data.slug));

// Full-bleed hero — the first image from the Steigenberger Resort Achti Luxor
// hotel page (its AI editorial dusk view), retouched to remove the central
// foreground palm tree. The hotel page itself keeps the original image.
const heroHotel = bySlug['steigenberger-resort-achti-luxor'];
const heroImage = {
  large: '/images/hotels/responsive/steigenberger-resort-achti-luxor-editorial-dusk-no-center-palm-1200.webp',
  small: '/images/hotels/responsive/steigenberger-resort-achti-luxor-editorial-dusk-no-center-palm-800.webp',
  src: '/images/hotels/steigenberger-resort-achti-luxor-editorial-dusk-no-center-palm.webp',
  alt: heroHotel?.image?.alt ?? heroHotel?.title ?? 'Steigenberger Resort Achti, Luxor at dusk',
};

const under50Count = allHotels.filter(h => h.data.budgetTier === 'Under €50').length;
const under100Count = allHotels.filter(h => h.data.budgetTier === 'Under €100').length;
const under200Count = allHotels.filter(h => h.data.budgetTier === 'Under €200').length;
const under250Count = allHotels.filter(h => h.data.budgetTier === 'Under €250').length;

const tableHotels = allHotels.map(h => ({
  slug: h.data.slug,
  rank: h.data.rank,
  title: h.data.title,
  city: h.data.city,
  country: h.data.country,
  budgetTier: h.data.budgetTier,
  valueScore: h.data.valueScore,
  verdict: h.data.verdict,
}));

// "Browse by feeling" — editorial moods, each with a representative image
const feelings = [
  { label: 'Heritage & history', note: 'Old walls, grand staircases and a sense of the past.', slug: 'the-grand-york' },
  { label: 'Spa & slow mornings', note: 'Wellness stays where the days unwind gently.', slug: 'raweekanlaya-bangkok' },
  { label: 'Design & atmosphere', note: 'Hotels with a strong, distinctive sense of place.', slug: 'stamba-hotel-tbilisi' },
  { label: 'City & food', note: 'A great base for culture, restaurants and night energy.', slug: 'municipal-hotel-liverpool' },
  { label: 'Beach & resort', note: 'Sea air, pools and easy holiday comfort.', slug: 'boton-blue-nha-trang' },
  { label: 'Romantic escape', note: 'Special-occasion stays that feel quietly indulgent.', slug: 'sofitel-marrakech' },
].map(f => ({ ...f, hotel: bySlug[f.slug] })).filter(f => f.hotel);

// "Destination mood" — cities with a one-line atmosphere
const moods = [
  { slug: 'the-grand-york', mood: 'Medieval walls, railway-palace comfort' },
  { slug: 'municipal-hotel-liverpool', mood: 'Civic grandeur and waterfront culture' },
  { slug: 'kimpton-blythswood-square', mood: 'Georgian-square Glasgow luxury' },
  { slug: 'hotel-majapahit-surabaya', mood: 'Colonial Java, quietly grand' },
  { slug: 'stamba-hotel-tbilisi', mood: 'Design-led Caucasus cool' },
  { slug: 'sofitel-marrakech', mood: 'Warm light and palace gardens' },
].map(m => ({ ...m, hotel: bySlug[m.slug] })).filter(m => m.hotel);

type HotelData = CollectionEntry<'hotels'>['data'];

// Slug for per-city destination pages (matches src/pages/destinations/[slug].astro)
const citySlug = (city: string) =>
  city.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const heroImg = (h?: HotelData) => h?.image?.srcSet?.large ?? h?.image?.src;
// Brighter "realistic daylight" variant for the feeling/mood tiles
// (the default image is the darker editorial-dusk render).
const dayImg = (h?: HotelData) => {
  const day = h?.generatedGallery?.find((g) => g.type === 'realistic-daylight');
  return day?.srcSet?.large ?? day?.src ?? heroImg(h);
};
const jsonLd = [websiteJsonLd(), publisherJsonLd(), itemListJsonLd('Best affordable five-star hotels worldwide', allHotels)];
---

<BaseLayout
  title="50 Five-Star Hotels Without Five-Star Prices"
  description="Discover affordable five-star and near-five-star hotels around the world, from rare under-€50 snapshot finds to smart luxury splurges under €250."
  canonical="/"
  image={heroImage.src}
  jsonLd={jsonLd}
>
  <main>
    <!-- Hero -->
    <section class="relative isolate flex items-center justify-center min-h-[70svh] sm:min-h-[76vh] md:min-h-[82vh] overflow-hidden">
      <!-- Full-bleed background image -->
      <picture class="absolute inset-0 -z-10">
        <source media="(min-width: 768px)" srcset={heroImage.large} type="image/webp" />
        <source media="(max-width: 767px)" srcset={heroImage.small} type="image/webp" />
        <img
          src={heroImage.large}
          alt={heroImage.alt}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="h-full w-full object-cover brightness-[1.22] saturate-[1.08] contrast-[1.03]"
        />
      </picture>
      <!-- Warm legibility overlay -->
      <div class="absolute inset-0 -z-10 bg-[#1F2428]/10"></div>
      <div class="absolute inset-0 -z-10 bg-gradient-to-b from-[#1F2428]/8 via-transparent to-[#1F2428]/32"></div>

      <!-- Frosted hero copy panel -->
      <div class="w-full max-w-6xl mx-auto px-5 py-10 sm:py-10 md:py-8">
        <div class="hero-glass max-w-[740px] mx-auto lg:mx-0 lg:ml-10 rounded-[1.25rem] px-6 py-7 sm:px-9 sm:py-9 md:px-10 md:py-10 text-center sm:text-left text-white shadow-[0_28px_90px_rgba(0,0,0,0.38)] ring-1 ring-[#D8BD8A]/45">
          <p class="text-[#E8D7B4] text-[0.68rem] sm:text-xs font-bold uppercase tracking-[0.22em] mb-5 flex items-center justify-center sm:justify-start gap-3">
            <span class="inline-block w-7 sm:w-9 h-px bg-[#D8BD8A]"></span>
            Affordable luxury travel
          </p>
          <h1 class="font-serif text-[3rem] sm:text-[4.2rem] md:text-[5rem] font-semibold leading-[0.94] [text-shadow:0_2px_28px_rgba(0,0,0,0.55)]">
            Five-star hotels without five-star <span class="text-[#E8C988] italic">prices.</span>
          </h1>
          <p class="text-white/88 text-base sm:text-lg md:text-xl mt-5 leading-relaxed max-w-[39rem] mx-auto sm:mx-0">
            A warm, honest guide to hotels where the price feels surprisingly modest for the setting, service, history or sense of occasion.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center sm:justify-start mt-7">
            <a href="#featured" class="inline-flex items-center justify-center bg-[#B88A44] text-white font-semibold py-3.5 px-7 rounded-full hover:bg-white hover:text-[#1F2428] transition-colors no-underline text-sm">
              Explore the best-value hotels
            </a>
            <a href="/under-100" class="inline-flex items-center justify-center bg-white/10 text-white font-semibold py-3.5 px-7 rounded-full border border-white/45 hover:bg-white hover:text-[#1F2428] transition-colors no-underline text-sm">
              See hotels under €100
            </a>
          </div>
          <p class="text-white/72 text-xs mt-5 leading-relaxed max-w-md mx-auto sm:mx-0">
            Prices change constantly. Every hotel here should be checked by date, room type, taxes and cancellation policy before booking.
          </p>
        </div>
      </div>
    </section>

    <!-- Editorial intro -->
    <section class="bg-[#FFFDF8] border-y border-[#E2D4BF]">
      <div class="max-w-4xl mx-auto px-5 py-16 md:py-20">
        <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-5">The idea</p>
        <p class="text-[#1F2428]/80 text-lg md:text-xl leading-relaxed mb-5 font-serif italic">
          Luxury is not priced evenly around the world. In some cities, a five-star or near-five-star hotel can cost less than a mid-range room elsewhere.
        </p>
        <p class="text-[#6F685F] text-base md:text-lg leading-relaxed mb-5">
          The trick is knowing which hotels are genuinely worth considering — and which are simply cheap because the standard, location or maintenance is weaker than the star rating suggests.
        </p>
        <p class="text-[#6F685F] text-base md:text-lg leading-relaxed">
          50 Five-Star Hotels focuses on the places where price, setting and experience come together: heritage hotels in Germany, Mexico and Santo Domingo, spa hotels in underrated European cities, Nile-side resorts in Luxor, design hotels in the Caucasus and city hotels that make an affordable trip feel far more special.
        </p>
      </div>
    </section>

    <!-- Editorial caution -->
    <section class="bg-[#F4EADC] border-b border-[#E2D4BF]">
      <div class="max-w-4xl mx-auto px-5 py-7">
        <p class="text-[#1F2428]/75 text-sm leading-relaxed">
          <strong class="text-[#1F2428]">A note on five-star labels:</strong> A five-star designation does not always mean international luxury. Some hotels here are true five-star properties; others are local or booking-site five-star hotels that are still interesting because the value is unusually strong. Each profile explains the difference clearly.
        </p>
      </div>
    </section>

    <!-- Price tier cards -->
    <section class="max-w-6xl mx-auto px-5 py-20">
      <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">Browse by price</p>
      <h2 class="font-serif text-3xl md:text-4xl font-semibold text-[#1F2428] mb-10">Find hotels by budget</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <PriceTierCard
          tier="Under €50"
          href="/under-50"
          tagline="Rare snapshot finds"
          description="The most aggressive value leads: five-star or near-five-star hotels that can appear at €50 or below, with extra caution required."
          count={under50Count}
        />
        <PriceTierCard
          tier="Under €100"
          href="/under-100"
          tagline="Exceptional budget luxury"
          description="The hotels that make travellers look twice. Five-star or near-five-star stays that can often appear below €100 outside peak dates."
          count={under100Count}
        />
        <PriceTierCard
          tier="Under €200"
          href="/under-200"
          tagline="Affordable indulgence"
          description="Better locations, stronger brands and more reliable comfort. The largest and most diverse tier in the collection."
          count={under200Count}
        />
        <PriceTierCard
          tier="Under €250"
          href="/under-250"
          tagline="Smart splurge"
          description="Special hotels that still feel restrained compared with normal luxury prices. The best for design and setting."
          count={under250Count}
        />
      </div>
    </section>

    <!-- Browse by feeling -->
    <section class="section-fade-sand border-y border-[#E2D4BF]">
      <div class="max-w-6xl mx-auto px-5 py-20">
        <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">Browse by feeling</p>
        <h2 class="font-serif text-3xl md:text-4xl font-semibold text-[#1F2428] mb-3">What kind of stay are you after?</h2>
        <p class="text-[#6F685F] text-lg mb-10 max-w-2xl">Sometimes you know the mood before the map. Start from how you want the trip to feel.</p>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-5">
          {feelings.map(f => (
            <a href="/destinations" class="group relative block aspect-[4/5] sm:aspect-[5/6] rounded-2xl overflow-hidden no-underline shadow-sm ring-1 ring-[#1F2428]/5">
              <img src={dayImg(f.hotel)} alt={`${f.label} — ${f.hotel.city}`} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="editorial-overlay absolute inset-0"></div>
              <div class="absolute inset-0 p-4 md:p-5 flex flex-col justify-end text-white">
                <h3 class="font-serif text-lg md:text-xl font-semibold leading-tight">{f.label}</h3>
                <p class="text-white/80 text-xs md:text-sm mt-1 leading-snug">{f.note}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Featured hotels -->
    <section id="featured" class="bg-[#F8F2E8] py-20">
      <div class="max-w-6xl mx-auto px-5">
        <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">Start here</p>
        <h2 class="font-serif text-3xl md:text-4xl font-semibold text-[#1F2428] mb-4">Hotels that prove the idea</h2>
        <p class="text-[#6F685F] text-lg mb-10 max-w-2xl">Six hotels from the collection — chosen because each one makes the case for affordable luxury in a different way.</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-7">
          {featured.map(h => (
            <HotelCard hotel={h.data} featured={true} />
          ))}
        </div>
      </div>
    </section>

    <!-- Destination mood -->
    <section class="bg-[#FFFDF8] border-y border-[#E2D4BF] py-20">
      <div class="max-w-6xl mx-auto px-5">
        <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">Destination mood</p>
        <h2 class="font-serif text-3xl md:text-4xl font-semibold text-[#1F2428] mb-3">Places worth the trip</h2>
        <p class="text-[#6F685F] text-lg mb-10 max-w-2xl">A good hotel is only half the story. These are cities where the value and the place both pull their weight.</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
          {moods.map(m => (
            <a href={`/destinations/${citySlug(m.hotel.city)}/`} class="group block no-underline">
              <div class="relative aspect-[3/2] rounded-2xl overflow-hidden shadow-sm ring-1 ring-[#1F2428]/5">
                <img src={dayImg(m.hotel)} alt={`${m.hotel.city}, ${m.hotel.country}`} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                <div class="editorial-overlay absolute inset-0"></div>
                <div class="absolute bottom-0 left-0 right-0 p-4 text-white">
                  <p class="font-serif text-xl font-semibold leading-tight">{m.hotel.city}</p>
                  <p class="text-white/75 text-xs">{m.hotel.country}</p>
                </div>
              </div>
              <p class="text-[#6F685F] text-sm mt-3 italic group-hover:text-[#B88A44] transition-colors">{m.mood}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Comparison table -->
    <section class="max-w-6xl mx-auto px-5 py-20">
      <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">The full list</p>
      <h2 class="font-serif text-3xl md:text-4xl font-semibold text-[#1F2428] mb-4">All {allHotels.length} hotels at a glance</h2>
      <p class="text-[#6F685F] text-lg mb-10 max-w-2xl">Ranked by value score. Click any hotel for the full editorial profile.</p>
      <HotelComparisonTable hotels={tableHotels} title="" />
      <div class="mt-8 text-center">
        <a href="/destinations" class="inline-flex items-center text-[#B88A44] font-semibold hover:underline no-underline">
          Browse all hotels by destination →
        </a>
      </div>
    </section>

    <!-- How we choose -->
    <section class="bg-[#FFFDF8] border-y border-[#E2D4BF] py-20">
      <div class="max-w-4xl mx-auto px-5">
        <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">Our method</p>
        <h2 class="font-serif text-3xl font-semibold text-[#1F2428] mb-8">How we choose hotels</h2>
        <div class="grid md:grid-cols-3 gap-8">
          {[
            { factor: 'Price and value', desc: 'How does the rate compare to the local five-star market? What does the money actually buy?' },
            { factor: 'Hotel character', desc: 'Is this a hotel with a genuine sense of place, or a generic box with a star rating?' },
            { factor: 'Location and destination', desc: 'Is the city or destination interesting enough to justify the trip? What is there to do nearby?' },
          ].map(item => (
            <div>
              <h3 class="font-serif text-lg font-semibold text-[#1F2428] mb-2">{item.factor}</h3>
              <p class="text-[#6F685F] text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
        <div class="mt-8">
          <a href="/research-hotels/#methodology" class="text-[#B88A44] font-semibold hover:underline no-underline text-sm">
            Read the full methodology →
          </a>
        </div>
      </div>
    </section>

    <!-- Research prompt promo -->
    <section class="bg-[#F4EADC] border-b border-[#E2D4BF]">
      <div class="max-w-4xl mx-auto px-5 py-16 text-center">
        <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">Hotel Finder</p>
        <h2 class="font-serif text-3xl md:text-4xl font-semibold text-[#1F2428] mb-4">Planning your own trip?</h2>
        <p class="text-[#6F685F] text-lg mb-8 max-w-xl mx-auto">
          Build a practical shortlist for your destination, budget and travel style. The finder checks value, location, recent reviews, nearby things to do and likely compromises before you book.
        </p>
        <a href="/research-hotels/" class="inline-flex items-center bg-[#B88A44] text-white font-semibold py-3.5 px-8 rounded-full hover:bg-[#1F2428] transition-colors no-underline text-sm">
          Find hotels for my trip →
        </a>
      </div>
    </section>

    <!-- Footer CTA -->
    <section class="max-w-6xl mx-auto px-5 py-20 text-center">
      <h2 class="font-serif text-3xl md:text-4xl font-semibold text-[#1F2428] mb-4">
        Find the hotel where the price feels mispriced.
      </h2>
      <p class="text-[#6F685F] text-lg mb-8 max-w-xl mx-auto">
        {allHotels.length} hotels across the Americas, South Asia, Southeast Asia, Europe, the Middle East and the Caucasus — each one chosen because the value case is genuinely interesting.
      </p>
      <a href="/destinations" class="inline-flex items-center bg-[#1F2428] text-white font-semibold py-4 px-8 rounded-full hover:bg-[#B88A44] transition-colors no-underline">
        Browse all {allHotels.length} hotels
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  .hero-glass {
    background: rgba(20, 23, 26, 0.78);
  }

  @supports ((backdrop-filter: blur(18px)) or (-webkit-backdrop-filter: blur(18px))) {
    .hero-glass {
      background: linear-gradient(135deg, rgba(31, 36, 40, 0.7), rgba(13, 16, 18, 0.54));
      -webkit-backdrop-filter: blur(18px) saturate(1.18);
      backdrop-filter: blur(18px) saturate(1.18);
    }
  }

  .hero-glass h1 {
    letter-spacing: 0;
  }

  @media (max-width: 767px) {
    @supports ((backdrop-filter: blur(12px)) or (-webkit-backdrop-filter: blur(12px))) {
      .hero-glass {
        -webkit-backdrop-filter: blur(12px) saturate(1.1);
        backdrop-filter: blur(12px) saturate(1.1);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glass a {
      transition-duration: 0.01ms;
    }
  }
</style>
