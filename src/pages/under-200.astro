---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HotelCard from '../components/HotelCard.astro';
import HotelComparisonTable from '../components/HotelComparisonTable.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import FinderCta from '../components/FinderCta.astro';
import { breadcrumbJsonLd, canonicalUrl, itemListJsonLd, webPageJsonLd } from '../lib/seo';

const all = await getCollection('hotels', ({ data }) => !data.draft);
const hotels = all.filter(h => h.data.budgetTier === 'Under €200').sort((a, b) => a.data.rank - b.data.rank);

const tableHotels = hotels.map(h => ({
  slug: h.data.slug,
  rank: h.data.rank,
  title: h.data.title,
  city: h.data.city,
  budgetTier: h.data.budgetTier,
  valueScore: h.data.valueScore,
  verdict: h.data.verdict,
}));

const title = 'Best Five-Star Hotels Under €200 | 50 Five-Star Hotels';
const description = 'Explore strong-value five-star hotels under €200, including heritage hotels, spa hotels, city hotels and destination stays.';
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: canonicalUrl('/') },
    { name: 'Five-Star Hotels Under €200', url: canonicalUrl('/under-200/') },
  ]),
  webPageJsonLd({ title, description, path: '/under-200/', type: 'CollectionPage' }),
  itemListJsonLd('Five-star and near-five-star hotels under €200', hotels),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="/under-200/"
  jsonLd={jsonLd}
>
  <main>
    <!-- Hero -->
    <section class="bg-[#FBF6E9] border-b border-[#2A2622]/6">
      <div class="max-w-4xl mx-auto px-5 py-16">
        <p class="text-[#A0682E] text-xs font-bold uppercase tracking-widest mb-4">Budget tier</p>
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-[#2A2622] leading-tight mb-6">
          Under €200: More reliable luxury-value examples under €200
        </h1>
        <p class="text-[#5C544A] text-lg leading-relaxed max-w-2xl">
          The under-€200 tier is where affordable luxury becomes more reliable. These examples often offer stronger locations, better facilities or more recognisable brands while still costing far less than comparable stays in expensive markets.
        </p>
        <p class="text-[#5C544A] text-sm leading-relaxed max-w-2xl mt-4">
          These are examples, not live guarantees. Hotel prices change constantly by date, room type, taxes, cancellation policy and local demand. Use the Hotel Finder to research your own destination and verify live rates before booking.
        </p>
        <p class="text-[#5C544A] text-xs mt-5">
          {hotels.length} hotel examples in this tier. Prices vary by date, room type, taxes and cancellation policy.
        </p>
        <div class="mt-8 max-w-3xl">
          <FinderCta compact={true} />
        </div>
      </div>
    </section>

    <!-- Caution block -->
    <section class="bg-[#2A2622]/4 border-b border-[#2A2622]/6">
      <div class="max-w-4xl mx-auto px-5 py-6">
        <p class="text-[#2A2622]/70 text-sm leading-relaxed">
          <strong class="text-[#2A2622]">Price note:</strong> Rates in this tier reflect typical pricing outside peak seasons and major holidays. Always check actual availability by specific date, room type and cancellation policy before making decisions.
        </p>
      </div>
    </section>

    <!-- Hotel grid -->
    <section class="max-w-6xl mx-auto px-5 py-16">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {hotels.map(h => <HotelCard hotel={h.data} />)}
      </div>
    </section>

    <!-- Comparison table -->
    <section class="max-w-6xl mx-auto px-5 pb-16">
      <HotelComparisonTable hotels={tableHotels} title="Under €200 hotels at a glance" />
    </section>

    <section class="max-w-4xl mx-auto px-5 pb-10">
      <FinderCta
        title="Apply this to your own destination"
        text="Use the Hotel Finder to build a research brief for reliable luxury value wherever you are heading."
      />
    </section>

    <section class="max-w-4xl mx-auto px-5 pb-16">
      <AffiliateDisclosure />
    </section>

    <section class="bg-[#FFFDF6] border-t border-[#2A2622]/6 py-12">
      <div class="max-w-4xl mx-auto px-5 flex flex-wrap gap-6 items-center justify-between">
        <p class="text-[#5C544A] text-sm">How are these hotels evaluated?</p>
        <a href="/hotel-finder/#methodology" class="text-[#A0682E] font-semibold text-sm hover:underline no-underline">
          Read the full methodology →
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
