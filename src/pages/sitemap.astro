---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { breadcrumbJsonLd, canonicalUrl } from '../lib/seo';

const hotels = (await getCollection('hotels', ({ data }) => !data.draft)).sort((a, b) => a.data.rank - b.data.rank);
const sections = [
  { title: 'Main pages', links: [
    ['Home', '/'], ['Hotel Finder', '/hotel-finder/'], ['Examples', '/all-hotels/'], ['About', '/about/'],
  ] },
  { title: 'Price guides', links: [
    ['Five-Star Hotels Under €50', '/under-50/'],
    ['Best Five-Star Hotels Under €100 Worldwide', '/under-100/'],
    ['Best Five-Star Hotels Under €200 Worldwide', '/under-200/'],
    ['Best Five-Star Hotels Under €250 Worldwide', '/under-250/'],
    ['Cheap Five-Star Hotels', '/cheap-five-star-hotels/'],
    ['Affordable Luxury Hotels', '/affordable-luxury-hotels/'],
    ['Luxury Hotels on a Budget', '/luxury-hotels-on-a-budget/'],
  ] },
  { title: 'Regional guides', links: [
    ['Affordable Five-Star Hotels in Asia', '/affordable-five-star-hotels-asia/'],
    ['Affordable Five-Star Hotels in Europe', '/affordable-five-star-hotels-europe/'],
    ['Asia Region Guide', '/regions/asia/'],
    ['Europe Region Guide', '/regions/europe/'],
    ['Americas Region Guide', '/regions/americas/'],
    ['Middle East and North Africa Region Guide', '/regions/middle-east-north-africa/'],
    ['Caucasus and Central Asia Region Guide', '/regions/caucasus-central-asia/'],
  ] },
  { title: 'Hotel profiles', links: hotels.map((h) => [h.data.title, `/hotels/${h.data.slug}/`]) },
  { title: 'Hotel finder, disclosure and credits', links: [
    ['How We Choose Hotels', '/hotel-finder/#methodology'],
    ['Affiliate Disclosure', '/affiliate-disclosure/'],
    ['Image Credits', '/image-credits/'],
  ] },
  { title: 'Supporting guides', links: [
    ['When Are Five-Star Hotels Cheapest?', '/guides/when-are-five-star-hotels-cheapest/'],
    ['Five-Star Hotel Ratings Explained', '/guides/five-star-hotel-ratings-explained/'],
    ['Best Heritage Hotels Under €200', '/guides/heritage-hotels-under-200/'],
    ['Why Business Hotels Can Be Great Luxury-Value Stays', '/guides/business-hotels-luxury-value/'],
    ['How to Check if a Five-Star Hotel Is Really Worth It', '/guides/how-to-check-if-a-five-star-hotel-is-worth-it/'],
    ['How to Read Recent Hotel Reviews Before Booking', '/guides/how-to-read-recent-hotel-reviews/'],
    ['Why Are Some Five-Star Hotels So Cheap?', '/guides/why-some-five-star-hotels-are-so-cheap/'],
    ['Best Booking.com Filters for Finding Affordable Luxury Hotels', '/guides/best-booking-com-filters-affordable-luxury/'],
    ['Hotel Red Flags: When Cheap Five-Star Is Not Good Value', '/guides/hotel-red-flags-cheap-five-star/'],
  ] },
];
---

<PageLayout
  title="Sitemap | 50 Five-Star Hotels"
  description="A user-facing sitemap for 50 Five-Star Hotels, including price guides, destination guides, hotel profiles, research tools, disclosure, and supporting guides."
  canonical="/sitemap/"
  jsonLd={breadcrumbJsonLd([{ name: 'Home', url: canonicalUrl('/') }, { name: 'Sitemap', url: canonicalUrl('/sitemap/') }])}
  maxWidth="max-w-6xl"
>
  <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">Sitemap</p>
  <h1 class="font-serif text-4xl md:text-5xl font-bold text-[#1F2428] leading-tight mb-8">Sitemap</h1>
  <div class="grid md:grid-cols-2 gap-8">
    {sections.map((section) => (
      <section class="rounded-xl border border-[#E2D4BF] bg-[#FFFDF8] p-6">
        <h2 class="font-serif text-2xl font-semibold text-[#1F2428] mb-4">{section.title}</h2>
        <ul class="space-y-2">
          {section.links.map(([label, href]) => (
            <li><a href={href} class="text-[#B88A44] no-underline hover:underline">{label}</a></li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</PageLayout>
