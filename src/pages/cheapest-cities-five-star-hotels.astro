---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import HotelComparisonTable from '../components/HotelComparisonTable.astro';
import LastUpdated from '../components/LastUpdated.astro';
import PriceAccuracyNote from '../components/PriceAccuracyNote.astro';
import { breadcrumbJsonLd, canonicalUrl, itemListJsonLd } from '../lib/seo';

const all = await getCollection('hotels', ({ data }) => !data.draft);
const cityNotes = {
  'Kuala Lumpur': ['Malaysia', 'A deep luxury-hotel market and strong regional competition keep grand hotels comparatively accessible.', 'Under €200', 'Outside major events and school holidays', 'Popular weekends can still lift rates.'],
  Bangkok: ['Thailand', 'Huge hotel supply makes even characterful wellness stays compete hard outside peak travel windows.', 'Under €200', 'Shoulder months and midweek stays', 'Location matters in traffic-heavy Bangkok.'],
  Surabaya: ['Indonesia', 'Business-city demand and lower local costs make heritage hotels surprisingly affordable.', 'Under €100', 'Outside Indonesian holiday peaks', 'The city is more rewarding for curious travellers than resort seekers.'],
  Yogyakarta: ['Indonesia', 'Strong local competition and a cultural-travel market support good heritage-hotel pricing.', 'Under €100', 'Between major holidays', 'Temple-trip periods and domestic holidays can spike prices.'],
  Solo: ['Indonesia', 'Solo is underrated beside Yogyakarta, so heritage-value hotels can price gently.', 'Under €100', 'Weekdays and shoulder months', 'Expect local heritage character rather than glossy luxury.'],
  'Siem Reap': ['Cambodia', 'Hotel supply built for Angkor tourism keeps boutique comfort accessible when demand softens.', 'Under €100', 'Outside the busiest temple months', 'Check location and transport to Angkor carefully.'],
  Luxor: ['Egypt', 'Nile-side resort hotels can be far cheaper than their setting suggests.', 'Under €200', 'Warm shoulder months', 'Heat and tour logistics shape the trip.'],
  Hue: ['Vietnam', 'Vietnam’s imperial city offers high cultural value with modest hotel costs.', 'Under €100', 'Outside local holiday peaks', 'Weather can be humid or rainy by season.'],
  'Nha Trang': ['Vietnam', 'Coastal hotel supply and local competition can make spa hotels affordable.', 'Under €100', 'Non-holiday beach periods', 'Beach location and room views vary.'],
  Tbilisi: ['Georgia', 'Design-led hotels can still undercut equivalent European-city pricing.', 'Under €250', 'Spring and autumn checks', 'The best design hotels may not be cheap on peak weekends.'],
  Yerevan: ['Armenia', 'Classic central hotels can offer strong value by Caucasus standards.', 'Under €200', 'Shoulder seasons', 'Some five-star labels are more local than international.'],
  Tashkent: ['Uzbekistan', 'Business-hotel comfort benefits from Central Asia’s excellent price-value balance.', 'Under €200', 'Weekends and non-event dates', 'Corporate demand can move rates quickly.'],
  'Iași': ['Romania', 'An underrated Romanian city where boutique spa hotels can price far below better-known capitals.', 'Under €200', 'Outside university and event peaks', 'Location may be less central than expected.'],
  Sarajevo: ['Bosnia and Herzegovina', 'The Balkans can offer five-star labels at accessible rates in historically rich cities.', 'Under €200', 'Shoulder months', 'Check exact location against old-town plans.'],
  Varna: ['Bulgaria', 'Black Sea cities have strong seasonal swings and off-peak hotel value.', 'Under €200', 'Outside high summer', 'Summer can reprice quickly.'],
  'Abu Dhabi': ['United Arab Emirates', 'Business demand and hotel supply can create occasional five-star bargains.', 'Under €200', 'Low-demand weekends and hot months', 'Taxes, location, and transport costs matter.'],
  Marrakech: ['Morocco', 'Luxury resort supply can produce smart splurges outside peak demand.', 'Under €250', 'Outside peak winter and holidays', 'Prices move sharply for the best dates.'],
};
const cityRows = Object.entries(cityNotes).map(([city, values]) => {
  const hotel = all.find((h) => h.data.city === city);
  return { city, country: values[0], why: values[1], tier: values[2], when: values[3], caution: values[4], hotel };
});
const hotels = cityRows.map((row) => row.hotel).filter(Boolean);
const tableHotels = hotels.map((h) => ({
  slug: h.data.slug,
  rank: h.data.rank,
  title: h.data.title,
  city: h.data.city,
  country: h.data.country,
  budgetTier: h.data.budgetTier,
  valueScore: h.data.valueScore,
  verdict: h.data.verdict,
  fiveStarStatus: h.data.fiveStarStatus,
  bestFor: h.data.bestFor,
  cautions: h.data.cautions,
}));
const jsonLd = [
  breadcrumbJsonLd([{ name: 'Home', url: canonicalUrl('/') }, { name: 'Cheapest Cities for Five-Star Hotels', url: canonicalUrl('/cheapest-cities-five-star-hotels/') }]),
  itemListJsonLd('Cheapest cities for five-star hotels', hotels),
];
---

<BaseLayout
  title="Cheapest Cities for Five-Star Hotels"
  description="A practical guide to the cheapest cities for five-star hotels, with best-value hotel picks, likely budget tiers, timing tips, and cautions."
  canonical="/cheapest-cities-five-star-hotels/"
  jsonLd={jsonLd}
>
  <main>
    <section class="bg-[#F8F2E8] border-b border-[#1F2428]/6">
      <div class="max-w-4xl mx-auto px-5 py-16">
        <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">Destination value</p>
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-[#1F2428] leading-tight mb-6">Cheapest Cities for Five-Star Hotels</h1>
        <p class="text-[#6F685F] text-lg leading-relaxed">The cheapest cities for five-star hotels are not simply the cheapest places to sleep. They are cities where comfort, hotel supply, local costs, and destination interest combine into unusually strong luxury-to-price ratios.</p>
        <div class="mt-6 flex flex-col gap-3"><LastUpdated date="2026-05-31" /><PriceAccuracyNote /></div>
      </div>
    </section>

    <section class="max-w-4xl mx-auto px-5 py-14 prose prose-lg prose-headings:font-serif prose-headings:text-[#1F2428] prose-p:text-[#1F2428]/75 prose-p:leading-relaxed">
      <h2>How to read this list</h2>
      <p>A city can be strong value for different reasons: a large business-hotel market, lower local operating costs, seasonal resort demand, or a reputation that has not yet caught up with the quality of the hotels. The right question is not only whether a city is cheap, but whether it makes a trip feel richer than the rate suggests.</p>
      <p>Each city below includes the strongest current hotel from this site, a likely budget tier, the best time to check rates, and the main caution before booking.</p>
    </section>

    <section class="max-w-6xl mx-auto px-5 pb-16">
      <div class="grid md:grid-cols-2 gap-5">
        {cityRows.map((row) => (
          <article class="rounded-xl border border-[#E2D4BF] bg-[#FFFDF8] p-5">
            <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest">{row.country}</p>
            <h2 class="font-serif text-2xl font-semibold text-[#1F2428] mt-1">{row.city}</h2>
            <p class="text-sm text-[#6F685F] leading-relaxed mt-3">{row.why}</p>
            <dl class="mt-4 grid gap-3 text-sm">
              <div><dt class="font-semibold text-[#1F2428]">Best hotel from the current site</dt><dd>{row.hotel ? <a href={`/hotels/${row.hotel.data.slug}/`} class="text-[#B88A44] no-underline hover:underline">{row.hotel.data.title}</a> : 'Planned for future expansion'}</dd></div>
              <div><dt class="font-semibold text-[#1F2428]">Likely budget tier</dt><dd class="text-[#6F685F]">{row.tier}</dd></div>
              <div><dt class="font-semibold text-[#1F2428]">Best time to check rates</dt><dd class="text-[#6F685F]">{row.when}</dd></div>
              <div><dt class="font-semibold text-[#1F2428]">Main caution</dt><dd class="text-[#6F685F]">{row.caution}</dd></div>
            </dl>
          </article>
        ))}
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-5 pb-16">
      <HotelComparisonTable hotels={tableHotels} title="Best-value hotel examples by city" />
    </section>

    <section class="max-w-4xl mx-auto px-5 pb-16">
      <RelatedGuides items={[
        { title: 'Cheap Five-Star Hotels', href: '/cheap-five-star-hotels/' },
        { title: 'Affordable Luxury Hotels', href: '/affordable-luxury-hotels/' },
        { title: 'Affordable Five-Star Hotels in Asia', href: '/affordable-five-star-hotels-asia/' },
        { title: 'Affordable Five-Star Hotels in Europe', href: '/affordable-five-star-hotels-europe/' },
      ]} />
    </section>
  </main>
</BaseLayout>
