---
import BaseLayout from '../layouts/BaseLayout.astro';
import DreamRouteRibbon from '../components/DreamRouteRibbon.astro';
import WhenToGoTool from '../components/WhenToGoTool.astro';
import { breadcrumbJsonLd, canonicalUrl, publisherJsonLd, websiteJsonLd } from '../lib/seo';

const jsonLd = [
  websiteJsonLd(),
  publisherJsonLd(),
  breadcrumbJsonLd([
    { name: 'Home', url: canonicalUrl('/') },
    { name: 'Best Time to Go', url: canonicalUrl('/best-time-to-go/') },
  ]),
];

const steps = [
  'Destination',
  'Months',
  'Priorities',
  'Risks',
  'Copy prompt',
];
---

<BaseLayout
  title="Best Time to Go Prompt for Hotel Value by Month | 50 Five-Star Hotels"
  description="Build a ChatGPT or Claude timing prompt that compares hotel value, weather, crowds, air quality and practical risks month by month."
  canonical="/best-time-to-go/"
  jsonLd={jsonLd}
>
  <main class="toolkit-shell">
    <section class="spark-hero px-5 py-14 md:py-18">
      <DreamRouteRibbon variant="page" />
      <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-[minmax(0,1fr)_18rem] md:items-center">
        <div>
          <span class="toolkit-badge">Best Time to Go</span>
          <h1 class="mt-5 text-4xl font-semibold leading-tight text-[#2A2622] md:text-5xl">
            Find the month that makes your trip work
          </h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-[#5C544A]">
            Build a timing prompt that asks your AI to compare hotel value, weather, crowds, air quality and practical travel risks.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#best-time-tool" class="toolkit-button toolkit-button-green">
              Build my timing prompt
              <span aria-hidden="true">-&gt;</span>
            </a>
            <a href="/hotel-finder/" class="toolkit-button toolkit-button-secondary">
              Start hotel hunt
            </a>
          </div>
          <ol class="toolkit-progress mt-8" aria-label="Best Time to Go steps">
            {steps.map((step, index) => (
              <li><span>{index + 1}</span>{step}</li>
            ))}
          </ol>
        </div>
        <aside class="spark-brief hidden p-5 md:block" aria-label="Timing brief preview">
          <p class="text-xs font-black uppercase tracking-[0.08em] text-[#5C7355]">Value + comfort</p>
          <div class="mt-4 grid grid-cols-3 gap-2" aria-hidden="true">
            <span class="rounded-lg bg-white px-2 py-3 text-center text-xs font-black text-[#A0682E] shadow-[2px_2px_0_rgba(42, 38, 34,0.07)]">Mar</span>
            <span class="rounded-lg bg-[#E6EBDD] px-2 py-3 text-center text-xs font-black text-[#5C7355] shadow-[2px_2px_0_rgba(42, 38, 34,0.07)]">Apr</span>
            <span class="rounded-lg bg-white px-2 py-3 text-center text-xs font-black text-[#A0682E] shadow-[2px_2px_0_rgba(42, 38, 34,0.07)]">May</span>
          </div>
          <p class="mt-4 text-sm leading-6 text-[#5C544A]">
            A timing brief weighs hotel value, crowds, weather and travel risk before dates get locked in.
          </p>
        </aside>
      </div>
    </section>

    <section id="best-time-tool" class="max-w-4xl mx-auto px-5 py-10">
      <WhenToGoTool />
    </section>

    <section class="max-w-4xl mx-auto px-5 pb-16">
      <div class="toolkit-card p-6 md:p-7">
        <h2 class="font-serif text-2xl font-semibold text-[#2A2622] mb-3">
          Know when, but not where to stay?
        </h2>
        <p class="text-[#5C544A] leading-relaxed">
          Use the <a href="/hotel-finder/" class="text-[#A0682E] font-semibold hover:underline">Hotel Finder</a> to build a full research brief and compare affordable five-star and near-luxury hotels by value, location, recent reviews and likely compromises.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
