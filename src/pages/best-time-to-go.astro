---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhenToGoTool from '../components/WhenToGoTool.astro';
import { breadcrumbJsonLd, canonicalUrl, publisherJsonLd, websiteJsonLd } from '../lib/seo';

const jsonLd = [
  websiteJsonLd(),
  publisherJsonLd(),
  breadcrumbJsonLd([
    { name: 'Home', url: canonicalUrl('/') },
    { name: 'Best Time to Go', url: canonicalUrl('/best-time-to-go/') },
  ]),
];

const steps = [
  'Destination',
  'Months',
  'Priorities',
  'Risks',
  'Copy prompt',
];
---

<BaseLayout
  title="Best Time to Go Prompt for Hotel Value by Month | 50 Five-Star Hotels"
  description="Build a ChatGPT or Claude timing prompt that compares hotel value, weather, crowds, air quality and practical risks month by month."
  canonical="/best-time-to-go/"
  jsonLd={jsonLd}
>
  <main class="toolkit-shell">
    <section class="px-5 py-14 md:py-18">
      <div class="mx-auto max-w-4xl">
        <span class="toolkit-badge">Best Time to Go</span>
        <h1 class="mt-5 text-4xl font-semibold leading-tight text-[#1D2433] md:text-5xl">
          Find the best month for your trip
        </h1>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-[#324052]">
          Build a timing prompt that asks your AI to compare hotel value, weather, crowds, air quality and practical travel risks month by month.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#best-time-tool" class="toolkit-button toolkit-button-green">
            Build my timing prompt
            <span aria-hidden="true">-&gt;</span>
          </a>
          <a href="/hotel-finder/" class="toolkit-button toolkit-button-secondary">
            Start hotel hunt
          </a>
        </div>
        <ol class="toolkit-progress mt-8" aria-label="Best Time to Go steps">
          {steps.map((step, index) => (
            <li><span>{index + 1}</span>{step}</li>
          ))}
        </ol>
      </div>
    </section>

    <section id="best-time-tool" class="max-w-4xl mx-auto px-5 py-10">
      <WhenToGoTool />
    </section>

    <section class="max-w-4xl mx-auto px-5 pb-16">
      <div class="toolkit-card p-6 md:p-7">
        <h2 class="font-serif text-2xl font-semibold text-[#1D2433] mb-3">
          Know when, but not where to stay?
        </h2>
        <p class="text-[#324052] leading-relaxed">
          Use the <a href="/hotel-finder/" class="text-[#B88A44] font-semibold hover:underline">Hotel Finder</a> to build a full research brief and compare affordable five-star and near-luxury hotels by value, location, recent reviews and likely compromises.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
