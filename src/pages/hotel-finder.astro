---
import BaseLayout from '../layouts/BaseLayout.astro';
import DreamRouteRibbon from '../components/DreamRouteRibbon.astro';
import HotelFinder from '../components/HotelFinder.astro';
import MethodologyContent from '../components/MethodologyContent.astro';
import { breadcrumbJsonLd, canonicalUrl, publisherJsonLd, webApplicationJsonLd, websiteJsonLd } from '../lib/seo';

const jsonLd = [
  websiteJsonLd(),
  publisherJsonLd(),
  webApplicationJsonLd(),
  breadcrumbJsonLd([
    { name: 'Home', url: canonicalUrl('/') },
    { name: 'Hotel Finder', url: canonicalUrl('/hotel-finder/') },
  ]),
];

const steps = [
  'Destination',
  'Budget test',
  'Travel style',
  'Prompt style',
  'Copy prompt',
];
---

<BaseLayout
  title="AI Hotel Finder Prompt for Affordable Luxury Hotels | 50 Five-Star Hotels"
  description="Build a ChatGPT hotel prompt or Claude hotel prompt for affordable luxury hotels, best-value hotels and five-star hotels without five-star prices."
  canonical="/hotel-finder/"
  jsonLd={jsonLd}
>
  <main class="toolkit-shell">
    <section class="spark-hero px-5 py-14 md:py-18">
      <DreamRouteRibbon variant="page" />
      <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-[minmax(0,1fr)_18rem] md:items-center">
        <div>
          <span class="toolkit-badge">Hotel Finder</span>
          <h1 class="mt-5 text-4xl font-semibold leading-tight text-[#2A2622] md:text-5xl">
            Build your dream hotel search
          </h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-[#5C544A]">
            Answer a few simple questions and create a hotel-finding prompt for ChatGPT, Claude or your preferred AI. The goal is to find unusually good-value luxury stays - and the trade-offs to check before booking.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#hotel-finder" class="toolkit-button toolkit-button-gold">
              Build my hotel prompt
              <span aria-hidden="true">-&gt;</span>
            </a>
            <a href="/best-time-to-go/" class="toolkit-button toolkit-button-secondary">
              Find my best month
            </a>
          </div>
          <ol class="toolkit-progress mt-8" aria-label="Hotel Finder steps">
            {steps.map((step, index) => (
              <li><span>{index + 1}</span>{step}</li>
            ))}
          </ol>
        </div>
        <aside class="spark-brief hidden p-5 md:block" aria-label="Hotel prompt preview">
          <p class="text-xs font-black uppercase tracking-[0.08em] text-[#5C7355]">Travel brief preview</p>
          <h2 class="mt-3 font-sans text-lg font-black leading-snug text-[#2A2622]">Your hotel-hunting prompt is ready.</h2>
          <p class="mt-3 text-sm leading-6 text-[#5C544A]">
            Paste it into ChatGPT or Claude and let it search with your priorities in mind.
          </p>
        </aside>
      </div>
    </section>

    <HotelFinder />

    <section class="max-w-4xl mx-auto px-5 pb-16">
      <div class="toolkit-card p-6 md:p-7">
        <h2 class="font-serif text-2xl font-semibold text-[#2A2622] mb-3">
          Already know the destination? Find the best months.
        </h2>
        <p class="text-[#5C544A] leading-relaxed">
          Use the <a href="/best-time-to-go/" class="text-[#A0682E] font-semibold hover:underline">Best Time to Go</a> tool to compare weather, hotel value, crowds and practical travel risks before choosing your dates.
        </p>
      </div>
    </section>

    <MethodologyContent />
  </main>
</BaseLayout>
