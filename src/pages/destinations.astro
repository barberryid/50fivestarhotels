---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HotelComparisonTable from '../components/HotelComparisonTable.astro';
import { breadcrumbJsonLd, canonicalUrl, itemListJsonLd } from '../lib/seo';

const allHotels = await getCollection('hotels', ({ data }) => !data.draft);
allHotels.sort((a, b) => a.data.rank - b.data.rank);

const tableHotels = allHotels.map((h) => ({
  slug: h.data.slug,
  rank: h.data.rank,
  title: h.data.title,
  city: h.data.city,
  country: h.data.country,
  budgetTier: h.data.budgetTier,
  valueScore: h.data.valueScore,
  verdict: h.data.verdict,
  fiveStarStatus: h.data.fiveStarStatus,
  bestFor: h.data.bestFor,
  cautions: h.data.cautions,
}));

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: canonicalUrl('/') },
    { name: 'Destinations', url: canonicalUrl('/destinations/') },
  ]),
  itemListJsonLd('All hotels at a glance', allHotels),
];
---

<BaseLayout
  title={`All ${allHotels.length} Hotels at a Glance | 50 Five-Star Hotels`}
  description="The full 50 Five-Star Hotels list ranked by value score, with links to every hotel editorial profile."
  canonical="/destinations/"
  jsonLd={jsonLd}
>
  <main>
    <section class="max-w-6xl mx-auto px-5 py-20">
      <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">The full list</p>
      <h1 class="font-serif text-3xl md:text-4xl font-semibold text-[#1F2428] mb-4">
        All {allHotels.length} hotels at a glance
      </h1>
      <p class="text-[#6F685F] text-lg mb-10 max-w-2xl">
        Ranked by value score. Click any hotel for the full editorial profile.
      </p>
      <HotelComparisonTable hotels={tableHotels} title="" />
    </section>
  </main>
</BaseLayout>
