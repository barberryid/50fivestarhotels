---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FinderCta from '../components/FinderCta.astro';
import { breadcrumbJsonLd, canonicalUrl } from '../lib/seo';
import { countryRegion } from '../lib/regions';

const allHotels = await getCollection('hotels', ({ data }) => !data.draft);

// Map the granular region labels in lib/regions.ts to the five broad buckets
// the destination index groups by.
const broadRegionOf = (country: string): string => {
  const region = countryRegion(country);
  if (region === 'Asia') return 'Asia';
  if (region === 'Europe') return 'Europe';
  if (region === 'Middle East' || region === 'Middle East and North Africa') return 'Middle East & North Africa';
  if (region === 'Caucasus' || region === 'Central Asia') return 'Caucasus & Central Asia';
  if (region === 'Americas') return 'Americas';
  return 'Worldwide';
};

const regionOrder = ['Asia', 'Europe', 'Middle East & North Africa', 'Caucasus & Central Asia', 'Americas', 'Worldwide'];

const tierAmount = (tier: string): number => {
  const match = tier.match(/(\d+)/);
  return match ? Number(match[1]) : 9999;
};

interface CountrySummary {
  country: string;
  cities: string[];
  count: number;
  lowestTier: string;
  bestHotel: { title: string; slug: string; valueScore: number };
}

const countryMap = new Map<string, CountrySummary>();
for (const h of allHotels) {
  const { country, city, budgetTier, title, slug, valueScore } = h.data;
  const existing = countryMap.get(country);
  if (!existing) {
    countryMap.set(country, {
      country,
      cities: [city],
      count: 1,
      lowestTier: budgetTier,
      bestHotel: { title, slug, valueScore },
    });
  } else {
    if (!existing.cities.includes(city)) existing.cities.push(city);
    existing.count += 1;
    if (tierAmount(budgetTier) < tierAmount(existing.lowestTier)) existing.lowestTier = budgetTier;
    if (valueScore > existing.bestHotel.valueScore) existing.bestHotel = { title, slug, valueScore };
  }
}

const regionGroups = regionOrder
  .map((region) => ({
    region,
    countries: Array.from(countryMap.values())
      .filter((c) => broadRegionOf(c.country) === region)
      .sort((a, b) => a.country.localeCompare(b.country, 'en')),
  }))
  .filter((group) => group.countries.length > 0);

const jsonLd = breadcrumbJsonLd([
  { name: 'Home', url: canonicalUrl('/') },
  { name: 'Destinations', url: canonicalUrl('/destinations/') },
]);
---

<BaseLayout
  title="Hotel Finder Destination Examples | 50 Five-Star Hotels"
  description="Where affordable luxury is easier to find. Browse hotel-value examples grouped by region, then use the Hotel Finder to research your own destination."
  canonical="/destinations/"
  jsonLd={jsonLd}
>
  <main>
    <section class="bg-[#F8F2E8] border-b border-[#1F2428]/6">
      <div class="max-w-4xl mx-auto px-5 py-16">
        <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">Destination examples</p>
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-[#1F2428] leading-tight mb-6">
          Where affordable luxury is easier to find
        </h1>
        <p class="text-[#6F685F] text-lg leading-relaxed max-w-2xl">
          These regions show where the method has surfaced unusually good hotel value. Use them for inspiration, then run the Hotel Finder for your own destination and dates.
        </p>
      </div>
    </section>

    <div class="max-w-6xl mx-auto px-5 py-14 space-y-14">
      {regionGroups.map((group) => (
        <section>
          <h2 class="font-serif text-3xl font-semibold text-[#1F2428] mb-6">{group.region}</h2>
          <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {group.countries.map((c) => (
              <div class="flex flex-col rounded-2xl border border-[#E2D4BF] bg-[#FFFDF8] p-6">
                <h3 class="font-serif text-xl font-semibold text-[#1F2428] mb-2">{c.country}</h3>
                <p class="text-sm text-[#6F685F] mb-4">{c.cities.sort((a, b) => a.localeCompare(b)).join(', ')}</p>
                <dl class="grid grid-cols-2 gap-3 text-sm mb-4">
                  <div>
                    <dt class="text-xs uppercase tracking-wider font-semibold text-[#6F685F] mb-0.5">Examples</dt>
                    <dd class="text-[#1F2428] font-semibold">{c.count}</dd>
                  </div>
                  <div>
                    <dt class="text-xs uppercase tracking-wider font-semibold text-[#6F685F] mb-0.5">From tier</dt>
                    <dd class="text-[#1F2428] font-semibold">{c.lowestTier}</dd>
                  </div>
                </dl>
                <p class="text-sm text-[#1F2428]/75 mb-5">
                  Best example:{' '}
                  <a href={`/hotels/${c.bestHotel.slug}/`} class="text-[#B88A44] font-semibold hover:underline no-underline">
                    {c.bestHotel.title}
                  </a>
                </p>
                <a
                  href={`/hotel-finder/?country=${encodeURIComponent(c.country)}#hotel-finder`}
                  class="mt-auto inline-flex items-center justify-center rounded-full bg-[#4F6547] px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#344532] no-underline"
                >
                  Use the finder for this destination →
                </a>
              </div>
            ))}
          </div>
        </section>
      ))}

      <FinderCta
        title="Going somewhere not listed here?"
        text="The Hotel Finder works for any country, not only the examples above. Tell it your destination, budget and priorities to get a research brief."
      />

      <p class="text-sm text-[#6F685F]">
        Looking for the full ranked list?{' '}
        <a href="/all-hotels/" class="text-[#B88A44] font-semibold hover:underline no-underline">See the example hotel library →</a>
      </p>
    </div>
  </main>
</BaseLayout>
