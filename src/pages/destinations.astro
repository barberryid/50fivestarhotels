---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/Badge.astro';

const all = await getCollection('hotels', ({ data }) => !data.draft);
all.sort((a, b) => a.data.rank - b.data.rank);

const regions: Record<string, typeof all> = {};
for (const h of all) {
  if (!regions[h.data.region]) regions[h.data.region] = [];
  regions[h.data.region].push(h);
}

const regionOrder = [
  'Southeast Asia',
  'Europe',
  'Middle East and North Africa',
  'Caucasus and Central Asia',
];
---

<BaseLayout
  title="Hotel Destinations | 50 Five-Star Hotels"
  description="Browse affordable five-star hotels by destination region — Southeast Asia, Europe, Middle East, Caucasus and more."
>
  <main class="max-w-6xl mx-auto px-5 py-16">
    <!-- Header -->
    <div class="max-w-3xl mb-16">
      <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">Browse by destination</p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold text-[#1D2433] leading-tight mb-6">
        Hotels by destination
      </h1>
      <p class="text-[#6B7280] text-lg leading-relaxed">
        Hotel value is uneven by destination. Some of the world's most extraordinary properties sit in cities where the local cost base makes international-standard luxury surprisingly affordable. These are the destinations where that gap is most interesting.
      </p>
    </div>

    <!-- Regions -->
    {regionOrder.filter(r => regions[r]).map(region => (
      <section id={region.toLowerCase().replace(/\s+/g, '-')} class="mb-16">
        <h2 class="font-serif text-2xl font-bold text-[#1D2433] mb-2">{region}</h2>
        <div class="h-px bg-[#1D2433]/10 mb-8"></div>

        <div class="space-y-4">
          {regions[region].map(h => (
            <a href={`/hotels/${h.data.slug}`} class="block no-underline group">
              <article class="bg-white rounded-xl border border-[#1D2433]/6 p-5 hover:border-[#B88A44]/40 hover:shadow-md transition-all">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div class="flex-1 min-w-0">
                    <div class="flex flex-wrap gap-2 mb-2">
                      <Badge label={h.data.budgetTier} variant="tier" />
                      <Badge label={h.data.fiveStarStatus} variant="type" />
                    </div>
                    <h3 class="font-serif text-lg font-bold text-[#1D2433] group-hover:text-[#B88A44] transition-colors leading-snug">
                      {h.data.title}
                    </h3>
                    <p class="text-[#B88A44] text-sm font-medium mt-1">{h.data.city}, {h.data.country}</p>
                    <p class="text-[#6B7280] text-sm mt-2">{h.data.typicalPriceRange}</p>
                  </div>

                  <div class="shrink-0 text-right">
                    <div class="font-serif text-2xl font-bold text-[#58745A]">{h.data.valueScore}</div>
                    <div class="text-[10px] text-[#58745A] font-semibold uppercase tracking-wider">value score</div>
                    <div class="text-xs text-[#6B7280] mt-1">{h.data.verdict}</div>
                  </div>
                </div>

                <div class="mt-3 text-sm text-[#6B7280]">
                  <strong class="text-[#1D2433]/70">Why visit:</strong> {h.data.bestNearbyAttraction}
                </div>
              </article>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- Any remaining regions not in ordered list -->
    {Object.keys(regions).filter(r => !regionOrder.includes(r)).map(region => (
      <section id={region.toLowerCase().replace(/\s+/g, '-')} class="mb-16">
        <h2 class="font-serif text-2xl font-bold text-[#1D2433] mb-2">{region}</h2>
        <div class="h-px bg-[#1D2433]/10 mb-8"></div>
        <div class="space-y-4">
          {regions[region].map(h => (
            <a href={`/hotels/${h.data.slug}`} class="block no-underline group">
              <article class="bg-white rounded-xl border border-[#1D2433]/6 p-5 hover:border-[#B88A44]/40 hover:shadow-md transition-all">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div class="flex-1">
                    <h3 class="font-serif text-lg font-bold text-[#1D2433] group-hover:text-[#B88A44] transition-colors">{h.data.title}</h3>
                    <p class="text-[#B88A44] text-sm font-medium mt-1">{h.data.city}, {h.data.country}</p>
                  </div>
                  <Badge label={h.data.budgetTier} variant="tier" />
                </div>
              </article>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>
