---
interface Props {
  tier: string;
  href: string;
  tagline: string;
  description: string;
  count: number;
}

const { tier, href, tagline, description, count } = Astro.props;
---

<a href={href} class="block no-underline group">
  <article class="bg-[#FFFDF6] rounded-2xl p-8 shadow-sm hover:shadow-lg border border-[#2A2622]/5 transition-all group-hover:border-[#A0682E]/30 h-full flex flex-col gap-4">
    <div>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-[#5C7355]/12 text-[#5C7355] mb-4">
        {count} hotels
      </span>
      <h3 class="font-serif text-2xl font-bold text-[#2A2622] group-hover:text-[#A0682E] transition-colors">{tier}</h3>
      <p class="text-[#A0682E] text-sm font-semibold mt-1">{tagline}</p>
    </div>
    <p class="text-[#5C544A] text-sm leading-relaxed flex-1">{description}</p>
    <span class="text-[#2A2622] text-sm font-semibold group-hover:text-[#A0682E] transition-colors">
      Browse hotels →
    </span>
  </article>
</a>
