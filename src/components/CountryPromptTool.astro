---
// Interactive country → research-prompt tool for /research-hotels/.
//
// Hotel data source: the same `hotels` content collection that
// src/pages/index.astro builds its table from (preferred path in the brief —
// a structured build-time source exists, so no HTML parsing fallback is
// needed). The published list, the per-country [EXISTING HOTELS] blocks and
// the [COVERAGE] line all refresh automatically on every deploy.
import { getCollection } from 'astro:content';
import AccordionCard from './AccordionCard.astro';
import PersonalisePreferences from './PersonalisePreferences.astro';
import { countries } from '../data/unCountries';
import { researchPriceLevels } from '../data/researchPriceLevels';
import { researchPromptTemplate } from '../data/researchPromptTemplate';
import { ordinaryHotelPromptTemplate } from '../data/ordinaryHotelPromptTemplate';

const allHotels = await getCollection('hotels', ({ data }) => !data.draft);

type FinderVariant = 'luxury' | 'ordinary';

interface Props {
  variant?: FinderVariant;
}

const { variant = 'luxury' } = Astro.props;
const isOrdinary = variant === 'ordinary';

// Frontmatter country names that don't match unCountries display names.
// Extend this map if a new hotel's `country:` value doesn't appear in the
// dropdown list (the build fails with a clear error when that happens).
const countryAliases: Record<string, string> = {
  England: 'United Kingdom',
  Scotland: 'United Kingdom',
  Wales: 'United Kingdom',
  'Northern Ireland': 'United Kingdom',
  UAE: 'United Arab Emirates',
  USA: 'United States',
};

const knownNames = new Set(countries.map((c) => c.name));
const toCountryName = (raw: string): string => {
  const name = countryAliases[raw] ?? raw;
  if (!knownNames.has(name)) {
    throw new Error(
      `[CountryPromptTool] Hotel country "${raw}" has no match in src/data/unCountries.ts. ` +
        `Add an entry to countryAliases in src/components/CountryPromptTool.astro ` +
        `mapping "${raw}" to the matching unCountries display name.`
    );
  }
  return name;
};

// Per-country published hotels, weakest (lowest value score) first.
const hotelsByCountry: Record<string, { name: string; score: number }[]> = {};
for (const h of allHotels) {
  const country = toCountryName(h.data.country);
  (hotelsByCountry[country] ??= []).push({ name: h.data.title, score: h.data.valueScore });
}
for (const list of Object.values(hotelsByCountry)) {
  list.sort((a, b) => a.score - b.score);
}

// Site-wide coverage line: distinct countries, alphabetical, comma-separated.
const coverage = Object.keys(hotelsByCountry)
  .sort((a, b) => a.localeCompare(b, 'en'))
  .join(', ');

const ordinaryPriceLevels = [
  {
    amount: 50,
    title: 'Basic bargain',
    text: 'Only worth using when recent reviews, location and basic comfort still look dependable.',
  },
  {
    amount: 100,
    title: 'Good everyday value',
    text: 'A useful ceiling for clean, central-enough hotels in lower-cost destinations or quiet seasons.',
  },
  {
    amount: 200,
    title: 'Comfortable mid-range',
    text: 'Allows better locations, quieter rooms and fewer compromises in many cities.',
  },
  {
    amount: 250,
    title: 'Flexible comfort ceiling',
    text: 'Useful for expensive cities, awkward dates or hotels that solve the practical trip especially well.',
  },
];

const priceLevelOptions = isOrdinary ? ordinaryPriceLevels : researchPriceLevels;
const promptTemplate = isOrdinary ? ordinaryHotelPromptTemplate : researchPromptTemplate;
const defaultPriceLevels = priceLevelOptions.map(({ amount }) => amount);

const finderCopy = isOrdinary
  ? {
      firstStepDescription:
        'Start with a country, city, island, region or route. The more real-world context you add, the better the AI can judge comfort, location, recent reviews and practical trade-offs.',
      priceStepTitle: 'What nightly price should the AI test?',
      priceStepDescription:
        'Choose the price levels you want the AI to test. Lower prices are useful, but the prompt will still reject hotels with weak recent reviews, poor locations or unreliable basics.',
      preferenceTitle: 'What would make the stay work well?',
      preferenceDescription:
        'Tell the AI which practical details matter most. Good choices here help filter out hotels that look fine on paper but would be annoying for your actual trip.',
      outputModeDescription:
        'Choose how detailed the output should be, then open and copy your prompt from the box below and paste it into ChatGPT or Claude.',
      simpleModeLabel: 'Simple shortlist',
      simpleModeDescription: 'Best for choosing a dependable place to stay',
      deepModeLabel: 'Deep research',
      deepModeDescription: 'Best for comparing a full ordinary-hotel market',
      generateTitle: 'Generate your ordinary-hotel prompt',
      promptReadyHeading: 'Your ordinary-hotel prompt is ready',
      promptReadyDescription:
        'Paste this into ChatGPT, Claude or another AI tool, then ask follow-up questions before booking.',
      textareaLabel: 'Ordinary hotel-finding brief text',
      manualSearchDescription:
        'Use these searches on Booking.com, Google Hotels or your preferred booking site to verify the ordinary-but-good hotels the prompt finds.',
      copySuccessDescription:
        'Open ChatGPT or Claude, start a fresh session, and paste the brief there. Verify live prices, room photos and recent reviews before booking.',
    }
  : {
      firstStepDescription:
        'Start with a country, city, island, region or route. The more real-world context you add, the better the AI can judge value, location and trade-offs.',
      priceStepTitle: 'What price level should the AI test?',
      priceStepDescription:
        'Choose the price levels you want the AI to test. Lower prices are exciting, but the prompt will also ask the AI to flag weak or misleading five-star claims.',
      preferenceTitle: 'What kind of stay would feel special?',
      preferenceDescription:
        'Tell the AI what would make the stay feel worth booking. Good choices here help filter out generic hotels that look fine on paper but do not fit your trip.',
      outputModeDescription:
        'Choose how detailed the output should be, then open and copy your prompt from the box below and paste it into ChatGPT or Claude.',
      simpleModeLabel: 'Simple shortlist',
      simpleModeDescription: 'Best for travellers planning a trip',
      deepModeLabel: 'Deep research',
      deepModeDescription: 'Best for comparing a full market',
      generateTitle: 'Generate your hotel-hunting prompt',
      promptReadyHeading: 'Your hotel-hunting prompt is ready',
      promptReadyDescription:
        'Paste this into ChatGPT, Claude or another AI tool, then ask follow-up questions before booking.',
      textareaLabel: 'Hotel-finding brief text',
      manualSearchDescription:
        'Use these searches on Booking.com, Google Hotels or your preferred booking site to verify what the prompt finds.',
      copySuccessDescription:
        'Open ChatGPT or Claude, start a fresh session, and paste the brief there. Verify live prices before booking.',
    };

const dealBreakerOptions = [
  'Avoid poor recent reviews',
  'Avoid isolated locations',
  'Avoid noisy nightlife areas',
  'Avoid weak air conditioning',
  'Avoid hotels with dated rooms',
  'Avoid destinations with high safety or political risk',
  'Breakfast must be included or affordable',
  'Free cancellation preferred',
  'Walkable location preferred',
];
const outputModeStorageKey = isOrdinary
  ? '50fivestarhotels:ordinaryHotelFinderOutputMode'
  : '50fivestarhotels:hotelFinderOutputMode';
const defaultOutputMode = 'simple';
const outputModes = {
  simple: `### Output mode — Simple shortlist

Use this output mode as the main shape of the answer. If it conflicts with the longer scan structure below, keep the answer traveller-first and concise.

Give me the 5–8 strongest hotel options only. Do not produce a long market scan unless it is needed to explain why the destination has very few credible choices.

For each hotel, include:
- Why it fits my trip
- Value score and trip-fit score
- Typical price range
- What kind of five-star or near-luxury hotel it really is
- Best for
- Not ideal for
- Main drawback
- What to verify before booking

After the shortlist, give me one clear recommendation: the hotel you would check first, and why.`,
  deep: `### Output mode — Deep research

Use this output mode as the main shape of the answer.

Give me the full destination scan, longlist, value scores and trip-fit scores, rejected hotels, fallback results and final shortlist.

Also include:
- Hotels rejected and why
- Any credible four-star or near-luxury exceptions clearly marked
- Affiliate suitability only as a secondary note, not as a reason to recommend a weak hotel
- Best 3–5 hotels for a practical traveller shortlist

If useful for website research, add a secondary note on affiliate suitability: Good / Moderate / Weak. Do not let affiliate suitability override traveller value, safety, hotel quality or honesty.`,
};

const ordinaryOutputModes = {
  simple: `### Output mode - Simple shortlist

Use this output mode as the main shape of the answer. Keep it traveller-first and practical.

Give me the 5-8 strongest ordinary-but-good hotel options only. Do not produce a long market scan unless it is needed to explain why the destination has very few dependable choices.

For each hotel, include:
- Why it fits my trip
- Value score and trip-fit score
- Typical price range
- What kind of ordinary hotel it really is
- Best for
- Not ideal for
- Main drawback
- What to verify before booking

After the shortlist, give me one clear recommendation: the hotel you would check first, and why.`,
  deep: `### Output mode - Deep research

Use this output mode as the main shape of the answer.

Give me the full destination scan, longlist, value scores and trip-fit scores, rejected hotels, fallback results and final shortlist.

Also include:
- Hotels rejected and why
- Any dependable aparthotel, guesthouse, airport/station hotel or simple chain option clearly marked by type
- Notes on recurring recent complaints, especially cleanliness, noise, maintenance, beds, air conditioning, service and location
- Best 3-5 hotels for a practical traveller shortlist

Keep the answer focused on whether I would be glad I booked the hotel, not whether it sounds impressive.`,
};

const activeOutputModes = isOrdinary ? ordinaryOutputModes : outputModes;

const buildPriceLevelPromptParts = (amounts: readonly number[]) => {
  const sorted = [...amounts].sort((a, b) => a - b);
  const highest = sorted[sorted.length - 1] ?? defaultPriceLevels[defaultPriceLevels.length - 1];
  const levelLines = sorted.map((amount) => `- **€${amount} or below**`).join('\n');
  const labelLines = sorted.map((amount) => `- Under €${amount}`).join('\n');
  const fallbackLabelLines = sorted.map((amount) => `- Fallback above €${amount}`).join('\n');
  const fallbackLabels = sorted.map((amount) => `**Fallback above €${amount}**`).join(', ');
  const selectedPhrase = sorted.length === 1
    ? 'this selected nightly price level'
    : 'these selected nightly price levels in order';
  const fallbackRule = sorted.length === 1
    ? `If a selected country or region has no credible hotel at **€${highest} or below**, do not leave the result blank. Display: **No credible hotel option found under €${highest}**, then show the **next best 3 hotels above that level**, ranked by value and clearly marked as **Fallback above €${highest}** results.`
    : `If a selected country or region has no credible hotel at **€${sorted[0]} or below**, do not leave the result blank. Display: **No credible hotel option found under €${sorted[0]}**, then show the **next best 3 hotels above that level**, ranked by value and clearly marked as **Fallback above €${sorted[0]}** results. Continue the wider search up to the highest selected level (€${highest}). Apply the same fallback pattern to any selected level with no credible hotel options, using the matching fallback label for that level (${fallbackLabels}). If no credible hotel appears within the selected levels, list the next best 3 hotels above €${highest} and clearly mark them as **Fallback above €${highest}** results.`;

  return {
    searchRule: `Always search ${selectedPhrase}:\n${levelLines}\n\nUse shoulder-season standard-room nightly rates, before taxes unless the source only shows tax-inclusive totals. Record the lowest selected level each hotel can meet, but do not promise that the rate is always available.\n\n${fallbackRule}`,
    labels: `${labelLines}\n${fallbackLabelLines}`,
    disqualificationRule: `Regularly prices above €${highest} per night even in shoulder season, unless included only as one of the clearly marked fallback hotels requested because no selected price level produced credible hotel options`,
  };
};

const applyPriceLevelTokens = (text: string, amounts: readonly number[]) => {
  const parts = buildPriceLevelPromptParts(amounts);
  return text
    .split('[PRICE_LEVEL_SEARCH_RULE]').join(parts.searchRule)
    .split('[PRICE_LEVEL_LABELS]').join(parts.labels)
    .split('[PRICE_LEVEL_DISQUALIFICATION_RULE]').join(parts.disqualificationRule);
};

// Default textarea text: coverage is always populated; [REGION] and
// [EXISTING HOTELS] stay literal until a country is selected. The personal
// traveller-fit tokens default to empty (no preferences active yet); the
// client refills them when PersonalisePreferences emits a change.
const defaultPrompt = applyPriceLevelTokens(promptTemplate, defaultPriceLevels)
  .split('[COVERAGE]').join(coverage)
  .split('[CITY_FOCUS_SECTION]').join('')
  .split('[TRIP_SCENARIO_SECTION]').join('')
  .split('[PERSONAL_WEIGHTING_SECTION]').join('')
  .split('[PERSONAL_OUTPUT_NOTES]').join('')
  .split('[OUTPUT_MODE_SECTION]').join(activeOutputModes[defaultOutputMode]);

const toolData = {
  template: promptTemplate,
  variant,
  coverage,
  hotelsByCountry,
  priceLevels: defaultPriceLevels,
  outputModes: activeOutputModes,
  defaultOutputMode,
  outputModeStorageKey,
};
---

<div class="space-y-5" data-country-prompt-tool>
  <AccordionCard title="Where are you going?" number={1} open={true}>
  <p class="mb-6 text-[#2A2622]/80 leading-relaxed">
    {finderCopy.firstStepDescription}
  </p>
  <!-- Country combobox -->
  <label id="country-label" for="country-input" class="sr-only">
    Country or territory
  </label>
  <div class="relative max-w-md">
    <input
      type="text"
      id="country-input"
      role="combobox"
      aria-expanded="false"
      aria-controls="country-listbox"
      aria-autocomplete="list"
      aria-activedescendant=""
      autocomplete="off"
      spellcheck="false"
      placeholder="Start typing — e.g. Vietnam, Côte d’Ivoire…"
      class="w-full rounded-xl border border-[#E6DBBE] bg-white px-4 py-3 text-[#2A2622] placeholder-[#5C544A]/60 focus:outline-none focus:ring-2 focus:ring-[#A0682E]/60 focus:border-[#A0682E]"
    />
    <ul
      id="country-listbox"
      role="listbox"
      aria-labelledby="country-label"
      hidden
      class="absolute z-20 mt-1 w-full max-h-72 overflow-y-auto rounded-xl border border-[#E6DBBE] bg-white shadow-lg py-1"
    >
      {countries.map((c) => (
        <li
          id={`country-option-${c.code}`}
          role="option"
          aria-selected="false"
          data-name={c.name}
          class="cursor-pointer px-4 py-2 text-sm text-[#2A2622] aria-selected:bg-[#F4EADC] data-[active]:bg-[#F4EADC]"
        >
          {c.name}
        </li>
      ))}
      <li id="country-no-results" hidden class="px-4 py-2 text-sm text-[#5C544A] italic" role="presentation">
        No matching country or territory
      </li>
    </ul>
  </div>

  <!-- City or town (optional, freeform) -->
  <label for="city-input" class="mt-6 block text-sm font-semibold text-[#2A2622] mb-2">
    City or town <span class="font-normal text-[#5C544A]">(optional)</span>
  </label>
  <div class="max-w-md">
    <input
      type="text"
      id="city-input"
      autocomplete="off"
      spellcheck="false"
      placeholder="e.g. Hoi An, Oaxaca, Luang Prabang…"
      class="w-full rounded-xl border border-[#E6DBBE] bg-white px-4 py-3 text-[#2A2622] placeholder-[#5C544A]/60 focus:outline-none focus:ring-2 focus:ring-[#A0682E]/60 focus:border-[#A0682E]"
    />
    <p class="mt-2 text-sm text-[#5C544A]">
      Leave blank to research the whole country. Enter a city or town to focus the search on it and the destinations within easy reach.
    </p>
  </div>

  <!-- Transport-radius search (optional, needs a city) -->
  <div class="mt-4 max-w-2xl">
    <label class="spark-chip flex cursor-pointer items-start gap-3 rounded-lg border border-[#E6DBBE] bg-white px-4 py-3 text-sm transition-colors has-[:checked]:border-[#5C7355] has-[:checked]:bg-[#E8F1E6]">
      <input
        type="checkbox"
        id="transport-radius-input"
        class="mt-1 h-4 w-4 shrink-0 rounded border-[#E6DBBE] text-[#5C7355] accent-[#5C7355]"
        aria-describedby="transport-radius-description"
      />
      <span class="text-[#2A2622]">
        <span class="block font-semibold">Search nearby towns by transport instead</span>
        <span class="block text-[#5C544A]">Include every town within 60 minutes by public transport (train preferred) of the city above, and don&rsquo;t favour famous towns or tourist centres.</span>
      </span>
    </label>
    <p id="transport-radius-description" class="mt-2 text-sm text-[#5C544A]">
      Great for finding better-value bases near expensive destinations — a quiet town one train stop away often beats the famous name. Needs a city or town above.
    </p>
  </div>

  <!-- Travel timing -->
  <div class="mt-6 grid gap-4 md:grid-cols-[minmax(0,1.5fr)_minmax(0,0.8fr)] max-w-2xl">
    <div>
      <label for="travel-dates-input" class="block text-sm font-semibold text-[#2A2622] mb-2">
        Travel dates or month <span class="font-normal text-[#5C544A]">(optional)</span>
      </label>
      <input
        type="text"
        id="travel-dates-input"
        autocomplete="off"
        spellcheck="false"
        placeholder="e.g. March 2026, 12–15 May, shoulder season, flexible..."
        class="w-full rounded-xl border border-[#E6DBBE] bg-white px-4 py-3 text-[#2A2622] placeholder-[#5C544A]/60 focus:outline-none focus:ring-2 focus:ring-[#A0682E]/60 focus:border-[#A0682E]"
      />
      <p class="mt-2 text-sm text-[#5C544A]">
        Add exact dates, a month, or a flexible season so the prompt can judge price and weather realistically.
      </p>
    </div>

    <div>
      <label for="nights-input" class="block text-sm font-semibold text-[#2A2622] mb-2">
        Number of nights <span class="font-normal text-[#5C544A]">(optional)</span>
      </label>
      <input
        type="number"
        id="nights-input"
        min="1"
        max="60"
        inputmode="numeric"
        placeholder="e.g. 2"
        class="w-full rounded-xl border border-[#E6DBBE] bg-white px-4 py-3 text-[#2A2622] placeholder-[#5C544A]/60 focus:outline-none focus:ring-2 focus:ring-[#A0682E]/60 focus:border-[#A0682E]"
      />
      <p class="mt-2 text-sm text-[#5C544A]">
        Short stopovers and longer stays often need different hotel choices.
      </p>
    </div>
  </div>

  <!-- Trip scenario (optional, freeform) -->
  <label for="trip-scenario-input" class="mt-6 block text-sm font-semibold text-[#2A2622] mb-2">
    Trip scenario <span class="font-normal text-[#5C544A]">(optional)</span>
  </label>
  <div class="max-w-2xl">
    <textarea
      id="trip-scenario-input"
      rows="3"
      spellcheck="true"
      placeholder="e.g. 2 nights before a flight, romantic weekend, safe base for sightseeing, quiet hotel near restaurants..."
      class="w-full rounded-xl border border-[#E6DBBE] bg-white px-4 py-3 text-[#2A2622] placeholder-[#5C544A]/60 focus:outline-none focus:ring-2 focus:ring-[#A0682E]/60 focus:border-[#A0682E]"
    ></textarea>
    <p class="mt-2 text-sm text-[#5C544A]">
      Add the real context of your trip so the prompt can judge fit, not just price.
    </p>
  </div>

  <!-- Deal-breakers -->
  <fieldset class="mt-6 border-0 p-0 m-0 max-w-2xl">
    <legend class="block text-sm font-semibold text-[#2A2622] mb-2">
      Deal-breakers <span class="font-normal text-[#5C544A]">(optional)</span>
    </legend>
    <p class="mb-3 text-sm text-[#5C544A]">
      Tick anything that should strongly affect the shortlist.
    </p>
    <div class="grid gap-2 sm:grid-cols-2">
      {dealBreakerOptions.map((option) => (
        <label class="spark-chip flex cursor-pointer items-start gap-3 rounded-lg border border-[#E6DBBE] bg-white px-4 py-3 text-sm transition-colors has-[:checked]:border-[#5C7355] has-[:checked]:bg-[#E8F1E6]">
          <input
            type="checkbox"
            value={option}
            data-deal-breaker-input
            class="mt-1 h-4 w-4 shrink-0 rounded border-[#E6DBBE] text-[#5C7355] accent-[#5C7355]"
          />
          <span class="text-[#2A2622]">{option}</span>
        </label>
      ))}
    </div>
  </fieldset>
  </AccordionCard>

  <AccordionCard title={finderCopy.priceStepTitle} number={2}>
    <p class="text-[#2A2622]/80 leading-relaxed mb-7" data-price-level-summary>
      {finderCopy.priceStepDescription}
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {priceLevelOptions.map(({ amount, title, text }) => (
        <label
          class="spark-chip rounded-lg border border-[#E6DBBE] bg-white p-5 cursor-pointer shadow-[3px_3px_0_rgba(42, 38, 34,0.05)] transition-colors data-[selected=true]:border-[#A0682E] data-[selected=true]:bg-[#FBF6E9] hover:border-[#A0682E]"
          data-price-level-card
          data-selected="true"
        >
          <span class="flex h-full gap-4">
            <input
              type="checkbox"
              value={amount}
              checked
              data-price-level-input
              class="mt-1 h-5 w-5 shrink-0 rounded border-[#A0682E] text-[#A0682E] accent-[#A0682E]"
              aria-describedby={`price-level-${amount}-description`}
            />
            <span class="min-w-0">
              <span class="block text-3xl font-serif font-semibold text-[#2A2622] mb-2">EUR {amount}</span>
              <span class="block text-sm font-bold uppercase tracking-[0.08em] text-[#A0682E] mb-3">{title}</span>
              <span id={`price-level-${amount}-description`} class="block text-sm leading-relaxed text-[#5C544A]">{text}</span>
              <span class="mt-4 inline-flex rounded-full bg-white px-3 py-1 text-xs font-semibold text-[#5C7355]" data-price-level-state>
                Included
              </span>
            </span>
          </span>
        </label>
      ))}
    </div>
    <p class="mt-4 text-sm text-[#5C544A]" role="status" aria-live="polite" data-price-level-status>
      Select at least one price level. The prompt below updates automatically.
    </p>
  </AccordionCard>

  <PersonalisePreferences
    number={3}
    title={finderCopy.preferenceTitle}
    description={finderCopy.preferenceDescription}
  />

  <AccordionCard title="What kind of answer should the AI give?" number={4}>
    <fieldset class="border-0 p-0 m-0">
      <legend class="sr-only">Output detail level</legend>
      <p class="mb-3 text-sm leading-relaxed text-[#5C544A]">
        {finderCopy.outputModeDescription}
      </p>
      <div class="grid gap-2 sm:grid-cols-2" data-output-mode-group>
        <label class="spark-chip flex cursor-pointer items-start gap-3 rounded-lg border border-[#E6DBBE] bg-white px-4 py-3 text-sm transition-colors has-[:checked]:border-[#A0682E] has-[:checked]:bg-[#F4EADC]">
          <input
            type="radio"
            name="hotel-output-mode"
            value="simple"
            checked
            data-output-mode-input
            class="mt-1 h-4 w-4 shrink-0 border-[#A0682E] text-[#A0682E] accent-[#A0682E]"
          />
          <span>
            <span class="block font-semibold text-[#2A2622]">{finderCopy.simpleModeLabel}</span>
            <span class="block text-[#5C544A]">{finderCopy.simpleModeDescription}</span>
          </span>
        </label>
        <label class="spark-chip flex cursor-pointer items-start gap-3 rounded-lg border border-[#E6DBBE] bg-white px-4 py-3 text-sm transition-colors has-[:checked]:border-[#A0682E] has-[:checked]:bg-[#F4EADC]">
          <input
            type="radio"
            name="hotel-output-mode"
            value="deep"
            data-output-mode-input
            class="mt-1 h-4 w-4 shrink-0 border-[#A0682E] text-[#A0682E] accent-[#A0682E]"
          />
          <span>
            <span class="block font-semibold text-[#2A2622]">{finderCopy.deepModeLabel}</span>
            <span class="block text-[#5C544A]">{finderCopy.deepModeDescription}</span>
          </span>
        </label>
      </div>
    </fieldset>
  </AccordionCard>

  <AccordionCard title={finderCopy.generateTitle} number={5}>
    <button
      slot="actions"
      type="button"
      disabled
      data-copy-prompt-button
      class="toolkit-button toolkit-button-gold shrink-0 px-4 py-2 text-xs md:px-5 md:py-2.5 md:text-sm disabled:cursor-not-allowed disabled:bg-[#C4B9A6] disabled:shadow-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span data-copy-prompt-label>Select a destination before copying</span>
    </button>
    <span slot="actions" class="sr-only" role="status" aria-live="polite" data-copy-prompt-status></span>
    <div class="space-y-3">
      <section aria-labelledby="hotel-prompt-heading" data-nosnippet class="prompt-paper overflow-hidden" data-prompt-card data-hotel-prompt-card>
        <button
          type="button"
          class="group flex w-full items-start justify-between gap-4 px-4 py-4 text-left transition-colors hover:bg-white/60 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-[#5C7355]/50 md:px-5"
          aria-expanded="false"
          aria-controls="hotel-prompt-panel"
          data-prompt-toggle
        >
          <span class="min-w-0">
            <span class="flex flex-wrap items-center gap-2">
              <span id="hotel-prompt-heading" class="block text-sm font-semibold text-[#2A2622]">
                {finderCopy.promptReadyHeading}
              </span>
              <span class="rounded-full bg-[#E6EBDD] px-2.5 py-1 text-[0.7rem] font-bold uppercase tracking-[0.08em] text-[#5C7355]">Prompt ready</span>
            </span>
            <span class="mt-1 block text-sm leading-relaxed text-[#5C544A]">
              {finderCopy.promptReadyDescription}
            </span>
          </span>
          <span class="mt-0.5 inline-flex shrink-0 items-center gap-2 rounded-lg bg-[#5C7355] px-3.5 py-1.5 text-xs font-bold text-white shadow-[0_4px_0_#344532] transition-colors group-hover:bg-[#344532]">
            <span data-prompt-toggle-label>Show prompt</span>
            <svg data-prompt-chevron xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 transition-transform" aria-hidden="true">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </span>
        </button>
        <div id="hotel-prompt-panel" class="border-t border-[#E6DBBE] p-4 md:p-5" data-prompt-panel hidden>
          <div class="mb-3 flex flex-wrap items-center justify-end gap-3">
            <button
              type="button"
              id="copy-prompt-button"
              disabled
              data-copy-prompt-button
              class="toolkit-button toolkit-button-gold shrink-0 px-5 py-2.5 text-sm disabled:cursor-not-allowed disabled:bg-[#C4B9A6] disabled:shadow-none"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span id="copy-prompt-label" data-copy-prompt-label>Select a destination before copying</span>
            </button>
            <span id="copy-prompt-status" data-copy-prompt-status class="sr-only" role="status" aria-live="polite"></span>
          </div>
          <label for="prompt-textarea" class="sr-only">{finderCopy.textareaLabel}</label>
          <textarea
            id="prompt-textarea"
            rows="18"
            spellcheck="false"
            class="w-full rounded-lg border border-[#E6DBBE] bg-white/80 px-4 py-3 text-sm leading-relaxed text-[#2A2622] focus:outline-none focus:ring-2 focus:ring-[#A0682E]/60 focus:border-[#A0682E]"
          >{defaultPrompt}</textarea>
          <p class="mt-3 text-sm font-semibold text-[#5C7355]" role="status" aria-live="polite" data-brief-ready-status>
            Choose a destination to make the brief copy-ready.
          </p>
          <div class="mt-4 rounded-xl border border-[#E6DBBE] bg-[#FFFDF6] p-4">
            <h3 class="text-sm font-semibold text-[#2A2622] mb-2">Suggested manual searches</h3>
            <p class="text-sm leading-relaxed text-[#5C544A] mb-3">
              {finderCopy.manualSearchDescription}
            </p>
            <ul class="space-y-2 text-sm text-[#2A2622]" data-search-suggestions>
              <li>Select a destination to generate suggested searches.</li>
            </ul>
          </div>
          <div id="hotel-copy-success" hidden class="spark-brief mt-4 p-4">
            <p class="text-sm font-semibold text-[#2A2622] mb-1">Prompt copied.</p>
            <p class="text-sm leading-relaxed text-[#2A2622]/80 mb-3">
              {finderCopy.copySuccessDescription}
            </p>
            <div class="flex flex-wrap gap-3">
              <a
                href="https://chatgpt.com/"
                target="_blank"
                rel="noopener noreferrer"
                data-open-chatgpt
                class="inline-flex items-center gap-2 rounded-full bg-[#2A2622] px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#5C7355] no-underline"
              >
                Open ChatGPT →
              </a>
              <a
                href="https://claude.ai/"
                target="_blank"
                rel="noopener noreferrer"
                data-open-claude
                class="inline-flex items-center gap-2 rounded-full border border-[#2A2622] px-5 py-2.5 text-sm font-semibold text-[#2A2622] transition-colors hover:bg-[#2A2622] hover:text-white no-underline"
              >
                Open Claude →
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </AccordionCard>

  <!-- Reset -->
  <div class="pt-1">
    <button
      type="button"
      id="reset-country-button"
      class="toolkit-button toolkit-button-secondary text-xs"
    >
      Try another destination
    </button>
  </div>
</div>

<script is:inline type="application/json" id="country-prompt-data" set:html={JSON.stringify(toolData)} />

<script>
  const data = JSON.parse(document.getElementById('country-prompt-data')!.textContent!) as {
    template: string;
    variant: 'luxury' | 'ordinary';
    coverage: string;
    hotelsByCountry: Record<string, { name: string; score: number }[]>;
    priceLevels: number[];
    outputModes: Record<string, string>;
    defaultOutputMode: string;
    outputModeStorageKey: string;
  };
  const isOrdinaryFinder = data.variant === 'ordinary';

  const input = document.getElementById('country-input') as HTMLInputElement;
  const cityInput = document.getElementById('city-input') as HTMLInputElement;
  const transportRadiusInput = document.getElementById('transport-radius-input') as HTMLInputElement;
  const travelDatesInput = document.getElementById('travel-dates-input') as HTMLInputElement;
  const nightsInput = document.getElementById('nights-input') as HTMLInputElement;
  const tripScenarioInput = document.getElementById('trip-scenario-input') as HTMLTextAreaElement;
  const dealBreakerInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-deal-breaker-input]'));
  const searchSuggestions = document.querySelector<HTMLElement>('[data-search-suggestions]');
  const briefReadyStatus = document.querySelector<HTMLElement>('[data-brief-ready-status]');
  const listbox = document.getElementById('country-listbox') as HTMLUListElement;
  const noResults = document.getElementById('country-no-results') as HTMLLIElement;
  const textarea = document.getElementById('prompt-textarea') as HTMLTextAreaElement;
  // Two copy buttons share the same state and action: one at the top of the
  // step and one inside the prompt panel.
  const copyButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-copy-prompt-button]'));
  const copyLabels = Array.from(document.querySelectorAll<HTMLElement>('[data-copy-prompt-label]'));
  const copyStatuses = Array.from(document.querySelectorAll<HTMLElement>('[data-copy-prompt-status]'));
  const resetButton = document.getElementById('reset-country-button') as HTMLButtonElement;
  const hotelCopySuccess = document.getElementById('hotel-copy-success') as HTMLElement | null;
  const options = Array.from(listbox.querySelectorAll<HTMLLIElement>('[role="option"]'));

  const track = (eventName: string, props: Record<string, unknown> = {}) => {
    const fn = (window as unknown as { ffshTrack?: (name: string, props?: Record<string, unknown>) => void }).ffshTrack;
    if (typeof fn === 'function') fn(eventName, props);
  };

  for (const link of Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-open-chatgpt]'))) {
    link.addEventListener('click', () => track('open_chatgpt_clicked'));
  }
  for (const link of Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-open-claude]'))) {
    link.addEventListener('click', () => track('open_claude_clicked'));
  }
  const promptCards = Array.from(document.querySelectorAll<HTMLElement>('[data-prompt-card]'));
  const hotelPromptCard = document.querySelector<HTMLElement>('[data-hotel-prompt-card]');
  const priceLevelInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-price-level-input]'));
  const priceLevelSummary = document.querySelector<HTMLElement>('[data-price-level-summary]');
  const priceLevelStatus = document.querySelector<HTMLElement>('[data-price-level-status]');
  const outputModeInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-output-mode-input]'));

  // Case- and accent-insensitive fold ("cote" matches "Côte d’Ivoire").
  const fold = (s: string) =>
    s
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .replace(/[’ʼ]/g, "'")
      .toLowerCase();

  let activeIndex = -1;
  let visible: HTMLLIElement[] = options;
  let copiedTimer: ReturnType<typeof setTimeout> | undefined;
  let selectedCountry: string | null = null;
  let hasAutoOpenedHotelPrompt = false;

  // Traveller-fit fragments supplied by PersonalisePreferences. Read any value
  // it published before this script ran (load-order safety), then keep it in
  // sync via the `personalise:change` event below.
  let personalParts: {
    weightingSection: string;
    outputNotes: string;
    travellerProfile?: string;
    travellerPriorities?: string;
    additionalNotes?: string;
  } =
    (window as unknown as {
      __personalisePromptParts?: {
        weightingSection: string;
        outputNotes: string;
        travellerProfile?: string;
        travellerPriorities?: string;
        additionalNotes?: string;
      };
    }).__personalisePromptParts ?? { weightingSection: '', outputNotes: '' };

  const substituteAll = (text: string, token: string, value: string) => text.split(token).join(value);

  const setPromptCardOpen = (card: HTMLElement, open: boolean) => {
    const toggle = card.querySelector<HTMLButtonElement>('[data-prompt-toggle]');
    const panel = card.querySelector<HTMLElement>('[data-prompt-panel]');
    const label = card.querySelector<HTMLElement>('[data-prompt-toggle-label]');
    const chevron = card.querySelector<SVGElement>('[data-prompt-chevron]');
    if (!toggle || !panel) return;
    if (open) card.closest('details')?.setAttribute('open', '');

    toggle.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    if (label) label.textContent = open ? 'Hide prompt' : 'Show prompt';
    chevron?.classList.toggle('rotate-180', open);
  };

  for (const card of promptCards) {
    const toggle = card.querySelector<HTMLButtonElement>('[data-prompt-toggle]');
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setPromptCardOpen(card, open);
    });
  }

  const getOutputMode = () =>
    outputModeInputs.find((modeInput) => modeInput.checked)?.value ?? data.defaultOutputMode;

  const getOutputModeSection = () => data.outputModes[getOutputMode()] ?? data.outputModes[data.defaultOutputMode] ?? '';

  const setOutputMode = (mode: string, persist = true) => {
    const safeMode = data.outputModes[mode] ? mode : data.defaultOutputMode;
    for (const modeInput of outputModeInputs) {
      modeInput.checked = modeInput.value === safeMode;
    }
    if (persist) {
      try {
        localStorage.setItem(data.outputModeStorageKey, safeMode);
      } catch {
        /* ignore quota / privacy-mode errors */
      }
    }
  };

  const restoreOutputMode = () => {
    let mode = data.defaultOutputMode;
    try {
      mode = localStorage.getItem(data.outputModeStorageKey) ?? mode;
    } catch {
      mode = data.defaultOutputMode;
    }
    setOutputMode(mode, false);
  };

  const formatEuroSeries = (amounts: number[]) => {
    const labels = amounts.map((amount) => `€${amount}`);
    if (labels.length <= 1) return labels[0] ?? '';
    if (labels.length === 2) return `${labels[0]} and ${labels[1]}`;
    return `${labels.slice(0, -1).join(', ')} and ${labels[labels.length - 1]}`;
  };

  const normalisePriceLevels = (amounts: number[]) => {
    const allowed = new Set(data.priceLevels);
    return Array.from(new Set(amounts))
      .filter((amount) => allowed.has(amount))
      .sort((a, b) => a - b);
  };

  const getSelectedPriceLevels = () => {
    if (priceLevelInputs.length === 0) return data.priceLevels;
    const selected = normalisePriceLevels(
      priceLevelInputs
        .filter((priceInput) => priceInput.checked)
        .map((priceInput) => Number(priceInput.value))
    );
    return selected.length > 0 ? selected : data.priceLevels;
  };

  const buildPriceLevelPromptParts = (amounts: number[]) => {
    const sorted = normalisePriceLevels(amounts);
    const safeLevels = sorted.length > 0 ? sorted : data.priceLevels;
    const highest = safeLevels[safeLevels.length - 1];
    const levelLines = safeLevels.map((amount) => `- **€${amount} or below**`).join('\n');
    const labelLines = safeLevels.map((amount) => `- Under €${amount}`).join('\n');
    const fallbackLabelLines = safeLevels.map((amount) => `- Fallback above €${amount}`).join('\n');
    const fallbackLabels = safeLevels.map((amount) => `**Fallback above €${amount}**`).join(', ');
    const selectedPhrase = safeLevels.length === 1
      ? 'this selected nightly price level'
      : 'these selected nightly price levels in order';
    const fallbackRule = safeLevels.length === 1
      ? `If a selected country or region has no credible hotel at **€${highest} or below**, do not leave the result blank. Display: **No credible hotel option found under €${highest}**, then show the **next best 3 hotels above that level**, ranked by value and clearly marked as **Fallback above €${highest}** results.`
      : `If a selected country or region has no credible hotel at **€${safeLevels[0]} or below**, do not leave the result blank. Display: **No credible hotel option found under €${safeLevels[0]}**, then show the **next best 3 hotels above that level**, ranked by value and clearly marked as **Fallback above €${safeLevels[0]}** results. Continue the wider search up to the highest selected level (€${highest}). Apply the same fallback pattern to any selected level with no credible hotel options, using the matching fallback label for that level (${fallbackLabels}). If no credible hotel appears within the selected levels, list the next best 3 hotels above €${highest} and clearly mark them as **Fallback above €${highest}** results.`;

    return {
      searchRule: `Always search ${selectedPhrase}:\n${levelLines}\n\nUse shoulder-season standard-room nightly rates, before taxes unless the source only shows tax-inclusive totals. Record the lowest selected level each hotel can meet, but do not promise that the rate is always available.\n\n${fallbackRule}`,
      labels: `${labelLines}\n${fallbackLabelLines}`,
      disqualificationRule: `Regularly prices above €${highest} per night even in shoulder season, unless included only as one of the clearly marked fallback hotels requested because no selected price level produced credible hotel options`,
    };
  };

  const applyPriceLevelTokens = (text: string, amounts: number[]) => {
    const parts = buildPriceLevelPromptParts(amounts);
    return substituteAll(
      substituteAll(
        substituteAll(text, '[PRICE_LEVEL_SEARCH_RULE]', parts.searchRule),
        '[PRICE_LEVEL_LABELS]',
        parts.labels
      ),
      '[PRICE_LEVEL_DISQUALIFICATION_RULE]',
      parts.disqualificationRule
    );
  };

  const applyPersonalTokens = (text: string) =>
    substituteAll(
      substituteAll(text, '[PERSONAL_WEIGHTING_SECTION]', personalParts.weightingSection),
      '[PERSONAL_OUTPUT_NOTES]',
      personalParts.outputNotes
    ).replace(/\n{3,}/g, '\n\n');

  const getCity = () => cityInput.value.trim();
  const getTripScenario = () => tripScenarioInput.value.trim();
  const getTravelDates = () => travelDatesInput.value.trim();
  const getNights = () => nightsInput.value.trim();
  const getSelectedDealBreakers = () =>
    dealBreakerInputs.filter((dealBreakerInput) => dealBreakerInput.checked).map((dealBreakerInput) => dealBreakerInput.value);

  const buildCityFocusSection = (country: string | null, city: string): string => {
    if (!city) return '';
    const place = country ? `${city}, ${country}` : city;
    const regionName = country ?? 'the wider region';
    if (transportRadiusInput?.checked) {
      // Transport-radius mode: the named city is an anchor point, not the
      // assumed base. This replaces the day-trip city focus entirely.
      return (
        `**Where I want to stay:** Search all towns within **60 minutes by public transport (train preferred)** of **${place}**. ` +
        `Treat ${city} as the anchor point for the search, not the place I must stay: a smaller or less famous town with a fast, reliable connection is just as valid as ${city} itself. ` +
        `Do not favour famous towns or tourist centres simply because they are well known. ` +
        `Rank locations by value, review quality, quietness and transport convenience to ${city}. ` +
        `When you score location usefulness, judge it by that transport convenience — award no points for fame, prestige or being the classic tourist base. ` +
        `This transport rule overrides the wider country search.\n\n`
      );
    }
    return (
      `**Where I want to stay:** Focus on **${place}** and the places within easy reach of it — roughly a day trip from ${city}. ` +
      `Treat ${city} as my base rather than ranging across the whole of ${regionName}; this city focus overrides the wider country search. ` +
      `Only consider ${city} itself and the neighbourhoods, beaches, islands or day trips I could realistically use from there.\n\n`
    );
  };

  const buildTripDetailsSection = ({
    scenario,
    travelDates,
    nights,
    dealBreakers,
  }: {
    scenario: string;
    travelDates: string;
    nights: string;
    dealBreakers: string[];
  }): string => {
    const lines: string[] = [];

    if (travelDates) lines.push(`- Travel dates or season: ${travelDates}`);
    if (nights) lines.push(`- Number of nights: ${nights}`);
    if (scenario) lines.push(`- Trip scenario: ${scenario}`);
    if (dealBreakers.length) lines.push(`- Deal-breakers: ${dealBreakers.join('; ')}`);

    if (!lines.length) return '';

    return `### My trip details\n\n${lines.join('\n')}\n\n`;
  };

  const escapeForHtml = (value: string) =>
    value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  const updateSearchSuggestions = () => {
    if (!searchSuggestions) return;

    const city = getCity();
    const country = selectedCountry;
    const destination = city && country ? `${city}, ${country}` : city || country;
    const prices = getSelectedPriceLevels();
    const maxPrice = Math.max(...prices);
    const travelDates = getTravelDates();
    const dateSuffix = travelDates ? ` ${travelDates}` : '';

    if (!destination) {
      searchSuggestions.innerHTML = '<li>Select a destination to generate suggested searches.</li>';
      return;
    }

    const queries = isOrdinaryFinder
      ? [
          `Booking.com hotels ${destination} 8+ review score${dateSuffix}`,
          `Google Hotels ${destination} hotel under €${maxPrice} good reviews${dateSuffix}`,
          `best affordable hotels ${destination} recent reviews`,
          `where to stay ${destination} safe central good value hotel`,
        ]
      : [
          `Booking.com five-star hotels ${destination}${dateSuffix}`,
          `Google Hotels ${destination} 5 star under €${maxPrice}${dateSuffix}`,
          `best hotels ${destination} recent reviews`,
          `luxury hotel ${destination} good value`,
        ];

    searchSuggestions.innerHTML = queries
      .map((query) => `<li><code class="rounded bg-white px-2 py-1 text-xs">${escapeForHtml(query)}</code></li>`)
      .join('');
  };

  const buildPrompt = (country: string | null, city: string): string => {
    let text = applyPriceLevelTokens(data.template, getSelectedPriceLevels());
    text = substituteAll(text, '[COVERAGE]', data.coverage);
    text = substituteAll(text, '[CITY_FOCUS_SECTION]', buildCityFocusSection(country, city));
    text = substituteAll(
      text,
      '[TRIP_SCENARIO_SECTION]',
      buildTripDetailsSection({
        scenario: getTripScenario(),
        travelDates: getTravelDates(),
        nights: getNights(),
        dealBreakers: getSelectedDealBreakers(),
      })
    );
    text = substituteAll(text, '[OUTPUT_MODE_SECTION]', getOutputModeSection());
    const hotels = country ? data.hotelsByCountry[country] : undefined;
    if (country) {
      const existing = hotels
        ? hotels.map((h) => `- ${h.name} — value score ${h.score}`).join('\n')
        : `No hotels are yet published for ${country}, so there is no in-country incumbent to beat.`;
      text = substituteAll(text, '[REGION]', country);
      text = substituteAll(text, '[EXISTING HOTELS]', existing);
    }
    return applyPersonalTokens(text);
  };

  const refreshPrompts = () => {
    const city = getCity();
    textarea.value = buildPrompt(selectedCountry, city);
  };

  document.addEventListener('personalise:change', (event) => {
    personalParts = (event as CustomEvent<{
      weightingSection: string;
      outputNotes: string;
      travellerProfile?: string;
      travellerPriorities?: string;
      additionalNotes?: string;
    }>).detail;
    refreshPrompts();
  });

  cityInput.addEventListener('input', () => {
    refreshPrompts();
    updateSearchSuggestions();
  });

  transportRadiusInput?.addEventListener('change', () => {
    refreshPrompts();
    track('finder_transport_radius_toggled', { enabled: transportRadiusInput.checked });
  });

  tripScenarioInput.addEventListener('input', () => {
    refreshPrompts();
  });

  travelDatesInput.addEventListener('input', () => {
    refreshPrompts();
    updateSearchSuggestions();
  });

  nightsInput.addEventListener('input', () => {
    refreshPrompts();
    updateSearchSuggestions();
  });

  for (const dealBreakerInput of dealBreakerInputs) {
    dealBreakerInput.addEventListener('change', () => {
      refreshPrompts();
      updateSearchSuggestions();
    });
  }

  for (const modeInput of outputModeInputs) {
    modeInput.addEventListener('change', () => {
      setOutputMode(modeInput.value);
      refreshPrompts();
    });
  }

  const updatePriceLevelUi = (changedInput?: HTMLInputElement) => {
    if (priceLevelInputs.length === 0) return;
    let checkedInputs = priceLevelInputs.filter((priceInput) => priceInput.checked);
    if (checkedInputs.length === 0 && changedInput) {
      changedInput.checked = true;
      checkedInputs = [changedInput];
    }

    for (const priceInput of priceLevelInputs) {
      const card = priceInput.closest<HTMLElement>('[data-price-level-card]');
      const state = card?.querySelector<HTMLElement>('[data-price-level-state]');
      const selected = priceInput.checked;
      if (card) card.dataset.selected = selected ? 'true' : 'false';
      if (state) {
        state.textContent = selected ? 'Included' : 'Skipped';
        state.className = selected
          ? 'mt-4 inline-flex rounded-full bg-white px-3 py-1 text-xs font-semibold text-[#5C7355]'
          : 'mt-4 inline-flex rounded-full bg-white/70 px-3 py-1 text-xs font-semibold text-[#5C544A]';
      }
    }

    const selectedAmounts = getSelectedPriceLevels();
    const selectedText = formatEuroSeries(selectedAmounts);
    const fallbackLabels = selectedAmounts.map((amount) => `“Fallback above €${amount}”`).join(', ');
    if (priceLevelSummary) {
      priceLevelSummary.textContent = isOrdinaryFinder
        ? selectedAmounts.length === data.priceLevels.length
          ? 'The generated prompt searches all four nightly levels in order: €50, €100, €200 and €250. If no dependable option appears at €50 or below, it displays “No credible hotel option found under €50” and marks the next best three hotels above that level as “Fallback above €50”.'
          : `The generated prompt will search ${selectedText} only, in ascending order. If a selected level has no dependable hotel, it displays “No credible hotel option found under that level” and uses ${fallbackLabels} for the next best three hotels above it.`
        : selectedAmounts.length === data.priceLevels.length
          ? 'The generated prompt searches all four nightly levels in order: €50, €100, €200 and €250. If no credible option appears at €50 or below, it displays “No credible hotel option found under €50” and marks the next best three hotels above that level as “Fallback above €50”.'
          : `The generated prompt will search ${selectedText} only, in ascending order. If a selected level has no credible hotel, it displays “No credible hotel option found under that level” and uses ${fallbackLabels} for the next best three hotels above it.`;
    }
    if (priceLevelStatus) {
      priceLevelStatus.textContent = `Using ${selectedText} in the prompt. Select at least one price level.`;
    }
    refreshPrompts();
    updateSearchSuggestions();
  };

  const setCopyEnabled = (enabled: boolean) => {
    clearTimeout(copiedTimer);
    for (const btn of copyButtons) btn.disabled = !enabled;
    for (const label of copyLabels) {
      label.textContent = enabled
        ? isOrdinaryFinder ? 'Copy ordinary hotel prompt ->' : 'Copy my prompt ->'
        : 'Select a destination before copying';
    }
    for (const status of copyStatuses) status.textContent = '';
    if (briefReadyStatus) {
      briefReadyStatus.textContent = enabled
        ? isOrdinaryFinder ? 'Your ordinary hotel brief is ready to copy.' : 'Your hotel-finding brief is ready to copy.'
        : 'Choose a destination to make the brief copy-ready.';
    }
  };

  const setActive = (index: number) => {
    if (activeIndex >= 0 && visible[activeIndex]) {
      visible[activeIndex].removeAttribute('data-active');
    }
    activeIndex = index;
    if (index >= 0 && visible[index]) {
      const option = visible[index];
      option.setAttribute('data-active', '');
      input.setAttribute('aria-activedescendant', option.id);
      option.scrollIntoView({ block: 'nearest' });
    } else {
      input.setAttribute('aria-activedescendant', '');
    }
  };

  const openList = () => {
    listbox.hidden = false;
    input.setAttribute('aria-expanded', 'true');
  };

  const closeList = () => {
    listbox.hidden = true;
    input.setAttribute('aria-expanded', 'false');
    setActive(-1);
  };

  const filterList = (query: string) => {
    const q = fold(query.trim());
    visible = [];
    for (const option of options) {
      const match = q === '' || fold(option.dataset.name!).includes(q);
      option.hidden = !match;
      if (match) visible.push(option);
    }
    noResults.hidden = visible.length > 0;
    setActive(-1);
  };

  const selectCountry = (name: string) => {
    selectedCountry = name;
    input.value = name;
    for (const option of options) {
      option.setAttribute('aria-selected', option.dataset.name === name ? 'true' : 'false');
    }
    refreshPrompts();
    updateSearchSuggestions();
    setCopyEnabled(true);
    closeList();
    track('finder_country_selected', { country: name });
    if (hotelPromptCard && !hasAutoOpenedHotelPrompt) {
      setPromptCardOpen(hotelPromptCard, true);
      hasAutoOpenedHotelPrompt = true;
    }
  };

  input.addEventListener('input', () => {
    filterList(input.value);
    openList();
  });

  input.addEventListener('click', () => {
    if (listbox.hidden) {
      filterList(input.value);
      openList();
    }
  });

  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      if (listbox.hidden) {
        filterList(input.value);
        openList();
      }
      if (visible.length === 0) return;
      const delta = event.key === 'ArrowDown' ? 1 : -1;
      const next = activeIndex < 0
        ? (delta === 1 ? 0 : visible.length - 1)
        : (activeIndex + delta + visible.length) % visible.length;
      setActive(next);
    } else if (event.key === 'Enter') {
      if (!listbox.hidden && activeIndex >= 0 && visible[activeIndex]) {
        event.preventDefault();
        selectCountry(visible[activeIndex].dataset.name!);
      }
    } else if (event.key === 'Escape') {
      closeList();
    }
  });

  input.addEventListener('blur', () => {
    // Delay so a click on an option can land first.
    setTimeout(() => {
      if (!listbox.contains(document.activeElement)) closeList();
    }, 150);
  });

  for (const option of options) {
    // mousedown fires before the input's blur, so selection wins.
    option.addEventListener('mousedown', (event) => {
      event.preventDefault();
      selectCountry(option.dataset.name!);
    });
  }

  for (const priceInput of priceLevelInputs) {
    priceInput.addEventListener('change', () => {
      updatePriceLevelUi(priceInput);
      track('finder_price_level_changed', { levels: getSelectedPriceLevels().join(',') });
    });
  }

  const copyTextareaText = async (source: HTMLTextAreaElement) => {
    try {
      await navigator.clipboard.writeText(source.value);
    } catch {
      source.select();
      document.execCommand('copy');
      source.setSelectionRange(0, 0);
      source.blur();
    }
  };

  const handleCopyPrompt = async (event: Event) => {
    // The top button lives inside the accordion <summary>; stop the click from
    // toggling the section open/closed.
    event.preventDefault();
    event.stopPropagation();
    await copyTextareaText(textarea);
    for (const label of copyLabels) label.textContent = 'Copied';
    for (const status of copyStatuses) {
      status.textContent = isOrdinaryFinder
        ? 'Ordinary hotel prompt copied to clipboard'
        : 'Hotel prompt copied to clipboard';
    }
    if (hotelCopySuccess) hotelCopySuccess.hidden = false;
    track('hotel_prompt_copied', { country: selectedCountry ?? '' });
    clearTimeout(copiedTimer);
    copiedTimer = setTimeout(() => {
      for (const label of copyLabels) {
        label.textContent = isOrdinaryFinder ? 'Copy ordinary hotel prompt ->' : 'Copy my prompt ->';
      }
      for (const status of copyStatuses) status.textContent = '';
    }, 2000);
  };
  for (const btn of copyButtons) btn.addEventListener('click', handleCopyPrompt);

  resetButton.addEventListener('click', () => {
    selectedCountry = null;
    input.value = '';
    cityInput.value = '';
    if (transportRadiusInput) transportRadiusInput.checked = false;
    travelDatesInput.value = '';
    nightsInput.value = '';
    tripScenarioInput.value = '';
    for (const dealBreakerInput of dealBreakerInputs) dealBreakerInput.checked = false;
    hasAutoOpenedHotelPrompt = false;
    if (hotelCopySuccess) hotelCopySuccess.hidden = true;
    for (const option of options) option.setAttribute('aria-selected', 'false');
    filterList('');
    closeList();
    refreshPrompts();
    updateSearchSuggestions();
    setCopyEnabled(false);
  });

  const prefillFromUrl = () => {
    let params: URLSearchParams;
    try {
      params = new URLSearchParams(window.location.search);
    } catch {
      return;
    }
    const cityParam = params.get('city');
    const scenarioParam = params.get('scenario');
    if (cityParam) cityInput.value = cityParam;
    if (scenarioParam) tripScenarioInput.value = scenarioParam;

    const countryParam = params.get('country');
    const match = countryParam
      ? options.find((option) => fold(option.dataset.name!) === fold(countryParam))
      : undefined;
    if (match) {
      selectCountry(match.dataset.name!);
    } else if (cityParam || scenarioParam) {
      refreshPrompts();
      updateSearchSuggestions();
    }
  };

  restoreOutputMode();
  updatePriceLevelUi();
  prefillFromUrl();
</script>
