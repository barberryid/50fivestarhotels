---
import type { HotelSeasonality } from '../data/hotelSeasonality';
import type { HotelAirQuality } from '../data/hotelAirQuality';
import AirQualityByMonth from './AirQualityByMonth.astro';

interface Props {
  seasonality: HotelSeasonality;
  airQuality?: HotelAirQuality;
}

const { seasonality, airQuality } = Astro.props;

const weatherMonths = seasonality.months.map(({ month, weather, tempC, tempF, humidity }) => ({
  month,
  label: weather,
  tempC,
  tempF,
  humidity,
}));

const priceMonths = seasonality.months.map(({ month, price }) => ({
  month,
  label: price,
}));

const cards = [
  {
    ...seasonality.weather,
    kind: 'weather' as const,
    ariaLabel: 'Weather comfort, temperature and humidity by month',
    helper: 'Weather comfort, average temperature and humidity.',
    months: weatherMonths,
  },
  {
    ...seasonality.price,
    kind: 'price' as const,
    ariaLabel: 'Typical price value by month',
    helper: 'Typical monthly price value.',
    months: priceMonths,
  },
];
---

<section class="seasonality-section" aria-labelledby="seasonality-heading">
  <div class="seasonality-header">
    <p class="seasonality-kicker">Seasonality</p>
    <h2 id="seasonality-heading">When to go</h2>
  </div>

  <div class="seasonality-cards">
    {cards.map(card => (
      <>
        <article class="seasonality-card" data-card-kind={card.kind}>
          <div class="seasonality-copy">
            <h3>{card.title}</h3>
            <p>{card.helper}</p>
            {card.summary && <p class="seasonality-note">{card.summary}</p>}
          </div>

          <div class="seasonality-scroll" role="region" aria-label={card.ariaLabel}>
            <ol class="seasonality-months">
              {card.months.map(month => (
                <li class="seasonality-month" data-label={month.label}>
                  <span class="seasonality-month-name">{month.month}</span>
                  <span class="seasonality-month-label">{month.label}</span>
                  {card.kind === 'weather' && (
                    <>
                      <span class="seasonality-temp">{month.tempC}&deg;C / {month.tempF}&deg;F</span>
                      <span class="seasonality-humidity" data-short={`${month.humidity}% hum.`}>{month.humidity}% humidity</span>
                    </>
                  )}
                </li>
              ))}
            </ol>
          </div>
        </article>

        {card.kind === 'weather' && airQuality && <AirQualityByMonth airQuality={airQuality} />}
      </>
    ))}
  </div>
</section>

<style>
  .seasonality-section {
    margin: 2rem 0;
  }

  .seasonality-header {
    margin-bottom: 0.9rem;
  }

  .seasonality-kicker {
    color: #b88a44;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin: 0 0 0.25rem;
    text-transform: uppercase;
  }

  .seasonality-header h2 {
    color: #1f2428;
    font-size: clamp(1.45rem, 2.5vw, 1.9rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
  }

  .seasonality-cards {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .seasonality-card {
    background: #fffdf8;
    border: 1px solid #e2d4bf;
    border-radius: 0.75rem;
    box-shadow: 0 10px 30px rgba(31, 36, 40, 0.04);
    min-width: 0;
    padding: 1rem;
  }

  .seasonality-copy {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 0.9rem;
  }

  .seasonality-copy h3 {
    color: #1f2428;
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
    margin: 0;
  }

  .seasonality-copy p {
    color: rgba(29, 36, 51, 0.72);
    font-size: 0.88rem;
    line-height: 1.55;
    margin: 0;
  }

  .seasonality-copy .seasonality-note {
    color: #6b7280;
    font-size: 0.78rem;
  }

  .seasonality-scroll {
    min-width: 0;
    overflow-x: auto;
    padding-bottom: 0.15rem;
  }

  .seasonality-months {
    display: grid;
    gap: 0.35rem;
    grid-template-columns: repeat(12, minmax(5.4rem, 1fr));
    list-style: none;
    margin: 0;
    min-width: 66rem;
    padding: 0;
  }

  .seasonality-month {
    align-items: center;
    background: #f8f2e8;
    border: 1px solid #e2d4bf;
    border-radius: 0.45rem;
    color: #1f2428;
    display: grid;
    gap: 0.2rem;
    justify-items: center;
    min-height: 3.8rem;
    padding: 0.45rem 0.35rem;
    text-align: center;
  }

  .seasonality-card[data-card-kind="weather"] .seasonality-month {
    min-height: 5.6rem;
  }

  .seasonality-month-name,
  .seasonality-month-label,
  .seasonality-temp,
  .seasonality-humidity {
    display: block;
    line-height: 1.1;
  }

  .seasonality-month-name {
    font-size: 0.72rem;
    font-weight: 800;
  }

  .seasonality-month-label {
    background: #f3f4f6;
    border: 1px solid #dfe3e8;
    border-radius: 999px;
    color: #374151;
    font-size: 0.62rem;
    font-weight: 800;
    padding: 0.2rem 0.35rem;
    text-align: center;
  }

  .seasonality-temp,
  .seasonality-humidity {
    color: rgba(29, 36, 51, 0.74);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .seasonality-month[data-label="Best"],
  .seasonality-month[data-label="Cheapest"] {
    background: #f1f8ec;
    border-color: #168148;
    color: #1f2428;
  }

  .seasonality-month[data-label="Best"] .seasonality-month-label,
  .seasonality-month[data-label="Cheapest"] .seasonality-month-label {
    background: #1f9a58;
    border-color: #168148;
    color: #ffffff;
  }

  .seasonality-month[data-label="Best"] .seasonality-temp,
  .seasonality-month[data-label="Best"] .seasonality-humidity,
  .seasonality-month[data-label="Cheapest"] .seasonality-temp,
  .seasonality-month[data-label="Cheapest"] .seasonality-humidity {
    color: rgba(29, 36, 51, 0.74);
  }

  .seasonality-month[data-label="Good"],
  .seasonality-month[data-label="Good value"] {
    background: #eaf4dd;
    border-color: #cfe4b6;
    color: #2f5d2f;
  }

  .seasonality-month[data-label="Good"] .seasonality-month-label,
  .seasonality-month[data-label="Good value"] .seasonality-month-label {
    background: #dbeec9;
    border-color: #bddc9f;
    color: #2f5d2f;
  }

  .seasonality-month[data-label="Possible"],
  .seasonality-month[data-label="Average"] {
    background: #fbf7ec;
    border-color: #eadfc5;
    color: #1f2428;
  }

  .seasonality-month[data-label="Possible"] .seasonality-month-label,
  .seasonality-month[data-label="Average"] .seasonality-month-label {
    background: #f3ead4;
    border-color: #dfcfac;
    color: #5d4b2e;
  }

  .seasonality-month[data-label="Avoid"],
  .seasonality-month[data-label="Expensive"] {
    background: #fae9dc;
    border-color: #efcfb7;
    color: #9a3f08;
  }

  .seasonality-month[data-label="Avoid"] .seasonality-month-label,
  .seasonality-month[data-label="Expensive"] .seasonality-month-label {
    background: #f2d3bd;
    border-color: #e5b58f;
    color: #8a3908;
  }

  .seasonality-month[data-label="Most expensive"] {
    background: #f4d4ce;
    border-color: #e7ada3;
    color: #8f241c;
  }

  .seasonality-month[data-label="Most expensive"] .seasonality-month-label {
    background: #e9b4ac;
    border-color: #da9388;
    color: #7e2019;
  }

  @media (max-width: 640px) {
    .seasonality-months {
      grid-template-columns: repeat(12, minmax(5.9rem, 1fr));
      min-width: 72rem;
    }

    .seasonality-card[data-card-kind="weather"] .seasonality-month {
      min-height: 5.2rem;
    }

    .seasonality-humidity {
      font-size: 0;
    }

    .seasonality-humidity::after {
      content: attr(data-short);
    }
  }

  @media (min-width: 900px) {
    .seasonality-card {
      padding: 1.1rem;
    }
  }
</style>
