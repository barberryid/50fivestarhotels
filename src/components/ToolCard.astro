---
interface Props {
  title: string;
  description: string;
  href: string;
  cta: string;
  variant?: 'gold' | 'green';
  stamp?: string;
}

const { title, description, href, cta, variant = 'gold', stamp } = Astro.props;
const isGreen = variant === 'green';
---

<article class={`tool-card tool-card-${variant}`}>
  {stamp && <span class="tool-card-stamp">{stamp}</span>}
  <div class="tool-card-icon" aria-hidden="true">
    {isGreen ? (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 2v4"></path>
        <path d="M16 2v4"></path>
        <path d="M3 10h18"></path>
        <rect x="3" y="4" width="18" height="18" rx="2.5"></rect>
        <path d="M8 15h.01"></path>
        <path d="M12 15h.01"></path>
        <path d="M16 15h.01"></path>
      </svg>
    ) : (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 6V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1"></path>
        <rect x="4" y="6" width="16" height="14" rx="2.5"></rect>
        <path d="M4 11h16"></path>
        <path d="M12 11v2"></path>
      </svg>
    )}
  </div>
  <div>
    <h2>{title}</h2>
    <p>{description}</p>
  </div>
  <a href={href} class={`tool-card-link ${isGreen ? 'tool-card-link-green' : 'tool-card-link-gold'}`} aria-label={`${cta}: ${title}`}>
    {cta}
    <span aria-hidden="true">&rarr;</span>
  </a>
</article>
