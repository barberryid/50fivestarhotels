---
// Standalone "Best time to go" tool used on /best-time-to-go/.
// A focused, self-contained version of the destination → prompt flow:
//   1. Country or territory (combobox) + optional city/town
//   2. When-to-go prompt (built by buildWhenToGoPrompt, copy to clipboard)
// Unlike the full Hotel Finder, this page has no price-level selector or
// traveller-fit weighting; the prompt uses all four default price levels.
import AccordionCard from './AccordionCard.astro';
import { countries } from '../data/unCountries';
import { researchPriceLevels } from '../data/researchPriceLevels';
import { buildWhenToGoPrompt } from '../data/researchPromptTemplate';

const defaultPriceLevels = researchPriceLevels.map(({ amount }) => amount);

const defaultWhenToGoPrompt = buildWhenToGoPrompt({
  countryOrTerritory: '[REGION]',
  selectedPriceLevels: defaultPriceLevels,
});

const toolData = {
  priceLevels: defaultPriceLevels,
};

const timingPriorityOptions = [
  'Best hotel value',
  'Comfortable weather',
  'Fewer crowds',
  'Lower heat risk',
  'Lower rain risk',
  'Cleaner air',
  'Easier transport',
  'Festivals/events',
  'Quiet atmosphere',
  'Good walking conditions',
];

const riskCheckOptions = [
  'Extreme heat',
  'Heavy rain or storms',
  'Poor air quality',
  'School holidays',
  'Major events',
  'Transport disruption',
  'Low-season closures',
  'Peak hotel pricing',
];
---

<div class="space-y-5" data-when-to-go-tool>
  <AccordionCard title="Where are you thinking of going?" number={1} open={true}>
    <p class="mb-6 text-[#2A2622]/80 leading-relaxed">
      Start with the country, region, island or city you are considering. Add a city or town if the timing depends on a specific base.
    </p>
    <!-- Country combobox -->
    <label id="country-label" for="country-input" class="sr-only">
      Country or territory
    </label>
    <div class="relative max-w-md">
      <input
        type="text"
        id="country-input"
        role="combobox"
        aria-expanded="false"
        aria-controls="country-listbox"
        aria-autocomplete="list"
        aria-activedescendant=""
        autocomplete="off"
        spellcheck="false"
        placeholder="Start typing — e.g. Vietnam, Côte d’Ivoire…"
        class="w-full rounded-xl border border-[#E6DBBE] bg-white px-4 py-3 text-[#2A2622] placeholder-[#5C544A]/60 focus:outline-none focus:ring-2 focus:ring-[#A0682E]/60 focus:border-[#A0682E]"
      />
      <ul
        id="country-listbox"
        role="listbox"
        aria-labelledby="country-label"
        hidden
        class="absolute z-20 mt-1 w-full max-h-72 overflow-y-auto rounded-xl border border-[#E6DBBE] bg-white shadow-lg py-1"
      >
        {countries.map((c) => (
          <li
            id={`country-option-${c.code}`}
            role="option"
            aria-selected="false"
            data-name={c.name}
            class="cursor-pointer px-4 py-2 text-sm text-[#2A2622] aria-selected:bg-[#F4EADC] data-[active]:bg-[#F4EADC]"
          >
            {c.name}
          </li>
        ))}
        <li id="country-no-results" hidden class="px-4 py-2 text-sm text-[#5C544A] italic" role="presentation">
          No matching country or territory
        </li>
      </ul>
    </div>

    <!-- City or town (optional, freeform) -->
    <label for="city-input" class="mt-6 block text-sm font-semibold text-[#2A2622] mb-2">
      City or town <span class="font-normal text-[#5C544A]">(optional)</span>
    </label>
    <div class="max-w-md">
      <input
        type="text"
        id="city-input"
        autocomplete="off"
        spellcheck="false"
        placeholder="e.g. Hoi An, Oaxaca, Luang Prabang…"
        class="w-full rounded-xl border border-[#E6DBBE] bg-white px-4 py-3 text-[#2A2622] placeholder-[#5C544A]/60 focus:outline-none focus:ring-2 focus:ring-[#A0682E]/60 focus:border-[#A0682E]"
      />
      <p class="mt-2 text-sm text-[#5C544A]">
        Leave blank to research the whole country. Enter a city or town to focus the search on it and the destinations within easy reach.
      </p>
    </div>
  </AccordionCard>

  <AccordionCard title="What months or seasons are possible?" number={2}>
    <label for="months-input" class="block text-sm font-semibold text-[#2A2622] mb-2">
      Possible months or seasons <span class="font-normal text-[#5C544A]">(optional)</span>
    </label>
    <div class="max-w-2xl">
      <input
        type="text"
        id="months-input"
        autocomplete="off"
        spellcheck="false"
        placeholder="e.g. March to June, autumn, any month except August"
        class="w-full rounded-xl border border-[#E6DBBE] bg-white px-4 py-3 text-[#2A2622] placeholder-[#5C544A]/60 focus:outline-none focus:ring-2 focus:ring-[#A0682E]/60 focus:border-[#A0682E]"
      />
      <p class="mt-2 text-sm text-[#5C544A]">
        Leave this blank if the whole year is possible. Add constraints if school holidays, heat or flight dates already narrow the trip.
      </p>
    </div>
  </AccordionCard>

  <AccordionCard title="What matters most: price, weather, quietness or convenience?" number={3}>
    <p class="mb-4 text-sm leading-relaxed text-[#5C544A]">
      Pick the timing priorities that should shape the month-by-month comparison.
    </p>
    <div class="grid gap-2 sm:grid-cols-2">
      {timingPriorityOptions.map((option) => (
        <label class="spark-chip flex cursor-pointer items-start gap-3 rounded-lg border border-[#E6DBBE] bg-white px-4 py-3 text-sm transition-colors has-[:checked]:border-[#5C7355] has-[:checked]:bg-[#E6EBDD]">
          <input
            type="checkbox"
            value={option}
            data-timing-priority-input
            class="mt-1 h-4 w-4 shrink-0 rounded border-[#E6DBBE] text-[#5C7355] accent-[#5C7355]"
          />
          <span class="text-[#2A2622]">{option}</span>
        </label>
      ))}
    </div>
  </AccordionCard>

  <AccordionCard title="What risks should the AI check?" number={4}>
    <p class="mb-4 text-sm leading-relaxed text-[#5C544A]">
      Add practical watch-outs so the prompt does not recommend a month just because hotel prices look low.
    </p>
    <div class="grid gap-2 sm:grid-cols-2">
      {riskCheckOptions.map((option) => (
        <label class="spark-chip flex cursor-pointer items-start gap-3 rounded-lg border border-[#E6DBBE] bg-white px-4 py-3 text-sm transition-colors has-[:checked]:border-[#A0682E] has-[:checked]:bg-[#FBF6E9]">
          <input
            type="checkbox"
            value={option}
            data-risk-check-input
            class="mt-1 h-4 w-4 shrink-0 rounded border-[#E6DBBE] text-[#A0682E] accent-[#A0682E]"
          />
          <span class="text-[#2A2622]">{option}</span>
        </label>
      ))}
    </div>
  </AccordionCard>

  <AccordionCard title="Generate your best-time-to-go prompt" number={5}>
    <button
      slot="actions"
      type="button"
      disabled
      data-copy-when-to-go-button
      class="toolkit-button toolkit-button-green shrink-0 px-4 py-2 text-xs md:px-5 md:py-2.5 md:text-sm disabled:cursor-not-allowed disabled:bg-[#C4B9A6] disabled:shadow-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span data-copy-when-to-go-label>Select a destination before copying</span>
    </button>
    <span slot="actions" class="sr-only" role="status" aria-live="polite" data-copy-when-to-go-status></span>
    <div class="space-y-3">
      <section aria-labelledby="when-to-go-prompt-heading" data-nosnippet class="prompt-paper overflow-hidden" data-prompt-card>
      <button
        type="button"
        class="group flex w-full items-start justify-between gap-4 px-4 py-4 text-left transition-colors hover:bg-white/60 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-[#5C7355]/50 md:px-5"
        aria-expanded="false"
        aria-controls="when-to-go-prompt-panel"
        data-prompt-toggle
      >
        <span class="min-w-0">
          <span class="flex flex-wrap items-center gap-2">
            <span id="when-to-go-prompt-heading" class="block text-sm font-semibold text-[#2A2622]">
              Your month-by-month travel prompt is ready
            </span>
          </span>
          <span class="mt-1 block text-sm leading-relaxed text-[#5C544A]">
            Paste this into your AI tool to compare months before you start checking live hotel prices.
          </span>
        </span>
        <span class="mt-0.5 inline-flex shrink-0 items-center gap-2 rounded-lg bg-[#5C7355] px-3.5 py-1.5 text-xs font-bold text-white shadow-[0_4px_0_#344532] transition-colors group-hover:bg-[#344532]">
          <span data-prompt-toggle-label>Show prompt</span>
          <svg data-prompt-chevron xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 transition-transform" aria-hidden="true">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </span>
      </button>
      <div id="when-to-go-prompt-panel" class="border-t border-[#E6DBBE] p-4 md:p-5" data-prompt-panel hidden>
        <div class="mb-3 flex flex-wrap items-center justify-end gap-3">
          <button
            type="button"
            id="copy-when-to-go-prompt-button"
            disabled
            data-copy-when-to-go-button
            class="toolkit-button toolkit-button-green shrink-0 px-5 py-2.5 text-sm disabled:cursor-not-allowed disabled:bg-[#C4B9A6] disabled:shadow-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-when-to-go-prompt-label" data-copy-when-to-go-label>Select a destination before copying</span>
          </button>
          <span id="copy-when-to-go-prompt-status" data-copy-when-to-go-status class="sr-only" role="status" aria-live="polite"></span>
        </div>
        <label for="when-to-go-textarea" class="sr-only">When to go prompt text</label>
        <textarea
          id="when-to-go-textarea"
          rows="18"
          spellcheck="false"
          class="w-full rounded-lg border border-[#E6DBBE] bg-white/80 px-4 py-3 text-sm leading-relaxed text-[#2A2622] focus:outline-none focus:ring-2 focus:ring-[#A0682E]/60 focus:border-[#A0682E]"
        >{defaultWhenToGoPrompt}</textarea>
        <div id="when-to-go-copy-success" hidden class="spark-brief mt-4 p-4">
          <p class="text-sm font-semibold text-[#2A2622] mb-1">Timing prompt copied.</p>
          <p class="text-sm leading-relaxed text-[#2A2622]/80 mb-3">
            Open ChatGPT or Claude, start a fresh session, and paste the brief there.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="https://chatgpt.com/"
              target="_blank"
              rel="noopener noreferrer"
              data-open-chatgpt
              class="inline-flex items-center gap-2 rounded-full bg-[#2A2622] px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#5C7355] no-underline"
            >
              Open ChatGPT →
            </a>
            <a
              href="https://claude.ai/"
              target="_blank"
              rel="noopener noreferrer"
              data-open-claude
              class="inline-flex items-center gap-2 rounded-full border border-[#2A2622] px-5 py-2.5 text-sm font-semibold text-[#2A2622] transition-colors hover:bg-[#2A2622] hover:text-white no-underline"
            >
              Open Claude →
            </a>
          </div>
        </div>
      </div>
    </section>
    </div>
  </AccordionCard>

  <!-- Reset -->
  <div class="pt-1">
    <button
      type="button"
      id="reset-country-button"
      class="toolkit-button toolkit-button-secondary text-xs"
    >
      Try another destination
    </button>
  </div>
</div>

<script is:inline type="application/json" id="when-to-go-data" set:html={JSON.stringify(toolData)} />

<script>
  import { buildWhenToGoPrompt } from '../data/researchPromptTemplate';

  const data = JSON.parse(document.getElementById('when-to-go-data')!.textContent!) as {
    priceLevels: number[];
  };

  const input = document.getElementById('country-input') as HTMLInputElement;
  const cityInput = document.getElementById('city-input') as HTMLInputElement;
  const monthsInput = document.getElementById('months-input') as HTMLInputElement;
  const timingPriorityInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-timing-priority-input]'));
  const riskCheckInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-risk-check-input]'));
  const listbox = document.getElementById('country-listbox') as HTMLUListElement;
  const noResults = document.getElementById('country-no-results') as HTMLLIElement;
  const whenToGoTextarea = document.getElementById('when-to-go-textarea') as HTMLTextAreaElement;
  // Two copy buttons share the same state and action: one at the top of the
  // step and one inside the prompt panel.
  const copyButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-copy-when-to-go-button]'));
  const copyLabels = Array.from(document.querySelectorAll<HTMLElement>('[data-copy-when-to-go-label]'));
  const copyStatuses = Array.from(document.querySelectorAll<HTMLElement>('[data-copy-when-to-go-status]'));
  const resetButton = document.getElementById('reset-country-button') as HTMLButtonElement;
  const copySuccess = document.getElementById('when-to-go-copy-success') as HTMLElement | null;
  const options = Array.from(listbox.querySelectorAll<HTMLLIElement>('[role="option"]'));

  const track = (eventName: string, props: Record<string, unknown> = {}) => {
    const fn = (window as unknown as { ffshTrack?: (name: string, props?: Record<string, unknown>) => void }).ffshTrack;
    if (typeof fn === 'function') fn(eventName, props);
  };

  for (const link of Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-open-chatgpt]'))) {
    link.addEventListener('click', () => track('open_chatgpt_clicked'));
  }
  for (const link of Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-open-claude]'))) {
    link.addEventListener('click', () => track('open_claude_clicked'));
  }

  // Show/hide the prompt panel.
  const promptCard = document.querySelector<HTMLElement>('[data-prompt-card]');
  const setPromptCardOpen = (card: HTMLElement, open: boolean) => {
    const toggle = card.querySelector<HTMLButtonElement>('[data-prompt-toggle]');
    const panel = card.querySelector<HTMLElement>('[data-prompt-panel]');
    const label = card.querySelector<HTMLElement>('[data-prompt-toggle-label]');
    const chevron = card.querySelector<SVGElement>('[data-prompt-chevron]');
    if (!toggle || !panel) return;
    if (open) card.closest('details')?.setAttribute('open', '');
    toggle.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    if (label) label.textContent = open ? 'Hide prompt' : 'Show prompt';
    chevron?.classList.toggle('rotate-180', open);
  };
  if (promptCard) {
    const toggle = promptCard.querySelector<HTMLButtonElement>('[data-prompt-toggle]');
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setPromptCardOpen(promptCard, open);
    });
  }

  // Case- and accent-insensitive fold ("cote" matches "Côte d’Ivoire").
  const fold = (s: string) =>
    s
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .replace(/[’ʼ]/g, "'")
      .toLowerCase();

  let activeIndex = -1;
  let visible: HTMLLIElement[] = options;
  let copiedTimer: ReturnType<typeof setTimeout> | undefined;
  let selectedCountry: string | null = null;
  let hasAutoOpenedPrompt = false;

  const getCity = () => cityInput.value.trim();
  const getMonths = () => monthsInput.value.trim();
  const getSelectedTimingPriorities = () =>
    timingPriorityInputs.filter((priorityInput) => priorityInput.checked).map((priorityInput) => priorityInput.value);
  const getSelectedRiskChecks = () =>
    riskCheckInputs.filter((riskInput) => riskInput.checked).map((riskInput) => riskInput.value);

  const buildTravellerPriorities = () => getSelectedTimingPriorities().join('; ');

  const buildAdditionalNotes = () => {
    const lines: string[] = [];
    const months = getMonths();
    const risks = getSelectedRiskChecks();
    if (months) lines.push(`Possible months or seasons: ${months}`);
    if (risks.length) lines.push(`Risks to check: ${risks.join('; ')}`);
    return lines.join('\n');
  };

  const buildWhenToGoPromptFromState = (country: string | null, city: string): string =>
    buildWhenToGoPrompt({
      countryOrTerritory: country ?? '[REGION]',
      cityOrTown: city,
      selectedPriceLevels: data.priceLevels,
      travellerPriorities: buildTravellerPriorities(),
      additionalNotes: buildAdditionalNotes(),
    });

  const refreshPrompt = () => {
    whenToGoTextarea.value = buildWhenToGoPromptFromState(selectedCountry, getCity());
  };

  const setCopyEnabled = (enabled: boolean) => {
    clearTimeout(copiedTimer);
    for (const btn of copyButtons) btn.disabled = !enabled;
    for (const label of copyLabels) label.textContent = enabled ? 'Copy timing prompt ->' : 'Select a destination before copying';
    for (const status of copyStatuses) status.textContent = '';
  };

  const setActive = (index: number) => {
    if (activeIndex >= 0 && visible[activeIndex]) {
      visible[activeIndex].removeAttribute('data-active');
    }
    activeIndex = index;
    if (index >= 0 && visible[index]) {
      const option = visible[index];
      option.setAttribute('data-active', '');
      input.setAttribute('aria-activedescendant', option.id);
      option.scrollIntoView({ block: 'nearest' });
    } else {
      input.setAttribute('aria-activedescendant', '');
    }
  };

  const openList = () => {
    listbox.hidden = false;
    input.setAttribute('aria-expanded', 'true');
  };

  const closeList = () => {
    listbox.hidden = true;
    input.setAttribute('aria-expanded', 'false');
    setActive(-1);
  };

  const filterList = (query: string) => {
    const q = fold(query.trim());
    visible = [];
    for (const option of options) {
      const match = q === '' || fold(option.dataset.name!).includes(q);
      option.hidden = !match;
      if (match) visible.push(option);
    }
    noResults.hidden = visible.length > 0;
    setActive(-1);
  };

  const selectCountry = (name: string) => {
    selectedCountry = name;
    input.value = name;
    for (const option of options) {
      option.setAttribute('aria-selected', option.dataset.name === name ? 'true' : 'false');
    }
    refreshPrompt();
    setCopyEnabled(true);
    closeList();
    track('when_to_go_country_selected', { country: name });
    if (promptCard && !hasAutoOpenedPrompt) {
      setPromptCardOpen(promptCard, true);
      hasAutoOpenedPrompt = true;
    }
  };

  input.addEventListener('input', () => {
    filterList(input.value);
    openList();
  });

  input.addEventListener('click', () => {
    if (listbox.hidden) {
      filterList(input.value);
      openList();
    }
  });

  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      if (listbox.hidden) {
        filterList(input.value);
        openList();
      }
      if (visible.length === 0) return;
      const delta = event.key === 'ArrowDown' ? 1 : -1;
      const next = activeIndex < 0
        ? (delta === 1 ? 0 : visible.length - 1)
        : (activeIndex + delta + visible.length) % visible.length;
      setActive(next);
    } else if (event.key === 'Enter') {
      if (!listbox.hidden && activeIndex >= 0 && visible[activeIndex]) {
        event.preventDefault();
        selectCountry(visible[activeIndex].dataset.name!);
      }
    } else if (event.key === 'Escape') {
      closeList();
    }
  });

  input.addEventListener('blur', () => {
    // Delay so a click on an option can land first.
    setTimeout(() => {
      if (!listbox.contains(document.activeElement)) closeList();
    }, 150);
  });

  for (const option of options) {
    // mousedown fires before the input's blur, so selection wins.
    option.addEventListener('mousedown', (event) => {
      event.preventDefault();
      selectCountry(option.dataset.name!);
    });
  }

  cityInput.addEventListener('input', () => {
    refreshPrompt();
  });

  monthsInput.addEventListener('input', () => {
    refreshPrompt();
  });

  for (const priorityInput of timingPriorityInputs) {
    priorityInput.addEventListener('change', () => {
      refreshPrompt();
    });
  }

  for (const riskInput of riskCheckInputs) {
    riskInput.addEventListener('change', () => {
      refreshPrompt();
    });
  }

  const copyTextareaText = async (source: HTMLTextAreaElement) => {
    try {
      await navigator.clipboard.writeText(source.value);
    } catch {
      source.select();
      document.execCommand('copy');
      source.setSelectionRange(0, 0);
      source.blur();
    }
  };

  const handleCopyWhenToGo = async (event: Event) => {
    // The top button lives inside the accordion <summary>; stop the click from
    // toggling the section open/closed.
    event.preventDefault();
    event.stopPropagation();
    await copyTextareaText(whenToGoTextarea);
    for (const label of copyLabels) label.textContent = 'Copied';
    for (const status of copyStatuses) status.textContent = 'When-to-go prompt copied to clipboard';
    if (copySuccess) copySuccess.hidden = false;
    track('when_to_go_prompt_copied', { country: selectedCountry ?? '' });
    clearTimeout(copiedTimer);
    copiedTimer = setTimeout(() => {
      for (const label of copyLabels) label.textContent = 'Copy timing prompt ->';
      for (const status of copyStatuses) status.textContent = '';
    }, 2000);
  };
  for (const btn of copyButtons) btn.addEventListener('click', handleCopyWhenToGo);

  resetButton.addEventListener('click', () => {
    selectedCountry = null;
    input.value = '';
    cityInput.value = '';
    monthsInput.value = '';
    for (const priorityInput of timingPriorityInputs) priorityInput.checked = false;
    for (const riskInput of riskCheckInputs) riskInput.checked = false;
    hasAutoOpenedPrompt = false;
    if (copySuccess) copySuccess.hidden = true;
    for (const option of options) option.setAttribute('aria-selected', 'false');
    filterList('');
    closeList();
    refreshPrompt();
    setCopyEnabled(false);
  });

  const prefillFromUrl = () => {
    let params: URLSearchParams;
    try {
      params = new URLSearchParams(window.location.search);
    } catch {
      return;
    }
    const cityParam = params.get('city');
    if (cityParam) cityInput.value = cityParam;

    const countryParam = params.get('country');
    const match = countryParam
      ? options.find((option) => fold(option.dataset.name!) === fold(countryParam))
      : undefined;
    if (match) {
      selectCountry(match.dataset.name!);
    } else if (cityParam) {
      refreshPrompt();
    }
  };

  prefillFromUrl();
</script>
