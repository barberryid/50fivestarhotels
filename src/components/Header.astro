---
const navLinks = [
  { href: '/hotel-finder', label: 'Hotel Finder' },
  { href: '/best-time-to-go', label: 'Best Time to Go' },
  { href: '/all-hotels', label: 'Example Hotels' },
  { href: '/guides/why-some-five-star-hotels-are-so-cheap', label: 'Guides' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-50 bg-[#F8F5EF]/95 backdrop-blur border-b border-[#1D2433]/8">
  <div class="px-[clamp(1rem,4vw,3rem)] flex items-center justify-between h-16">
    <a href="/" class="inline-flex items-center gap-3 font-serif text-lg font-bold text-[#1D2433] hover:text-[#B88A44] transition-colors no-underline">
      <img
        class="h-10 w-10 shrink-0 object-contain"
        src="/images/hotels/yellow-star-on-black-star.svg"
        alt="50 Five-Star Hotels logo"
        width="40"
        height="40"
      />
      <span>50 Five-Star Hotels</span>
    </a>

    <nav class="hidden md:flex items-center gap-5" aria-label="Main navigation">
      {navLinks.filter(l => l.href !== '/').map(link => (
        <a
          href={link.href}
          class={`rounded-lg px-2.5 py-2 text-sm font-semibold transition-colors no-underline ${
            currentPath === link.href
              ? 'bg-[#FBF4E8] text-[#1D2433] shadow-[3px_3px_0_rgba(184,138,68,0.16)]'
              : 'text-[#6B7280] hover:bg-white hover:text-[#1D2433]'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <button
      id="mobile-menu-btn"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="md:hidden p-2 rounded-lg text-[#1D2433] hover:bg-[#1D2433]/5 transition-colors"
    >
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="19" y2="6"/>
        <line x1="3" y1="11" x2="19" y2="11"/>
        <line x1="3" y1="16" x2="19" y2="16"/>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-[#1D2433]/8 bg-[#F8F5EF]">
    <nav class="px-[clamp(1rem,4vw,3rem)] py-4 flex flex-col gap-1" aria-label="Mobile navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`py-2 px-3 rounded-lg text-sm font-semibold transition-colors no-underline ${
            currentPath === link.href
              ? 'text-[#1D2433] bg-[#FBF4E8]'
              : 'text-[#1D2433] hover:bg-[#1D2433]/5'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
