---
import type { LocationSnapshot } from '../data/locationSnapshots';

interface Props {
  snapshot?: LocationSnapshot;
  hotel: {
    title: string;
    city: string;
    country: string;
  };
}

const { snapshot, hotel } = Astro.props;

const locationVerdict = snapshot?.locationVerdict?.trim() ?? '';
const address = snapshot?.address?.trim();
const mapPreview = snapshot?.mapPreview;
const safeMapsUrl = (snapshot?.googleMapsUrl || '').trim()
  || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${hotel.title} ${hotel.city} ${hotel.country}`)}`;
const hasCard = Boolean(locationVerdict && safeMapsUrl);
const chips = (snapshot?.bestFor ?? []).filter(Boolean).slice(0, 4);
const nearbyAnchors = (snapshot?.nearbyAnchors ?? []).filter(anchor => anchor.name?.trim()).slice(0, 3);
const fallbackLabels = (snapshot?.fallbackMap?.nearby ?? nearbyAnchors.map(anchor => anchor.name)).filter(Boolean).slice(0, 3);
const fallbackTitle = snapshot?.fallbackMap?.label || snapshot?.area || 'Hotel base';
const ariaLabel = mapPreview?.alt
  || `Illustrative location snapshot for ${hotel.title}. Open Google Maps for the exact location.`;
---

{hasCard && (
  <section id="where-this-hotel-is" class="location-snapshot-card" aria-labelledby="where-this-hotel-is-title">
    <div class="location-copy">
      <p class="location-eyebrow">Location</p>
      <h2 id="where-this-hotel-is-title">Where this hotel is</h2>

      <p class="location-verdict">
        {locationVerdict}
      </p>

      {chips.length > 0 && (
        <div class="location-chips" aria-label="Best location uses">
          {chips.map(chip => <span>{chip}</span>)}
        </div>
      )}

      {nearbyAnchors.length > 0 && (
        <div class="nearby-anchors">
          <h3>Nearby</h3>
          <ul>
            {nearbyAnchors.map(anchor => (
              <li>
                <span>{anchor.name}</span>
                {(anchor.type || anchor.distance) && (
                  <small>
                    {[anchor.type, anchor.distance].filter(Boolean).join(' - ')}
                  </small>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}

      {address && <p class="location-address">{address}</p>}

      <a href={safeMapsUrl} target="_blank" rel="noopener noreferrer" class="maps-button">
        Open hotel location on Google Maps
      </a>
    </div>

    <div class="mini-map-preview">
      {mapPreview?.image ? (
        <img src={mapPreview.image} alt={mapPreview.alt || ariaLabel} loading="lazy" decoding="async" />
      ) : (
        <div class="fallback-map" role="img" aria-label={ariaLabel}>
          <svg class="map-lines" aria-hidden="true" viewBox="0 0 420 320" preserveAspectRatio="none">
            <path d="M-20 245 C80 210 126 180 206 188 C294 196 338 154 440 122" />
            <path d="M82 -20 C104 68 114 126 156 178 C194 226 230 262 254 340" />
            <path d="M-20 96 C74 126 130 116 206 88 C288 58 344 66 440 36" />
            <path d="M286 -20 C272 66 286 130 338 192 C374 236 398 272 428 310" />
          </svg>

          <div class="hotel-pin" aria-hidden="true">
            <span></span>
          </div>

          <div class="map-label hotel-label">{fallbackTitle}</div>

          {fallbackLabels.map((label, index) => (
            <div class={`map-anchor map-anchor-${index + 1}`}>
              <span aria-hidden="true"></span>
              <b>{label}</b>
            </div>
          ))}

          <p class="map-note">Illustrative snapshot. Use Google Maps for the exact location.</p>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .location-snapshot-card {
    background: #ffffff;
    border: 1px solid #e2d4bf;
    border-radius: 8px;
    box-shadow: 0 12px 34px rgba(31, 36, 40, 0.055);
    color: #1d2433;
    display: grid;
    gap: 1.1rem;
    grid-template-columns: minmax(0, 1.08fr) minmax(18rem, 0.92fr);
    margin: 0 0 2rem;
    overflow: hidden;
    padding: 1rem;
  }

  .location-copy {
    align-content: start;
    display: grid;
    gap: 0.9rem;
    min-width: 0;
    padding: 0.35rem 0.2rem 0.35rem 0.35rem;
  }

  .location-eyebrow {
    color: #b88a44;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
    margin: 0;
    text-transform: uppercase;
  }

  .location-copy h2 {
    color: #1d2433;
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 2.2vw, 1.9rem);
    font-weight: 750;
    letter-spacing: 0;
    line-height: 1.15;
    margin: 0;
  }

  .location-verdict {
    color: #1d2433;
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.55;
    margin: 0;
    max-width: 48rem;
  }

  .location-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .location-chips span {
    background: #f8f5ef;
    border: 1px solid #eadfce;
    border-radius: 999px;
    color: #58745a;
    font-size: 0.76rem;
    font-weight: 800;
    line-height: 1.2;
    padding: 0.36rem 0.62rem;
  }

  .nearby-anchors {
    background: #fffdf8;
    border: 1px solid #eee4d5;
    border-radius: 8px;
    padding: 0.85rem;
  }

  .nearby-anchors h3 {
    color: #1d2433;
    font-family: var(--font-serif);
    font-size: 0.98rem;
    font-weight: 750;
    line-height: 1.2;
    margin: 0 0 0.55rem;
  }

  .nearby-anchors ul {
    display: grid;
    gap: 0.52rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nearby-anchors li {
    border-left: 3px solid #b88a44;
    display: grid;
    gap: 0.12rem;
    min-width: 0;
    padding-left: 0.55rem;
  }

  .nearby-anchors span {
    color: #1d2433;
    font-size: 0.9rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .nearby-anchors small {
    color: #6b7280;
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .location-address {
    color: #6b7280;
    font-size: 0.84rem;
    font-weight: 650;
    line-height: 1.45;
    margin: -0.1rem 0 0;
  }

  .maps-button {
    align-items: center;
    background: #1d2433;
    border-radius: 8px;
    color: #ffffff;
    display: inline-flex;
    font-size: 0.9rem;
    font-weight: 800;
    justify-content: center;
    line-height: 1.2;
    min-height: 2.9rem;
    padding: 0.82rem 1rem;
    text-align: center;
    text-decoration: none;
    transition: background 160ms ease, transform 160ms ease;
    width: fit-content;
  }

  .maps-button:hover,
  .maps-button:focus-visible {
    background: #b88a44;
    color: #ffffff;
    text-decoration: none;
  }

  .maps-button:focus-visible {
    outline: 3px solid rgba(184, 138, 68, 0.35);
    outline-offset: 3px;
  }

  .maps-button:hover {
    transform: translateY(-1px);
  }

  .mini-map-preview {
    min-height: 100%;
    min-width: 0;
  }

  .mini-map-preview img,
  .fallback-map {
    border-radius: 8px;
    min-height: 23rem;
    overflow: hidden;
    width: 100%;
  }

  .mini-map-preview img {
    display: block;
    height: 100%;
    object-fit: cover;
  }

  .fallback-map {
    background:
      radial-gradient(circle at 22% 18%, rgba(88, 116, 90, 0.16), transparent 26%),
      radial-gradient(circle at 84% 82%, rgba(184, 138, 68, 0.16), transparent 30%),
      linear-gradient(135deg, #f8f5ef 0%, #efe3d1 100%);
    border: 1px solid #e3d6c5;
    min-height: 100%;
    position: relative;
  }

  .map-lines {
    inset: 0;
    height: 100%;
    position: absolute;
    width: 100%;
  }

  .map-lines path {
    fill: none;
    stroke: rgba(107, 114, 128, 0.34);
    stroke-linecap: round;
    stroke-width: 14;
  }

  .map-lines path:nth-child(2),
  .map-lines path:nth-child(4) {
    stroke: rgba(184, 138, 68, 0.22);
    stroke-width: 8;
  }

  .hotel-pin {
    align-items: center;
    background: #1d2433;
    border: 3px solid #ffffff;
    border-radius: 50% 50% 50% 0;
    box-shadow: 0 10px 22px rgba(29, 36, 51, 0.24);
    display: flex;
    height: 2.7rem;
    justify-content: center;
    left: 48%;
    position: absolute;
    top: 44%;
    transform: rotate(-45deg);
    width: 2.7rem;
  }

  .hotel-pin span {
    background: #b88a44;
    border-radius: 50%;
    display: block;
    height: 0.9rem;
    width: 0.9rem;
  }

  .map-label,
  .map-anchor {
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(226, 212, 191, 0.95);
    border-radius: 999px;
    box-shadow: 0 8px 18px rgba(31, 36, 40, 0.07);
    color: #1d2433;
    font-size: 0.75rem;
    font-weight: 850;
    line-height: 1.15;
    max-width: 11rem;
    padding: 0.42rem 0.6rem;
    position: absolute;
  }

  .hotel-label {
    left: 41%;
    top: 61%;
  }

  .map-anchor {
    align-items: center;
    display: flex;
    gap: 0.35rem;
  }

  .map-anchor span {
    background: #58745a;
    border: 2px solid #ffffff;
    border-radius: 999px;
    box-shadow: 0 0 0 1px rgba(88, 116, 90, 0.28);
    display: block;
    height: 0.72rem;
    width: 0.72rem;
  }

  .map-anchor b {
    font: inherit;
    overflow-wrap: anywhere;
  }

  .map-anchor-1 {
    left: 9%;
    top: 17%;
  }

  .map-anchor-2 {
    right: 9%;
    top: 24%;
  }

  .map-anchor-3 {
    bottom: 19%;
    left: 12%;
  }

  .map-note {
    bottom: 0.75rem;
    color: #6b7280;
    font-size: 0.68rem;
    font-weight: 700;
    left: 0.85rem;
    line-height: 1.3;
    margin: 0;
    max-width: calc(100% - 1.7rem);
    position: absolute;
  }

  @media (max-width: 900px) {
    .location-snapshot-card {
      grid-template-columns: 1fr;
    }

    .mini-map-preview img,
    .fallback-map {
      min-height: 18rem;
    }
  }

  @media (max-width: 560px) {
    .location-snapshot-card {
      padding: 0.85rem;
    }

    .location-copy {
      padding: 0.1rem;
    }

    .maps-button {
      width: 100%;
    }

    .mini-map-preview img,
    .fallback-map {
      min-height: 16rem;
    }

    .map-label,
    .map-anchor {
      font-size: 0.68rem;
      max-width: 8.7rem;
      padding: 0.35rem 0.48rem;
    }

    .hotel-label {
      left: 38%;
      top: 61%;
    }

    .map-anchor-1 {
      left: 5%;
      top: 14%;
    }

    .map-anchor-2 {
      right: 5%;
      top: 25%;
    }

    .map-anchor-3 {
      bottom: 22%;
      left: 7%;
    }
  }
</style>
