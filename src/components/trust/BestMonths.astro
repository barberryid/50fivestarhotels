---
interface Props {
  bestWeather: string[];
  cheapest: string[];
  weatherSummary?: string;
  priceSummary?: string;
}

const { bestWeather = [], cheapest = [], weatherSummary, priceSummary } = Astro.props;
const hasAny = bestWeather.length > 0 || cheapest.length > 0;
---

{hasAny && (
  <div class="rounded-2xl border border-[#E6DBBE] bg-[#FFFDF6] p-6 shadow-sm">
    <div class="flex items-center gap-2.5 mb-4">
      <svg class="w-5 h-5 text-[#A0682E] shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M6 1a1 1 0 0 1 1 1v1h6V2a1 1 0 1 1 2 0v1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h1V2a1 1 0 0 1 1-1zM4 7v9h12V7H4z"/>
      </svg>
      <h3 class="font-serif text-lg font-semibold text-[#2A2622]">Best months to book</h3>
    </div>

    {bestWeather.length > 0 && (
      <div class="mb-4">
        <p class="text-xs font-semibold uppercase tracking-wider text-[#5C544A] mb-2">Best weather</p>
        <div class="flex flex-wrap gap-1.5">
          {bestWeather.map(m => (
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-[#5C7355]/12 text-[#5C7355]">{m}</span>
          ))}
        </div>
        {weatherSummary && <p class="text-xs text-[#5C544A] mt-2 leading-relaxed">{weatherSummary}</p>}
      </div>
    )}

    {cheapest.length > 0 && (
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-[#5C544A] mb-2">Cheapest value</p>
        <div class="flex flex-wrap gap-1.5">
          {cheapest.map(m => (
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-[#A0682E]/14 text-[#8E5A33]">{m}</span>
          ))}
        </div>
        {priceSummary && <p class="text-xs text-[#5C544A] mt-2 leading-relaxed">{priceSummary}</p>}
      </div>
    )}
  </div>
)}
