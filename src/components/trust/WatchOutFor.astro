---
interface Props {
  cautions: string[];
  title?: string;
}

const { cautions, title = 'Watch out for' } = Astro.props;
const items = (cautions ?? []).filter(Boolean);
---

{items.length > 0 && (
  <div class="rounded-2xl border border-[#E5B58F]/60 bg-[#F4EADC] p-6 shadow-sm">
    <div class="flex items-center gap-2.5 mb-3">
      <svg class="w-5 h-5 text-[#A86645] shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm-1-8a1 1 0 0 0-1 1v3a1 1 0 0 0 2 0V6a1 1 0 0 0-1-1z" clip-rule="evenodd"/>
      </svg>
      <h3 class="font-serif text-lg font-semibold text-[#1F2428]">{title}</h3>
    </div>
    <ul class="space-y-2">
      {items.map(c => (
        <li class="flex items-start gap-2.5 text-sm text-[#1F2428]/80 leading-relaxed">
          <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#A86645] shrink-0"></span>
          {c}
        </li>
      ))}
    </ul>
  </div>
)}
