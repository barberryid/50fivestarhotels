---
interface Props {
  reasons: string[];
  priceRange?: string;
}

const { reasons, priceRange } = Astro.props;
const items = (reasons ?? []).filter(Boolean);
---

{items.length > 0 && (
  <div class="rounded-2xl border border-[#4F6547]/25 bg-[#4F6547]/[0.07] p-6 shadow-sm">
    <div class="flex items-center gap-2.5 mb-3">
      <svg class="w-5 h-5 text-[#4F6547] shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M10 1.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17zm.9 4.2v.7c1.2.2 2.1 1 2.1 2.2h-1.5c0-.5-.5-.9-1.1-.9-.7 0-1.1.3-1.1.8 0 .4.3.6 1.3.9 1.6.4 2.5 1 2.5 2.3 0 1.1-.8 1.9-2.1 2.1v.8H9.1v-.8c-1.3-.2-2.2-1-2.2-2.3h1.5c0 .6.5 1 1.3 1 .8 0 1.2-.3 1.2-.8 0-.4-.4-.7-1.4-.9-1.5-.4-2.4-1-2.4-2.3 0-1.1.8-1.8 2-2v-.7h1.2z"/>
      </svg>
      <h3 class="font-serif text-lg font-semibold text-[#1F2428]">Why it is cheap</h3>
    </div>
    {priceRange && <p class="text-sm font-semibold text-[#4F6547] mb-2.5">{priceRange}</p>}
    <ul class="space-y-2">
      {items.map(r => (
        <li class="flex items-start gap-2.5 text-sm text-[#1F2428]/80 leading-relaxed">
          <svg class="w-4 h-4 text-[#4F6547] shrink-0 mt-0.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm3.47 5.53a.75.75 0 0 1 0 1.06l-4 4a.75.75 0 0 1-1.06 0l-2-2a.75.75 0 1 1 1.06-1.06L7 9.94l3.47-3.47a.75.75 0 0 1 1.06.06z"/>
          </svg>
          {r}
        </li>
      ))}
    </ul>
  </div>
)}
