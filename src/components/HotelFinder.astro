---
// The full Hotel Finder workflow, used on the homepage and /hotel-finder/.
// Bundles the three pieces that talk to each other through shared DOM/events:
//   1. price-level selector (read by CountryPromptTool + PersonalisePreferences)
//   2. PersonalisePreferences (traveller-fit weighting)
//   3. CountryPromptTool (destination, output mode, copy)
// Keeping them in one component avoids duplicating the wiring across pages.
import AccordionCard from './AccordionCard.astro';
import CountryPromptTool from './CountryPromptTool.astro';
import PersonalisePreferences from './PersonalisePreferences.astro';
import { researchPriceLevels } from '../data/researchPriceLevels';

const bookingChecks = [
  'Final price after taxes and fees',
  'Exact room type',
  'Whether breakfast is included or expensive',
  'Cancellation policy',
  'Recent reviews from the last 3–6 months',
  'Lowest-rated recent reviews',
  'Location on the map',
  'Airport or station transfer time',
  'Whether the five-star label is official, local or platform-based',
  'Whether the low price is seasonal, mobile-only, member-only or non-refundable',
];
---

<div id="hotel-finder" class="scroll-mt-20" data-hotel-finder>
  <!-- Price levels -->
  <section class="max-w-4xl mx-auto px-5 py-6" data-price-level-selector>
    <AccordionCard title="Price levels included" number={1}>
      <p class="text-[#1F2428]/80 leading-relaxed mb-7" data-price-level-summary>
        The generated prompt searches the selected nightly levels in order. All four are included by default. If no credible option appears at €50 or below, it displays “No credible hotel option found under €50” and marks the next best three hotels above that level as “Fallback above €50”.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {researchPriceLevels.map(({ amount, title, text }) => (
          <label
            class="rounded-lg border border-[#E2D4BF] bg-[#FFFDF8] p-5 cursor-pointer transition-colors data-[selected=true]:border-[#B88A44] data-[selected=true]:bg-[#F4EADC] hover:border-[#B88A44]"
            data-price-level-card
            data-selected="true"
          >
            <span class="flex h-full gap-4">
              <input
                type="checkbox"
                value={amount}
                checked
                data-price-level-input
                class="mt-1 h-5 w-5 shrink-0 rounded border-[#B88A44] text-[#B88A44] accent-[#B88A44]"
                aria-describedby={`price-level-${amount}-description`}
              />
              <span class="min-w-0">
                <span class="block text-3xl font-serif font-semibold text-[#1F2428] mb-2">€{amount}</span>
                <span class="block text-sm font-bold uppercase tracking-widest text-[#B88A44] mb-3">{title}</span>
                <span id={`price-level-${amount}-description`} class="block text-sm leading-relaxed text-[#6F685F]">{text}</span>
                <span class="mt-4 inline-flex rounded-full bg-white px-3 py-1 text-xs font-semibold text-[#4F6547]" data-price-level-state>
                  Included
                </span>
              </span>
            </span>
          </label>
        ))}
      </div>
      <p class="mt-4 text-sm text-[#6F685F]" role="status" aria-live="polite" data-price-level-status>
        Select at least one price level. The prompt below updates automatically.
      </p>
    </AccordionCard>
  </section>

  <!-- Traveller-fit weighting -->
  <PersonalisePreferences />

  <!-- The tool -->
  <section class="max-w-4xl mx-auto px-5 pt-0 pb-10">
    <CountryPromptTool />
  </section>

  <!-- Before booking checklist -->
  <section class="max-w-4xl mx-auto px-5 py-10">
    <div class="rounded-xl border border-[#E2D4BF] bg-[#FFFDF8] p-6 md:p-7">
      <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">Final booking check</p>
      <h2 class="font-serif text-2xl md:text-3xl font-semibold text-[#1F2428] mb-4">Before booking, check</h2>
      <p class="text-[#1F2428]/80 leading-relaxed mb-6">
        The finder is designed to produce a strong shortlist, not a final booking decision. Before booking any hotel, verify the live details yourself.
      </p>
      <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-3">
        {bookingChecks.map((item) => (
          <li class="flex items-start gap-3 text-sm leading-relaxed text-[#1F2428]/80">
            <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#4F6547]" aria-hidden="true"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <p class="mt-6 rounded-lg bg-[#E8F1E6] px-4 py-3 text-sm leading-relaxed text-[#1F2428]">
        A hotel can be a strong value option and still be wrong for your trip. Treat the shortlist as a decision aid, then check the live booking page carefully.
      </p>
    </div>
  </section>
</div>

<script>
  // Fire finder_viewed once when the finder scrolls into view.
  const finder = document.querySelector<HTMLElement>('[data-hotel-finder]');
  const track = (window as unknown as { ffshTrack?: (name: string, props?: Record<string, unknown>) => void }).ffshTrack;
  if (finder && typeof IntersectionObserver === 'function') {
    let fired = false;
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting && !fired) {
          fired = true;
          if (typeof track === 'function') track('finder_viewed');
          observer.disconnect();
        }
      }
    }, { threshold: 0.2 });
    observer.observe(finder);
  } else if (finder && typeof track === 'function') {
    track('finder_viewed');
  }
</script>
