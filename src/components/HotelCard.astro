---
import Badge from './Badge.astro';
import { getBookingAffiliateUrl } from '../utils/affiliateLinks';

interface Props {
  hotel: {
    slug: string;
    title: string;
    city: string;
    country: string;
    budgetTier: string;
    valueScore: number;
    verdict: string;
    highlights: string[];
    cautions: string[];
    bestFor?: string[];
    notIdealFor?: string[];
    fiveStarStatus: string;
    typicalPriceRange: string;
    bookingUrl?: string;
    image?: {
      src: string;
      alt: string;
      srcSet?: {
        large: string;
        small: string;
      };
    };
    generatedGallery?: Array<{
      src: string;
      alt: string;
      type?: string;
      srcSet?: {
        large: string;
        small: string;
      };
    }>;
  };
  featured?: boolean;
}

const { hotel, featured = false } = Astro.props;
const scoreColor = hotel.valueScore >= 85 ? '#4F6547' : hotel.valueScore >= 75 ? '#B88A44' : '#6F685F';
const bookingAffiliateUrl = getBookingAffiliateUrl(hotel.bookingUrl);
// Prefer the brighter realistic-daylight render for cards; fall back to the
// default (editorial-dusk) image, then the placeholder.
const cardImage = hotel.generatedGallery?.find((g) => g.type === 'realistic-daylight') ?? hotel.image;
const bestFor = hotel.bestFor?.slice(0, 2) ?? [];
const notIdealFor = hotel.notIdealFor?.slice(0, 2) ?? hotel.cautions?.slice(0, 1) ?? [];
---

<article class={`group bg-[#FFFDF8] rounded-[1.25rem] overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-[#E2D4BF] flex flex-col ${featured ? 'ring-1 ring-[#B88A44]/25' : ''}`}>
  <a href={`/hotels/${hotel.slug}`} class="block no-underline relative">
    <div class="aspect-[4/3] overflow-hidden bg-[#F8F2E8]">
      <picture>
        {cardImage?.srcSet?.large && <source media="(min-width: 900px)" srcset={cardImage.srcSet.large} type="image/webp" />}
        {cardImage?.srcSet?.small && <source media="(max-width: 899px)" srcset={cardImage.srcSet.small} type="image/webp" />}
        <img
          src={cardImage?.srcSet?.small ?? cardImage?.src ?? '/images/placeholders/luxury-hotel-placeholder.svg'}
          alt={cardImage?.alt ?? `${hotel.title} in ${hotel.city}, ${hotel.country}`}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
        />
      </picture>
    </div>

    <!-- Tier badge -->
    <div class="absolute top-3 left-3">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-[#FFFDF8]/95 text-[#1F2428] backdrop-blur shadow-sm">
        {hotel.budgetTier}
      </span>
    </div>

    <!-- Score pill -->
    <div class="absolute top-3 right-3">
      <span class="flex items-center justify-center w-11 h-11 rounded-full text-white font-serif font-bold text-base shadow-md" style={`background:${scoreColor}`}>
        {hotel.valueScore}
      </span>
    </div>

  </a>

  <div class="p-5 flex flex-col flex-1 gap-3">
    <div>
      <p class="text-[0.7rem] uppercase tracking-widest text-[#B88A44] font-semibold mb-1.5">{hotel.city}, {hotel.country}</p>
      <a href={`/hotels/${hotel.slug}`} class="no-underline">
        <h3 class="font-serif text-xl font-semibold text-[#1F2428] group-hover:text-[#B88A44] transition-colors leading-snug">
          {hotel.title}
        </h3>
      </a>
    </div>

    <div class="flex items-center gap-2 flex-wrap">
      <Badge label={hotel.fiveStarStatus} variant="type" />
      <span class="text-xs font-semibold uppercase tracking-wider" style={`color:${scoreColor}`}>{hotel.verdict}</span>
    </div>

    {hotel.highlights[0] && (
      <p class="text-[#1F2428]/75 text-sm leading-relaxed">{hotel.highlights[0]}</p>
    )}

    {(bestFor.length > 0 || notIdealFor.length > 0) && (
      <div class="space-y-2 text-xs">
        {bestFor.length > 0 && (
          <div>
            <span class="font-semibold text-[#4F6547]">Best for: </span>
            <span class="text-[#6F685F]">{bestFor.join(', ')}</span>
          </div>
        )}
        {notIdealFor.length > 0 && (
          <div>
            <span class="font-semibold text-[#8A5A2B]">Not ideal for: </span>
            <span class="text-[#6F685F]">{notIdealFor.join(', ')}</span>
          </div>
        )}
      </div>
    )}

    <p class="text-[#6F685F] text-sm mt-auto pt-1">{hotel.typicalPriceRange}</p>

    <div class="flex flex-col gap-2 pt-1">
      {bookingAffiliateUrl && (
        <a
          href={bookingAffiliateUrl}
          target="_blank"
          rel="sponsored nofollow noopener"
          class="block text-center bg-[#1F2428] text-white text-sm font-semibold py-3 px-4 rounded-full hover:bg-[#B88A44] transition-colors no-underline"
        >
          Check current prices on Booking.com
        </a>
      )}
      <a
        href={`/hotels/${hotel.slug}`}
        class="block text-center text-[#6F685F] text-sm font-medium hover:text-[#B88A44] transition-colors no-underline"
      >
        Read full profile →
      </a>
    </div>
  </div>
</article>
