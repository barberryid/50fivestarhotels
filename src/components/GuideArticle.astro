---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedGuides from './RelatedGuides.astro';
import FinderCta from './FinderCta.astro';
import LastUpdated from './LastUpdated.astro';
import { breadcrumbJsonLd, canonicalUrl } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  intro: string;
  sections: { heading: string; body: string[] }[];
  related?: { title: string; href: string; description?: string }[];
}

const { title, description, path, h1, intro, sections, related = [] } = Astro.props;
const jsonLd = breadcrumbJsonLd([{ name: 'Home', url: canonicalUrl('/') }, { name: h1, url: canonicalUrl(path) }]);
---

<BaseLayout title={title} description={description} canonical={path} type="article" jsonLd={jsonLd}>
  <main class="max-w-4xl mx-auto px-5 py-16">
    <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-4">Travel-value guide</p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-[#1F2428] leading-tight mb-6">{h1}</h1>
    <p class="text-[#6F685F] text-lg leading-relaxed mb-5">{intro}</p>
    <LastUpdated date="2026-05-31" />
    <div class="prose prose-lg max-w-none mt-10 prose-headings:font-serif prose-headings:text-[#1F2428] prose-p:text-[#1F2428]/75 prose-p:leading-relaxed prose-a:text-[#B88A44] prose-a:no-underline hover:prose-a:underline">
      {sections.map((section) => (
        <>
          <h2>{section.heading}</h2>
          {section.body.map((paragraph) => <p>{paragraph}</p>)}
        </>
      ))}
    </div>
    <div class="mt-12">
      <FinderCta
        title="Put this into practice"
        text="Use the Hotel Finder to turn these checks into a research brief for your own trip."
      />
    </div>
    <RelatedGuides items={related} />
  </main>
</BaseLayout>
