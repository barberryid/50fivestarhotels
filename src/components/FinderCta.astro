---
// Reusable Hotel Finder call-to-action block for hotel, guide, budget-tier
// and destination pages. Uses the warm/gold/green design system.
interface Props {
  title?: string;
  text?: string;
  href?: string;
  compact?: boolean;
}

const {
  title = 'Find hotels like this for your own trip',
  text = 'Use the Hotel Finder to search by destination, budget and travel priorities. It creates a research brief you can paste into ChatGPT or Claude.',
  href = '/hotel-finder/',
  compact = false,
} = Astro.props;
---

<aside
  class={`rounded-2xl border border-[#E6DBBE] bg-[#FFFDF6] ${compact ? 'p-5' : 'p-6 md:p-7'}`}
  aria-label="Hotel Finder"
>
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div class="max-w-2xl">
      <p class="text-[#A0682E] text-xs font-bold uppercase tracking-widest mb-2">Hotel Finder</p>
      <h2 class={`font-serif font-semibold text-[#2A2622] ${compact ? 'text-xl' : 'text-2xl md:text-3xl'} mb-2`}>
        {title}
      </h2>
      <p class="text-[#2A2622]/75 text-sm leading-relaxed">{text}</p>
    </div>
    <a
      href={href}
      class="inline-flex shrink-0 items-center justify-center rounded-full bg-[#5C7355] px-6 py-3 text-sm font-semibold text-white shadow-[0_10px_24px_rgba(92, 115, 85,0.22)] transition-colors hover:bg-[#344532] no-underline"
    >
      Build my hotel shortlist →
    </a>
  </div>
</aside>
