---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-[#5C544A]">
  {crumbs.map((crumb, i) => (
    <span class="flex items-center gap-2">
      {i > 0 && <span aria-hidden="true" class="text-[#2A2622]/25">/</span>}
      {crumb.href
        ? <a href={crumb.href} class="hover:text-[#2A2622] transition-colors no-underline">{crumb.label}</a>
        : <span class="text-[#2A2622] font-medium">{crumb.label}</span>
      }
    </span>
  ))}
</nav>
