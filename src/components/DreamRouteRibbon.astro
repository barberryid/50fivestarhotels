---
interface Props {
  variant?: 'hero' | 'divider' | 'page';
  class?: string;
}

const { variant = 'hero', class: className = '' } = Astro.props;
---

{variant === 'hero' ? (
  <svg
    class:list={['dream-route dream-route-hero', className]}
    viewBox="0 0 560 140"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <path class="dream-route-soft" d="M24 92 C 126 32, 218 124, 320 72 S 456 38, 536 76" />
    <path class="dream-route-main" d="M28 88 C 128 38, 218 116, 320 68 S 456 42, 532 74" />
    <circle class="dream-route-node dream-route-node-gold" cx="28" cy="88" r="8" />
    <circle class="dream-route-node dream-route-node-green" cx="532" cy="74" r="8" />
  </svg>
) : variant === 'page' ? (
  <svg
    class:list={['dream-route dream-route-page', className]}
    viewBox="0 0 720 210"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <path class="dream-route-soft" d="M38 145 C 178 48, 254 184, 382 106 S 560 42, 678 106" />
    <path class="dream-route-main" d="M44 140 C 176 54, 258 172, 384 100 S 562 50, 672 108" />
    <circle class="dream-route-node dream-route-node-gold" cx="44" cy="140" r="10" />
    <circle class="dream-route-node dream-route-node-green" cx="384" cy="100" r="11" />
    <circle class="dream-route-node dream-route-node-sky" cx="672" cy="108" r="10" />
    <path class="dream-route-star" d="M214 46 l6 13 14 2 -10 9 2 14 -12 -7 -12 7 2 -14 -10 -9 14 -2 6 -13Z" />
  </svg>
) : (
  <div class:list={['dream-route-divider', className]} aria-hidden="true">
    <span></span>
    <svg viewBox="0 0 240 40" fill="none" focusable="false">
      <path d="M4 24 C 54 4, 88 42, 134 20 S 198 8, 236 22" />
      <circle cx="4" cy="24" r="4" />
      <circle cx="134" cy="20" r="5" />
      <circle cx="236" cy="22" r="4" />
    </svg>
    <span></span>
  </div>
)}
