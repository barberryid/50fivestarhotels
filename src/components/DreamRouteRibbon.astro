---
interface Props {
  variant?: 'hero' | 'divider' | 'page';
  class?: string;
}

const { variant = 'hero', class: className = '' } = Astro.props;
---

{variant === 'hero' ? (
  <svg
    class:list={['dream-route dream-route-hero', className]}
    viewBox="0 0 900 520"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <path class="dream-route-soft" d="M58 390 C 220 230, 270 470, 418 306 S 650 118, 814 228" />
    <path class="dream-route-main" d="M66 380 C 218 224, 286 448, 426 294 S 650 126, 808 224" />
    <path class="dream-route-sky" d="M162 318 C 254 248, 318 330, 390 270" />
    <circle class="dream-route-node dream-route-node-gold" cx="72" cy="380" r="12" />
    <circle class="dream-route-node dream-route-node-green" cx="426" cy="294" r="13" />
    <circle class="dream-route-node dream-route-node-sky" cx="808" cy="224" r="12" />
    <path class="dream-route-star" d="M266 180 l8 19 20 3 -15 13 4 20 -17 -10 -18 10 4 -20 -15 -13 20 -3 9 -19Z" />
    <path class="dream-route-card" d="M548 74 h118 a18 18 0 0 1 18 18 v82 a18 18 0 0 1 -18 18 h-118 a18 18 0 0 1 -18 -18 v-82 a18 18 0 0 1 18 -18Z" />
    <path class="dream-route-card-line" d="M558 108 h64 M558 132 h92 M558 156 h72" />
    <path class="dream-route-calendar" d="M632 88 v18 M660 88 v18 M620 116 h52" />
  </svg>
) : variant === 'page' ? (
  <svg
    class:list={['dream-route dream-route-page', className]}
    viewBox="0 0 720 210"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <path class="dream-route-soft" d="M38 145 C 178 48, 254 184, 382 106 S 560 42, 678 106" />
    <path class="dream-route-main" d="M44 140 C 176 54, 258 172, 384 100 S 562 50, 672 108" />
    <circle class="dream-route-node dream-route-node-gold" cx="44" cy="140" r="10" />
    <circle class="dream-route-node dream-route-node-green" cx="384" cy="100" r="11" />
    <circle class="dream-route-node dream-route-node-sky" cx="672" cy="108" r="10" />
    <path class="dream-route-star" d="M214 46 l6 13 14 2 -10 9 2 14 -12 -7 -12 7 2 -14 -10 -9 14 -2 6 -13Z" />
  </svg>
) : (
  <div class:list={['dream-route-divider', className]} aria-hidden="true">
    <span></span>
    <svg viewBox="0 0 240 40" fill="none" focusable="false">
      <path d="M4 24 C 54 4, 88 42, 134 20 S 198 8, 236 22" />
      <circle cx="4" cy="24" r="4" />
      <circle cx="134" cy="20" r="5" />
      <circle cx="236" cy="22" r="4" />
    </svg>
    <span></span>
  </div>
)}
