---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, subtitle, align = 'left' } = Astro.props;
const textAlign = align === 'center' ? 'text-center' : 'text-left';
---

<div class={`${textAlign} mb-10`}>
  {eyebrow && (
    <p class="text-[#B88A44] text-xs font-bold uppercase tracking-widest mb-3">{eyebrow}</p>
  )}
  <h2 class="font-serif text-3xl md:text-4xl font-bold text-[#1D2433] leading-tight">{title}</h2>
  {subtitle && (
    <p class="text-[#6B7280] text-lg mt-4 leading-relaxed max-w-2xl">{align === 'center' ? '' : ''}{subtitle}</p>
  )}
</div>
