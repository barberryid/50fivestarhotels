---
// Collapsible accordion card used on /research-hotels/ (Hotel Finder).
// Native <details>/<summary> for click-to-expand usability matching the
// 50difficultplaces packing guide, styled with the site palette and a
// bright green chevron button. Content stays in the DOM when collapsed,
// so the page's shared client scripts can still read the controls inside.
interface Props {
  title: string;
  number?: number;
  open?: boolean;
  class?: string;
}
const { title, number, open = false, class: className = '' } = Astro.props;
---

<details class:list={['ff-accordion group rounded-lg border border-[#E6DBBE] bg-white shadow-[4px_4px_0_rgba(42, 38, 34,0.08)]', className]} open={open}>
  <summary class="ff-summary flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-5 md:px-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5C7355]/50">
    <span class="flex min-w-0 items-center gap-3">
      {number != null && (
        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#5C7355] text-sm font-bold text-white shadow-[0_3px_0_#344532]" aria-hidden="true">{number}</span>
      )}
      <span class="font-serif text-xl md:text-2xl font-semibold text-[#2A2622]">{title}</span>
    </span>
    <span class="flex shrink-0 items-center gap-3">
      <slot name="actions" />
      <span class="ff-chevron inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#5C7355] text-white shadow-[0_3px_0_#344532] transition-transform duration-200" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </span>
    </span>
  </summary>
  <div class="border-t border-[#E6DBBE] px-5 py-6 md:px-6">
    <slot />
  </div>
</details>

<style>
  .ff-summary::-webkit-details-marker { display: none; }
  .ff-accordion[open] > .ff-summary .ff-chevron { transform: rotate(180deg); }
</style>
