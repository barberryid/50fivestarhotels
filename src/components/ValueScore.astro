---
interface Props {
  score: number;
  verdict: string;
  size?: 'sm' | 'md' | 'lg';
}

const { score, verdict, size = 'md' } = Astro.props;

const color = score >= 85 ? '#5C7355' : score >= 75 ? '#A0682E' : '#5C544A';
const sizeClasses = {
  sm: 'text-2xl',
  md: 'text-3xl',
  lg: 'text-5xl',
};
---

<div class="flex flex-col items-start gap-1">
  <div class={`font-serif font-bold leading-none ${sizeClasses[size]}`} style={`color: ${color}`}>
    {score}<span class="text-[0.45em] text-[#5C544A] font-sans font-normal"> / 100</span>
  </div>
  <div class="text-xs font-semibold uppercase tracking-widest" style={`color: ${color}`}>
    {verdict}
  </div>
</div>
