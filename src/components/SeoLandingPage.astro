---
import BaseLayout from '../layouts/BaseLayout.astro';
import HotelCard from './HotelCard.astro';
import HotelComparisonTable from './HotelComparisonTable.astro';
import RelatedGuides from './RelatedGuides.astro';
import LastUpdated from './LastUpdated.astro';
import PriceAccuracyNote from './PriceAccuracyNote.astro';
import AffiliateDisclosure from './AffiliateDisclosure.astro';
import { breadcrumbJsonLd, canonicalUrl, itemListJsonLd } from '../lib/seo';

interface Section {
  heading: string;
  body: string[];
}

interface RelatedItem {
  title: string;
  description?: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  kicker?: string;
  intro: string[];
  sections: Section[];
  hotels: any[];
  tableTitle?: string;
  itemListName?: string;
  related?: RelatedItem[];
  image?: string;
  childrenLabel?: string;
}

const {
  title,
  description,
  path,
  h1,
  kicker = 'Affordable luxury guide',
  intro,
  sections,
  hotels,
  tableTitle = 'Hotels at a glance',
  itemListName = h1,
  related = [],
  image,
  childrenLabel = 'Best current examples from the site',
} = Astro.props;

const tableHotels = hotels.map((h) => ({
  slug: h.data.slug,
  rank: h.data.rank,
  title: h.data.title,
  city: h.data.city,
  country: h.data.country,
  budgetTier: h.data.budgetTier,
  valueScore: h.data.valueScore,
  verdict: h.data.verdict,
  fiveStarStatus: h.data.fiveStarStatus,
  bestFor: h.data.bestFor,
  cautions: h.data.cautions,
}));
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: canonicalUrl('/') },
    { name: h1, url: canonicalUrl(path) },
  ]),
  itemListJsonLd(itemListName, hotels),
];
---

<BaseLayout title={title} description={description} canonical={path} image={image} jsonLd={jsonLd}>
  <main>
    <section class="bg-[#FBF6E9] border-b border-[#2A2622]/6">
      <div class="max-w-4xl mx-auto px-5 py-16">
        <p class="text-[#A0682E] text-xs font-bold uppercase tracking-widest mb-4">{kicker}</p>
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-[#2A2622] leading-tight mb-6">{h1}</h1>
        <div class="space-y-4">
          {intro.map((paragraph) => <p class="text-[#5C544A] text-lg leading-relaxed">{paragraph}</p>)}
        </div>
        <div class="mt-6 flex flex-col gap-3">
          <LastUpdated date="2026-05-31" />
          <PriceAccuracyNote />
        </div>
      </div>
    </section>

    <section class="max-w-4xl mx-auto px-5 py-14">
      <div class="prose prose-lg max-w-none prose-headings:font-serif prose-headings:text-[#2A2622] prose-p:text-[#2A2622]/75 prose-p:leading-relaxed prose-a:text-[#A0682E] prose-a:no-underline hover:prose-a:underline">
        {sections.map((section) => (
          <>
            <h2>{section.heading}</h2>
            {section.body.map((paragraph) => <p>{paragraph}</p>)}
          </>
        ))}
      </div>
    </section>

    {hotels.length > 0 && (
      <section class="max-w-6xl mx-auto px-5 pb-16">
        <h2 class="font-serif text-3xl font-semibold text-[#2A2622] mb-8">{childrenLabel}</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {hotels.map((h) => <HotelCard hotel={h.data} />)}
        </div>
      </section>
    )}

    {tableHotels.length > 0 && (
      <section class="max-w-6xl mx-auto px-5 pb-16">
        <HotelComparisonTable hotels={tableHotels} title={tableTitle} />
      </section>
    )}

    <section class="max-w-4xl mx-auto px-5 pb-16">
      <AffiliateDisclosure />
      <RelatedGuides items={related} />
    </section>
  </main>
</BaseLayout>
